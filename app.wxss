page {
  /* [技术债] Phase 5-6 遗留全局背景。
     后续待首页、复习页、历史列表页、历史详情页、添加页、编辑页
     全部显式接入 --bg-color-page token 后，方可移除此行。
     在此之前，各页面通过 .page / page {} 局部覆盖背景。 */
  background: #ffffff;
  --custom-tab-bar-height: 112rpx;
  --custom-tab-bar-space: calc(112rpx + env(safe-area-inset-bottom));

  /* ===== Mini Visual Token Dictionary (Phase 5-6B) ===== */
  --bg-color-page: #fbfcf7;
  --bg-color-card: #fbfdf8;
  --color-text-primary: #263128;
  --color-text-secondary: #657465;
  --color-text-muted: #99a398;
  --color-primary: #5eaa64;
  --border-color-muted: #e7eee4;
  --border-color-dashed: #dcebd8;
  --radius-card: 28rpx;
  --radius-pill: 999rpx;
  --shadow-card: 0 10rpx 26rpx rgba(86, 126, 82, 0.07);
  --space-card: 24rpx;
}

/* ===== Liquid glass visual language shared by real miniapp pages ===== */
page .liquid-theme-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  box-sizing: border-box;
  color: #153729;
  background-color: #e7f1ea;
  background-repeat: no-repeat;
  background-position: center top;
  background-size: cover;
  font-family: "PingFang SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

page .liquid-theme-page > .theme-ambient-image {
  position: fixed;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  opacity: 1;
  pointer-events: none;
}

page .liquid-theme-page .quick-home {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, .82);
  border-radius: 50%;
  background: rgba(238, 249, 242, .42);
}
page .liquid-theme-page .quick-home::after { border: 0; }
page .liquid-theme-page .quick-home-icon { width: 32rpx; height: 32rpx; }

page .liquid-theme-page::before,
page .liquid-theme-page::after {
  display: none;
}

page .liquid-theme-page > view,
page .liquid-theme-page > scroll-view,
page .liquid-theme-page > button,
page .liquid-theme-page > picker,
page .liquid-theme-page > block,
page .liquid-theme-page > text {
  position: relative;
  z-index: 1;
}

page .liquid-theme-page button,
page .liquid-theme-page [bindtap] {
  transition: opacity .3s ease, transform .3s ease, background-color .3s ease, border-color .3s ease, box-shadow .3s ease;
}

page .liquid-theme-page button:active,
page .liquid-theme-page [bindtap]:active {
  opacity: .86;
  transform: scale(.986);
}

page .liquid-theme-page .pressable {
  transition: transform .16s cubic-bezier(.2, .72, .2, 1), background-color .16s ease, border-color .16s ease, box-shadow .16s ease, opacity .16s ease;
}

page .liquid-theme-page .pressable:active {
  opacity: 1;
}

page .liquid-theme-page .pressable.press-on {
  transform: scale(.97);
}

page .liquid-theme-page .pressable.press-card.press-on {
  transform: scale(.985);
  background: rgba(255, 255, 255, .48);
  box-shadow: inset 0 4rpx 10rpx rgba(49, 84, 62, .08), 0 6rpx 16rpx rgba(49, 84, 62, .04);
}

page .liquid-theme-page .pressable.press-pill.press-on {
  transform: scale(.96);
  background: rgba(255, 255, 255, .5);
  box-shadow: inset 0 3rpx 8rpx rgba(49, 84, 62, .1);
}

