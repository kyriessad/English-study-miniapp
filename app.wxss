  animation: tab-enter-in .4s cubic-bezier(.2, .72, .2, 1) both;
}

@keyframes tab-enter-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  100% {
    opacity: 1;
    transform: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .tab-enter.is-in {
    animation: none;
    opacity: 1;
  }
}

page .liquid-theme-page .text-link {
  color: #47765d;
