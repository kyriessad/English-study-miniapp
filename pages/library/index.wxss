@import "../../styles/core.wxss";

page { overflow-x:hidden; }
.library-page { width:100%; max-width:100vw; padding-top:0; padding-right:24rpx; padding-left:24rpx; padding-bottom:190rpx; overflow-x:hidden; overflow-y:visible; box-sizing:border-box; }
.library-heading { display:flex; align-items:center; justify-content:space-between; min-height:72rpx; padding-top:70rpx; box-sizing:border-box; }
.library-heading-actions { display:flex; align-items:center; gap:12rpx; }
.library-heading .page-title { font-size:48rpx; }
.manage-button { min-width:108rpx; height:58rpx; line-height:58rpx; padding:0 20rpx; margin:6rpx 0 0; border:1rpx solid #9db49a; border-radius:999rpx; background:rgba(255,255,250,.55); color:#315737; font-size:24rpx; }
.manage-button::after { border:0; }
.library-view-tabs { height:78rpx; margin-top:26rpx; gap:0; border:1rpx solid #9db49a; border-radius:999rpx; overflow:hidden; background:#e4eee1; }
.library-view-tab { flex:1; display:flex; align-items:center; justify-content:center; padding:0; border:0; border-radius:0; background:transparent; color:#4d6752; font-size:29rpx; }
.library-view-tab-active { background:#789372; color:#fffdf8; }
.library-page .search-wrap { margin-top:22rpx; height:78rpx; }
.search-clear { display:flex; align-items:center; justify-content:center; flex:0 0 48rpx; width:48rpx; height:48rpx; padding:0; margin:0; border:0; border-radius:50%; background:#dce8d9; color:#536b58; font-size:31rpx; line-height:1; }
.search-clear::after { border:0; }
.library-filters { margin:20rpx 0 0; gap:12rpx; overflow:visible; }
.library-filters .filter-tab { padding:12rpx 26rpx; font-size:24rpx; }
.library-sort-row { display:flex; align-items:center; justify-content:space-between; margin-top:16rpx; padding:0 4rpx; color:#78877b; font-size:21rpx; }
.library-sort-trigger { display:flex; align-items:center; gap:8rpx; min-height:48rpx; padding:0 18rpx; border:1rpx solid #d1dfce; border-radius:999rpx; background:rgba(255,253,248,.78); color:#405f46; font-size:22rpx; }
.book-filters { display:block; width:100%; white-space:normal; overflow:hidden; }
.book-filter-row { display:flex; flex-wrap:wrap; gap:12rpx; }
.library-list { width:100%; margin:14rpx 0 0; padding:0 24rpx; background:rgba(255,255,250,.82); box-sizing:border-box; }
.library-item { display:flex; align-items:center; gap:20rpx; margin:0; padding:24rpx 52rpx 24rpx 4rpx; border:0; border-bottom:1rpx solid #d5e1d1; border-radius:0; background:transparent; }
.library-swipe-row { position:relative; overflow:hidden; }
.library-page .library-swipe-actions { position:absolute; z-index:3; top:0; left:100%; bottom:0; display:flex; align-items:center; justify-content:flex-end; gap:12rpx; width:220rpx; padding:0 28rpx 0 8rpx; box-sizing:border-box; }
.library-swipe-action { display:flex; align-items:center; justify-content:center; width:80rpx; height:80rpx; margin:0; padding:0; border:1rpx solid rgba(255, 255, 255, .86); border-radius:50%; background:rgba(255, 255, 255, .7); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .9); }
.library-swipe-action::after { border:0; }
.library-swipe-edit { background:rgba(236, 246, 239, .82); }
.library-swipe-delete { background:rgba(247, 236, 234, .86); }
.swipe-action-icon { width:36rpx; height:36rpx; }
.library-page .library-item-front { position:relative; z-index:2; background:transparent; transition:transform .32s cubic-bezier(.22, .75, .18, 1); will-change:transform; }
.library-item-swiped { transform:translateX(-220rpx); }
.library-item-managing { transform:none !important; }
.library-item-managing::after { display:none; }
.library-item-copy { flex:1; min-width:0; }
.library-wordbook-list { margin:22rpx 0 0; }
.library-wordbook-card { display:flex; align-items:center; min-height:142rpx; margin-bottom:14rpx; padding:24rpx 28rpx; border:1rpx solid #d8e3d5; border-radius:16rpx; background:rgba(255,253,248,.9); box-sizing:border-box; }
.library-wordbook-copy { flex:1; min-width:0; }
.library-wordbook-en { color:#203e27; font-family:Georgia,"Times New Roman",serif; font-size:36rpx; line-height:1.25; word-break:break-word; }
.library-wordbook-zh { margin-top:8rpx; color:#315737; font-size:25rpx; line-height:1.4; }
.library-wordbook-source { display:inline-block; margin-top:10rpx; padding:5rpx 14rpx; border-radius:999rpx; background:#e5f0e2; color:#55725a; font-size:20rpx; }
.library-wordbook-card .chevron { margin-right:4rpx; }
.selection-check { display:flex; align-items:center; justify-content:center; flex:0 0 42rpx; width:42rpx; height:42rpx; border:2rpx solid #9eb09d; border-radius:50%; color:#fff; font-size:25rpx; box-sizing:border-box; }
.selection-check-active { border-color:#789372; background:#789372; }
.library-en { font-family:Georgia,"Times New Roman",serif; font-size:34rpx; font-weight:400; }
.library-zh { margin-top:8rpx; color:#315737; font-size:26rpx; }
.library-source { color:#728374; font-size:21rpx; }
.library-empty { padding-top:110rpx; text-align:center; }
.library-empty-search-art .empty-book { left:70rpx; top:8rpx; width:98rpx; height:124rpx; border:3rpx solid #789372; border-radius:8rpx; background:#fffdf8; transform:none; }
.library-empty-search-art .empty-book::before { content:''; position:absolute; left:18rpx; right:18rpx; top:27rpx; height:3rpx; background:#b7c8b2; box-shadow:0 18rpx 0 #b7c8b2,0 36rpx 0 #b7c8b2; }
.library-empty-search-art .empty-book::after { display:none; }
.empty-search-lens { position:absolute; right:-31rpx; bottom:-24rpx; width:49rpx; height:49rpx; border:5rpx solid #52745a; border-radius:50%; box-sizing:border-box; }
.empty-search-lens::after { content:''; position:absolute; right:-19rpx; bottom:-13rpx; width:28rpx; height:5rpx; border-radius:3rpx; background:#52745a; transform:rotate(45deg); }
.library-empty-search-art .empty-leaf { left:54rpx; top:16rpx; opacity:.8; }
.library-clear-action { width:76%; margin:28rpx auto 0; border:1rpx solid #789372; background:transparent; color:#315737; }
.library-clear-action + .library-empty-action { margin-top:14rpx; }
.manage-bar { position:fixed!important; z-index:40!important; left:0; right:0; bottom:0; display:flex; align-items:center; justify-content:space-between; height:104rpx; padding:0 34rpx; border-top:1rpx solid #ccd9c9; background:#fffdf9; box-sizing:border-box; color:#5e7162; font-size:23rpx; box-shadow:0 -8rpx 24rpx rgba(48,78,54,.08); }
.manage-select-all,.manage-delete { height:62rpx; line-height:62rpx; padding:0 26rpx; margin:0; border:0; border-radius:999rpx; background:transparent; color:#315737; font-size:24rpx; }
.manage-delete { color:#a8aaa8; }
.manage-delete-active { background:#f7e7e4; color:#a65750; }
.manage-select-all::after,.manage-delete::after { border:0; }
.library-page .back-to-top { position:fixed!important; z-index:35!important; right:24rpx; display:flex; flex-direction:row; align-items:center; justify-content:center; width:auto; min-width:136rpx; height:58rpx; padding:0 20rpx; margin:0; border:1rpx solid rgba(75,108,78,.2); border-radius:999rpx; background:rgba(255,253,248,.96); color:#315737; font-size:21rpx; line-height:1; box-shadow:0 8rpx 24rpx rgba(43,76,48,.15); }
.back-to-top::after { border:0; }
.back-to-top-arrow { margin-right:7rpx; font-size:28rpx; line-height:.9; }

/* Liquid theme final layer */
.library-page {
  min-height: 100vh;
  padding: 0 28rpx calc(190rpx + var(--custom-tab-bar-space));
  overflow-x: hidden;
  overflow-y: visible;
  box-sizing: border-box;
}

.library-page::before,
.library-page::after {
  display: none;
}

.library-heading .page-title {
  color: #153729;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 48rpx;
  font-weight: 400;
}

.library-page > .page-subtitle { color: #687c71; }

.manage-button {
  color: #315d48;
  background: rgba(255, 255, 255, .34);
  border-color: rgba(255, 255, 255, .8);
}

.library-view-tabs {
  height: 76rpx;
  margin-top: 26rpx;
  border-color: rgba(255, 255, 255, .82);
  background: rgba(255, 255, 255, .28);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .7);
}

.library-view-tab { color: #60756a; font-size: 25rpx; }
.library-view-tab-active { background: rgba(69, 111, 86, .8); color: #fff; }

.library-page .search-wrap {
  height: 74rpx;
  border-color: rgba(255, 255, 255, .82);
  background: rgba(255, 255, 255, .32);
}

.search-clear { background: rgba(71, 118, 93, .16); color: #47765d; }
.library-filters { margin-top: 18rpx; }
.library-filters .filter-tab { color: #687c71; background: rgba(255, 255, 255, .28); border-color: rgba(255, 255, 255, .76); }
.library-filters .filter-tab-active { color: #fff; background: rgba(69, 111, 86, .8); }
.library-sort-row { color: #687c71; }
.library-sort-trigger { color: #315d48; background: rgba(255, 255, 255, .28); border-color: rgba(255, 255, 255, .76); }

.library-list {
  min-height: 0;
  width: calc(100% + 56rpx);
  margin: 18rpx -28rpx 0;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.library-swipe-row {
  width: 100%;
  overflow: hidden;
}

.library-item,
.library-item-front {
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 40rpx 28rpx 36rpx;
  border-bottom: 1rpx solid rgba(67, 100, 80, .1);
  background: rgba(255, 255, 255, .28) !important;
}

.library-item::after {
  right: 28rpx;
}

.library-item-front {
  background: rgba(255, 255, 255, .28) !important;
}

.library-en { color: #153729; font-family: Baskerville, "Palatino Linotype", Georgia, serif; font-size: 33rpx; }
.library-zh { color: #315543; font-size: 25rpx; }
.library-note,
.library-source { color: #687c71; }

.library-wordbook-list { margin-top: 20rpx; }
.library-wordbook-card { min-height: 132rpx; border-radius: 32rpx; }
.library-wordbook-en { color: #153729; font-family: Baskerville, "Palatino Linotype", Georgia, serif; font-size: 32rpx; }
.library-wordbook-zh { color: #315543; }

.library-empty {
  width: auto;
  margin-top: 36rpx;
  padding: 56rpx 36rpx 48rpx;
  border: 2rpx solid rgba(255, 255, 255, .78);
  border-radius: 40rpx;
  background: transparent;
  box-shadow: 0 12rpx 32rpx rgba(53, 86, 64, .05);
  text-align: center;
}

.library-empty-art,
.library-empty-search-art,
.empty-book,
.empty-leaf {
  display: none;
}

.library-empty-kicker {
  color: #6a8075;
  font-size: 18rpx;
  font-weight: 500;
  letter-spacing: 6rpx;
}

.library-empty-title {
  margin-top: 22rpx;
  color: #153729;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1.25;
}

.library-empty-copy {
  margin-top: 16rpx;
  color: #687c71;
  font-size: 24rpx;
  line-height: 1.6;
}

.library-clear-action,
.library-empty-action {
  width: 100%;
  height: 86rpx;
  margin: 28rpx 0 0;
  line-height: 86rpx;
  border-radius: 999rpx;
}

.library-empty-action {
  color: #f8fffa;
  background: rgba(55, 105, 78, .84);
}

.floating-add,
.back-to-top { background: rgba(55, 105, 78, .86); color: #fff; border-color: rgba(255, 255, 255, .82); }
.manage-bar { background: rgba(246, 252, 248, .9); border-top-color: rgba(255, 255, 255, .82); }
.manage-select-all { color: #315d48; }
.manage-delete-active { color: #9d5f58; background: rgba(255, 235, 232, .72); }
