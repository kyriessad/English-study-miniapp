<view wx:if="{{loading}}" class="page detail-page core-status liquid-theme-page" style="padding-top: {{safeTop}}px;"><image class="theme-ambient-image" src="/assets/home/home-ambient-v6.jpg" mode="aspectFill" aria-hidden="true"></image><text>正在加载内容…</text></view>
<view wx:elif="{{error}}" class="page detail-page core-status core-status-error liquid-theme-page" style="padding-top: {{safeTop}}px;"><image class="theme-ambient-image" src="/assets/home/home-ambient-v6.jpg" mode="aspectFill" aria-hidden="true"></image><view>{{error}}</view><button class="text-link pressable press-glass" hover-class="press-on" hover-stay-time="90" bindtap="retryLoad">重新加载</button></view>
<view class="page detail-page liquid-theme-page" style="padding-top: {{safeTop}}px;" wx:elif="{{item}}">
  <image class="theme-ambient-image" src="/assets/home/home-ambient-v6.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="detail-top" style="padding-right: {{menuRightInset}}px;">
    <view class="back pressable press-glass" hover-class="press-on" hover-stay-time="90" bindtap="goBack">‹</view>
    <view class="detail-top-space"></view>
    <button
      wx:if="{{mode === 'personal' && !fromReview}}"
      class="detail-edit pressable press-glass"
      hover-class="press-on"
      hover-stay-time="90"
      bindtap="goEdit"
    >编辑</button>
  </view>

  <view class="detail-hero">
    <view wx:if="{{sourceChip}}" class="detail-source">{{sourceChip}}</view>
    <view class="detail-word-row">
      <view class="detail-en {{englishClass}}">{{english}}</view>
      <button
        class="sound-btn pressable press-glass {{pronunciationPlaying ? 'sound-btn-playing' : ''}}"
        disabled="{{pronunciationLoading}}"
        hover-class="press-on"
        hover-stay-time="90"
        aria-label="播放发音"
        bindtap="play"
      ></button>
    </view>
    <view wx:if="{{phoneticDisplay}}" class="phonetic-row"><text>{{phoneticDisplay}}</text></view>
    <view wx:if="{{chinese}}" class="detail-zh">{{chinese}}</view>
    <view wx:elif="{{mode === 'personal'}}" class="detail-zh detail-zh-empty">暂未填写理解</view>
  </view>

  <view wx:if="{{whereEncountered || notes}}" class="detail-meta">
    <view wx:if="{{whereEncountered}}" class="detail-meta-row">
      <text class="detail-meta-label">来源</text>
      <text>{{whereEncountered}}</text>
    </view>
    <view wx:if="{{notes}}" class="detail-meta-row">
      <text class="detail-meta-label">备注</text>
      <text>{{notes}}</text>
    </view>
  </view>

  <view wx:if="{{explanation}}" class="detail-explain">
    <view class="detail-explain-kicker">讲解</view>
    <view wx:if="{{explanation.meaning}}" class="detail-explain-block">
      <view class="detail-explain-label">补充</view>
      <view class="detail-explain-copy">{{explanation.meaning}}</view>
    </view>
    <view wx:if="{{explanation.usage}}" class="detail-explain-block">
      <view class="detail-explain-label">场景</view>
      <view class="detail-explain-copy">{{explanation.usage}}</view>
    </view>
    <view wx:if="{{explanation.exampleEn}}" class="detail-explain-block">
      <view class="detail-explain-label">例句</view>
      <view class="detail-explain-example">
        <view class="detail-explain-en">{{explanation.exampleEn}}</view>
        <view wx:if="{{explanation.exampleZh}}" class="detail-explain-zh">{{explanation.exampleZh}}</view>
      </view>
    </view>
    <view wx:if="{{explanation.relatedText}}" class="detail-explain-block">
      <view class="detail-explain-label">相似</view>
      <view class="detail-explain-copy">{{explanation.relatedText}}</view>
    </view>
  </view>
  <view wx:elif="{{mode === 'public'}}" class="detail-explain-action">
    <button
      class="detail-explain-link pressable press-glass"
      hover-class="press-on"
      hover-stay-time="90"
      loading="{{analyzing}}"
      disabled="{{analyzing}}"
      bindtap="analyze"
    >{{analyzing ? '正在讲解…' : '查看讲解'}}</button>
  </view>

  <view wx:if="{{mode === 'public'}}" class="detail-bottom">
    <button
      class="remember-detail pressable {{saved ? 'remembered press-glass' : 'press-primary'}}"
      hover-class="press-on"
      hover-stay-time="90"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="remember"
    >{{saved ? '已加入' : '想记住'}}</button>
  </view>
</view>
