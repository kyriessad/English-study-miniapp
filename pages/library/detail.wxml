<view wx:if="{{loading}}" class="page detail-page core-status" style="padding-top: {{safeTop}}px;">正在加载内容…</view>
<view wx:elif="{{error}}" class="page detail-page core-status core-status-error" style="padding-top: {{safeTop}}px;"><view>{{error}}</view><button class="text-link" bindtap="retryLoad">重新加载</button></view>
<view class="page detail-page" style="padding-top: {{safeTop}}px;" wx:elif="{{item}}">
  <view class="subpage-top" style="padding-right: {{menuRightInset}}px;"><view class="back" bindtap="goBack">‹</view><view class="eyebrow">{{mode === 'public' ? '公共素材' : '我的英语'}}</view><button wx:if="{{mode === 'personal' && !fromReview}}" class="top-text-button" bindtap="goEdit"><text class="edit-icon">✎</text>编辑</button></view>
  <view class="detail-hero">
    <view wx:if="{{mode === 'public'}}" class="detail-category">{{item.source || '英语表达'}} · {{item.category || '英语表达'}}</view>
    <view class="detail-word-row"><view class="detail-en">{{english}}</view><button class="sound-btn {{pronunciationPlaying ? 'sound-btn-playing' : ''}}" disabled="{{pronunciationLoading}}" aria-label="播放发音" bindtap="play"></button></view>
    <view wx:if="{{phoneticDisplay}}" class="phonetic-row"><text>{{phoneticDisplay}}</text></view>
    <view class="detail-zh">{{item.zh || my || '暂未填写理解'}}</view>
  </view>
  <view wx:if="{{mode === 'personal'}}" class="detail-sections">
    <view class="detail-section detail-section-understanding"><view class="section-title"><text>我的理解</text></view><view class="section-value">{{my || item.zh || '暂未填写理解'}}</view></view>
    <view class="detail-section detail-section-details"><view class="section-toggle" data-section="details" bindtap="toggleSection"><view class="section-title"><text>详细信息</text></view><text class="section-toggle-text">{{detailsExpanded ? '收起' : '展开'}} <text class="section-chevron {{detailsExpanded ? 'section-chevron-open' : ''}}">⌄</text></text></view><view wx:if="{{detailsExpanded}}" class="section-content"><view wx:if="{{whereEncountered}}" class="section-detail-row"><text class="section-detail-label">在哪里遇到</text><text>{{whereEncountered}}</text></view><view class="section-detail-row"><text class="section-detail-label">分类</text><text>{{item.category || '英语表达'}}</text></view><view wx:if="{{notes}}" class="section-detail-row"><text class="section-detail-label">补充备注</text><text>{{notes}}</text></view></view></view>
    <view wx:if="{{analysis}}" class="detail-section detail-section-reference"><view class="section-toggle" data-section="reference" bindtap="toggleSection"><view class="section-title"><text>参考信息</text></view><text class="section-toggle-text">{{referenceExpanded ? '收起' : '展开'}} <text class="section-chevron {{referenceExpanded ? 'section-chevron-open' : ''}}">⌄</text></text></view><view wx:if="{{referenceExpanded}}" class="section-content"><view wx:if="{{analysis.usage}}" class="analysis-row"><text class="analysis-label">使用场景</text><text>{{analysis.usage}}</text></view><view wx:if="{{analysis.exampleEn}}" class="analysis-row analysis-example-row"><text class="analysis-label">例句</text><view class="analysis-example-copy"><text>{{analysis.exampleEn}}</text><text wx:if="{{analysis.exampleZh}}" class="analysis-example-zh">{{analysis.exampleZh}}</text></view><button class="sound-btn example-sound-btn" disabled="{{pronunciationLoading}}" aria-label="播放例句" bindtap="playExample"></button></view><view wx:if="{{analysis.relatedText}}" class="analysis-row"><text class="analysis-label">相似表达</text><text>{{analysis.relatedText}}</text></view></view></view>
  </view>
  <view wx:else class="detail-sections">
    <view class="detail-section detail-section-usage"><view class="section-toggle" data-section="usage" bindtap="toggleSection"><view class="section-title"><text>使用场景</text></view><text class="section-toggle-text">{{usageExpanded ? '收起' : '展开'}} <text class="section-chevron {{usageExpanded ? 'section-chevron-open' : ''}}">⌄</text></text></view><view wx:if="{{usageExpanded}}" class="section-value">{{item.context || '在真实语境中理解和使用这条英语。'}}</view></view>
    <view class="detail-section detail-section-example"><view class="section-toggle" data-section="example" bindtap="toggleSection"><view class="section-title"><text>例句</text></view><text class="section-toggle-text">{{exampleExpanded ? '收起' : '展开'}} <text class="section-chevron {{exampleExpanded ? 'section-chevron-open' : ''}}">⌄</text></text></view><view wx:if="{{exampleExpanded}}" class="public-example"><view class="section-value section-example-en">{{item.sentence || item.context || english}}</view><button class="sound-btn example-sound-btn" disabled="{{pronunciationLoading}}" aria-label="播放例句" bindtap="playExample"></button><view class="section-example-zh">{{item.sentenceZh || item.zh}}</view></view></view>
    <view class="detail-section detail-section-reference"><view class="section-toggle" data-section="reference" bindtap="toggleSection"><view class="section-title"><text>参考信息</text></view><text class="section-toggle-text">{{referenceExpanded ? '收起' : '展开'}} <text class="section-chevron {{referenceExpanded ? 'section-chevron-open' : ''}}">⌄</text></text></view><view wx:if="{{referenceExpanded}}" class="section-content"><view class="section-value">{{item.zh}}</view><button class="outline-button" bindtap="analyze">{{analysis ? '更新 AI 深入分析' : 'AI 深入分析'}}</button><view wx:if="{{analysis}}" class="analysis-panel"><view wx:if="{{analysis.meaning}}" class="analysis-row"><text class="analysis-label">常见理解</text><text>{{analysis.meaning}}</text></view><view wx:if="{{analysis.usage}}" class="analysis-row"><text class="analysis-label">使用场景</text><text>{{analysis.usage}}</text></view><view wx:if="{{analysis.exampleEn}}" class="analysis-row"><text class="analysis-label">例句</text><text>{{analysis.exampleEn}} {{analysis.exampleZh}}</text></view><view wx:if="{{analysis.relatedText}}" class="analysis-row"><text class="analysis-label">相似表达</text><text>{{analysis.relatedText}}</text></view></view></view></view>
  </view>
  <view wx:if="{{mode === 'public'}}" class="detail-bottom"><button class="remember-detail {{saved || item.joined ? 'remembered' : ''}}" bindtap="remember" loading="{{saving}}" disabled="{{saving || saved || item.joined}}">{{saved || item.joined ? '已加入我的英语' : '＋ 加入我的英语'}}</button><button wx:if="{{saved || item.joined}}" class="text-link detail-library-link" bindtap="goLibrary">去我的英语查看 ›</button></view>
</view>
