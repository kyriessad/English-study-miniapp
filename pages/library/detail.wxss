/* Wordbook reading: quiet surfaces, explicit actions and stable navigation. */
.wb-counter { color:#5b7465; font-size:23rpx; margin-left:18rpx; }
.wb-word { margin-top:34rpx; overflow-wrap:break-word; }
.wb-actions { display:flex; gap:18rpx; margin:28rpx 0 38rpx; }
.wb-actions .wb-tool { flex:1; width:auto; min-width:0; height:76rpx; margin:0; gap:12rpx; border:1rpx solid #c0d8ca; border-radius:22rpx; background:rgba(255,255,255,.65); color:#315d48; font-size:25rpx; }
.wb-actions .wb-tool.is-on { background:#dceee3; border-color:#9fc6af; }
.wb-tool-image { width:32rpx; height:32rpx; }
.wb-section-heading { display:flex; align-items:center; justify-content:space-between; margin:28rpx 0 14rpx; color:#335744; font-size:25rpx; font-weight:600; }
.wb-section-heading text { font-size:21rpx; font-weight:400; color:#6c8074; }
.wb-example-row { display:block; margin-top:0; border:1rpx solid rgba(255,255,255,.9); border-radius:26rpx; background:rgba(255,255,255,.65); overflow:hidden; }
.wb-example { padding:24rpx; border:0; background:transparent; box-shadow:none; }
.wb-plus { width:auto; height:66rpx; margin:0 24rpx; justify-content:flex-start; border:0; border-top:1rpx solid #dbe7df; border-radius:0; background:transparent; color:#38634c; font-size:23rpx; }
.wb-collocations { margin:0 0 150rpx; padding:0 24rpx; border:1rpx solid rgba(255,255,255,.9); border-radius:26rpx; background:rgba(255,255,255,.55); }
.wb-collocation { margin:0; padding:20rpx 0; border-bottom:1rpx solid #dce8e0; }
.wb-collocation:last-child { border-bottom:0; }
.wb-empty { padding:24rpx; color:#708477; font-size:24rpx; background:rgba(255,255,255,.5); border-radius:22rpx; }
.wb-nav { box-sizing:border-box; gap:18rpx; padding:16rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background:rgba(237,246,240,.97); border-top:1rpx solid #d2e2d8; }
.wb-nav-prev,.wb-nav-next { flex:1; min-width:0; max-width:none; margin:0; padding:14rpx 22rpx; min-height:88rpx; display:flex; align-items:flex-start; flex-direction:column; justify-content:center; border:1rpx solid #bfd6c8; border-radius:22rpx; background:#f8fcf9; font-family:inherit; line-height:1.3; }
.wb-nav-next { align-items:flex-end; background:#dceee3; }
.wb-nav-prev::after,.wb-nav-next::after { border:0; }
.wb-nav-label { font-size:20rpx; color:#557560; }
.wb-nav-word { max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-top:4rpx; color:#204c34; font-family:Georgia,serif; font-size:28rpx; }
.wb-nav button[disabled] { opacity:.48; }

page .liquid-theme-page.detail-page > .wb-nav { position:fixed; z-index:20; left:0; right:0; bottom:0; }

page .liquid-theme-page.detail-page > .detail-return { position: sticky; bottom: 0; z-index: 20; padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom)); background: #edf5ef; }
.detail-return .action { width: 100%; }

.detail-sound-image { width: 32rpx; height: 32rpx; }
.detail-page .sound-btn::before, .detail-page .sound-btn::after { display: none; }
.detail-page .sound-btn { padding: 0; flex: 0 0 44px; }
.detail-edit { min-width: 44px; min-height: 44px; }
