<view class="page home-page">
  <!-- ===== Header ===== -->
  <view class="header">
    <view class="title">英语学习</view>
    <view class="subtitle">先完成今天的学习，再管理你的卡片库</view>
  </view>

  <!-- ===== Today's Task Dashboard ===== -->
  <view class="dashboard-card">
    <view class="dashboard-header">
      <text class="dashboard-title">今日学习</text>
      <view class="dashboard-dot"></view>
    </view>

    <view class="dashboard-total-row">
      <text class="dashboard-total-num">{{totalToday}}</text>
      <text class="dashboard-total-label">今日任务</text>
    </view>

    <view class="dashboard-stats">
      <view class="dashboard-stat-item">
        <text class="dashboard-stat-num">{{toNew}}</text>
        <text class="dashboard-stat-label">新卡</text>
      </view>
      <view class="dashboard-stat-divider"></view>
      <view class="dashboard-stat-item">
        <text class="dashboard-stat-num">{{toReview}}</text>
        <text class="dashboard-stat-label">到期复习</text>
      </view>
      <view class="dashboard-stat-divider"></view>
      <view class="dashboard-stat-item">
        <text class="dashboard-stat-num">{{strengtheningInReview}}</text>
        <text class="dashboard-stat-label">需加强</text>
      </view>
    </view>

    <view class="dashboard-actions">
      <button
        class="primary-btn {{reviewActions.daily.enabled ? '' : 'primary-btn-disabled'}}"
        disabled="{{!reviewActions.daily.enabled || reviewEntryLoading}}"
        data-key="daily"
        bindtap="handleReviewActionTap"
      >{{reviewActions.daily.label}}</button>
    </view>

    <view class="dashboard-secondary-actions">
      <button
        class="secondary-btn secondary-btn-sm {{reviewActions.newOnly.enabled ? '' : 'secondary-btn-disabled'}}"
        disabled="{{!reviewActions.newOnly.enabled || reviewEntryLoading}}"
        data-key="newOnly"
        bindtap="handleReviewActionTap"
      >{{reviewActions.newOnly.label}}</button>
      <button
        class="secondary-btn secondary-btn-sm {{reviewActions.strengthening.enabled ? '' : 'secondary-btn-disabled'}}"
        disabled="{{!reviewActions.strengthening.enabled || reviewEntryLoading}}"
        data-key="strengthening"
        bindtap="handleReviewActionTap"
      >{{reviewActions.strengthening.label}}</button>
    </view>

    <!-- Empty task tip: all-zero -->
    <view wx:if="{{showEmptyTaskTip}}" class="dashboard-empty-tip">
      今天暂无推荐任务，可以先整理卡片库或稍后再来。
    </view>

    <!-- Error tip: overview load failed -->
    <view wx:elif="{{reviewOverviewError}}" class="dashboard-error-tip">
      今日任务暂不可用，请稍后再试。
    </view>
  </view>

  <!-- ===== Card Library ===== -->
  <view class="library-section">
    <view class="section-header">
      <text class="section-title">卡片库</text>
      <text class="section-subtitle">按学习状态管理全部卡片</text>
    </view>

    <!-- Library Tabs -->
    <view class="library-tabs">
      <view
        wx:for="{{libraryTabs}}"
        wx:key="key"
        class="library-tab {{currentLibraryTab === item.key ? 'library-tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onLibraryTabTap"
      >
        <text>{{item.label}}</text>
        <text wx:if="{{item.count > 0}}" class="library-tab-count">{{item.count}}</text>
      </view>
    </view>

    <!-- Library preparation tip: shown in 未学习 tab when some cards aren't ready -->
    <view wx:if="{{showLibraryPreparationTip}}" class="library-tip">
      部分卡片需要重试分析或补全内容，准备好后会进入学习任务。
    </view>

    <!-- 4C-1a/1b: New-only study entry card (only in 未学习 tab) -->
    <view wx:if="{{currentLibraryTab === 'new' && !isManageMode}}" class="new-study-card">
      <view class="new-study-card-header">
        <text class="new-study-card-title">学习新卡</text>
        <view class="new-study-card-dot"></view>
      </view>
      <text class="new-study-card-subtitle">{{newOnlyEntryState.subtitle}}</text>
      <view class="new-study-card-action">
        <button
          class="new-study-btn {{newOnlyEntryState.enabled ? '' : 'new-study-btn-disabled'}}"
          disabled="{{!newOnlyEntryState.enabled || reviewEntryLoading}}"
          catchtap="handleStartNewOnlySession"
        >{{newOnlyEntryState.label}}</button>
        <view wx:if="{{newOnlyEntryState.enabled}}" class="new-study-arrow">→</view>
      </view>
    </view>

    <!-- Search -->
    <view class="search-row {{showFixedSearch ? 'search-row-fixed' : ''}}">
      <view class="search-box">
        <text class="search-icon">⌕</text>
        <input
          class="search-input"
          type="text"
          placeholder="搜索英文、理解、备注或复习信息"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
        />
        <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">清空</view>
        <view wx:if="{{!isManageMode}}" class="search-divider"></view>
        <view
          wx:if="{{!isManageMode}}"
          class="search-filter-action {{showMoreFilters ? 'search-filter-action-active' : ''}}"
          bindtap="toggleMoreFilters"
        >
          {{showMoreFilters ? '收起' : '筛选'}}
        </view>
      </view>
    </view>

    <view wx:if="{{showFixedSearch}}" class="search-row-spacer"></view>

    <!-- Advanced Filters -->
    <view wx:if="{{showMoreFilters && !isManageMode}}" class="filter-card">
      <view class="filter-grid">
        <view class="filter-item">
          <view class="filter-label">卡片类型</view>
          <view class="filter-picker-row">
            <picker
              class="filter-picker"
              mode="selector"
              range="{{categoryFilterOptions}}"
              value="{{categoryFilterIndex}}"
              bindchange="onCategoryFilterChange"
            >
              <view class="picker-field">{{selectedCategoryFilter}}</view>
            </picker>
            <view class="filter-count">({{categoryCount}})</view>
          </view>
        </view>
        <view class="filter-item">
          <view class="filter-label">考试场景</view>
          <view class="filter-picker-row">
            <picker
              class="filter-picker"
              mode="selector"
              range="{{examSceneFilterOptions}}"
              value="{{examSceneFilterIndex}}"
              bindchange="onExamSceneFilterChange"
            >
              <view class="picker-field">{{selectedExamSceneFilter}}</view>
            </picker>
            <view class="filter-count">({{examSceneCount}})</view>
          </view>
        </view>
        <view class="filter-item">
          <view class="filter-label">考试模块</view>
          <view class="filter-picker-row">
            <picker
              class="filter-picker"
              mode="selector"
              range="{{examModuleFilterOptions}}"
              value="{{examModuleFilterIndex}}"
              bindchange="onExamModuleFilterChange"
            >
              <view class="picker-field">{{selectedExamModuleFilter}}</view>
            </picker>
            <view class="filter-count">({{examModuleCount}})</view>
          </view>
        </view>
      </view>
    </view>

    <!-- Cards Count -->
    <view wx:if="{{!isManageMode}}" class="list-toolbar">
      <view class="list-counts">共 {{displayTotalCount || totalCardCount}} 张 · 当前 {{displayCurrentCount || currentResultCount}} 张</view>
    </view>

    <!-- Manage Mode Toolbar -->
    <view wx:if="{{isManageMode}}" class="manage-toolbar manage-toolbar-fixed">
      <view class="manage-toolbar-title">已选 {{selectedCardIds.length}} 张卡片</view>
      <view class="manage-toolbar-actions">
        <button class="manage-btn" bindtap="selectAllCards">全选/取消</button>
        <button class="manage-btn" bindtap="handleBatchAssignExamScene">批量设场景</button>
        <button class="manage-btn" bindtap="handleBatchAssignExamModule">批量设模块</button>
        <button class="manage-btn danger-btn" bindtap="handleBatchDelete">批量删除</button>
        <button class="manage-btn" bindtap="exitManageMode">退出管理</button>
      </view>
    </view>

    <view wx:if="{{isManageMode}}" class="manage-toolbar-spacer"></view>

    <!-- Card List -->
    <view class="list-section">
      <view wx:if="{{cards.length === 0}}" class="empty-state">
        还没有卡片，先添加一张你想记住的英文内容吧。
      </view>

      <view wx:elif="{{filteredCards.length === 0}}" class="empty-state">
        没有找到匹配的卡片，换个关键词或筛选条件试试。
      </view>

      <block wx:else>
        <block wx:for="{{filteredCards}}" wx:key="id">
          <view
            class="card-item home-card-item {{item.selected ? 'card-item-selected' : ''}}"
            data-id="{{item.id}}"
            bindtap="openCard"
            bindlongpress="onCardLongPress"
          >
            <view class="card-top-row">
              <view class="card-tags">
                <view class="card-tag card-tag-home">{{item.category || '单词'}}</view>
              </view>
              <view class="card-status-pill {{item.displayStatusClass || item.stateClass}}">
                {{item.displayStatusLabel || item.stateLabel}}
              </view>
            </view>

            <view class="card-title">
              {{item.englishPreview}}
            </view>

            <view wx:if="{{item.understandingPreview}}" class="card-desc">
              {{item.understandingPreview}}
            </view>

            <view wx:if="{{item.notesPreview}}" class="card-note-preview">
              {{item.notesPreview}}
            </view>

            <view class="card-meta">
              <view class="card-meta-text">{{item.reviewCountText}}</view>
              <view
                wx:if="{{item.analysisStatusVisible}}"
                class="analysis-status-pill {{item.analysisStatusClass}}"
              >
                {{item.analysisStatusLabel}}
              </view>
            </view>
          </view>
        </block>
      </block>
    </view>

    <!-- Back to Top -->
    <view
      wx:if="{{showBackToTop && !isManageMode && !searchKeyword}}"
      class="back-to-top-btn"
      bindtap="scrollToHomeTop"
    >
      ↑ 顶部
    </view>

    <!-- Batch Panel -->
    <view wx:if="{{isBatchPanelVisible}}" class="batch-mask" bindtap="closeBatchPanel">
      <view class="batch-panel" catchtap="noop">
        <view class="batch-panel-title">{{batchPanelTitle}}</view>
        <block wx:for="{{batchPanelOptions}}" wx:key="*this">
          <view class="batch-option" data-value="{{item}}" bindtap="onBatchPanelOptionTap">
            {{item}}
          </view>
        </block>
        <view class="batch-cancel" bindtap="closeBatchPanel">取消</view>
      </view>
    </view>
  </view>
</view>
