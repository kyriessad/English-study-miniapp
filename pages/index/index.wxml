<view class="page home-page">
  <!-- ===== Header ===== -->
  <view class="header">
    <view class="title">英语知识卡片本</view>
    <view class="subtitle-home">{{dailyStatusMessage}}</view>
    <view class="header-settings" bindtap="goToSettings" hover-class="header-settings--hover">设置</view>
  </view>

  <!-- ===== Status Overview Card: 今日完成 M / N ===== -->
  <view wx:if="{{totalCardCount > 0}}" class="status-overview-card" bindtap="onStatusOverviewTap" hover-class="status-overview-card--hover">
    <view class="status-overview-row">
      <view class="status-overview-progress">
        <text class="status-overview-label">今日目标</text>
        <text class="status-overview-num">{{displayCompleted}} / {{displayTotal}}</text>
      </view>
      <text class="status-overview-arrow">›</text>
    </view>
    <view class="status-overview-bar">
      <view class="status-overview-bar-fill" style="width: {{progressPercent}}%;"></view>
    </view>
  </view>

  <!-- ===== Main Buttons ===== -->
  <!-- goal_blocked && not goal_met: 继续复习 35% (secondary) + 添加卡片继续 65% (primary) -->
  <view wx:if="{{totalCardCount > 0 && isGoalBlocked && !isGoalMet}}" class="main-actions">
    <button class="main-btn review-main-btn" bindtap="goToReview" disabled="{{reviewEntryLoading}}">继续复习</button>
    <button class="main-btn add-main-btn" bindtap="goToAddPage">添加卡片继续</button>
  </view>
  <!-- normal / goal-met / goal-overachieved: 添加卡片 65% (primary) + 进入复习页 35% (secondary) -->
  <view wx:if="{{totalCardCount > 0 && !(isGoalBlocked && !isGoalMet)}}" class="main-actions">
    <button class="main-btn add-main-btn" bindtap="goToAddPage">添加卡片</button>
    <button class="main-btn review-main-btn" bindtap="goToReview" disabled="{{reviewEntryLoading}}">{{reviewButtonLabel}}</button>
  </view>

  <!-- ===== Weak Sync Hint ===== -->
  <view wx:if="{{pendingActionCount > 0}}" class="weak-sync-bar">
    <text class="weak-sync-text">网络恢复后会更新学习记录</text>
  </view>

  <!-- ===== 0-Card Quick Start ===== -->
  <view wx:if="{{totalCardCount === 0}}" class="quick-start-section">
    <view class="quick-start-guide">看到喜欢的英文随手记下来。点下面的示例试试 ↓</view>

    <button class="first-card-btn" bindtap="goToAddPage">添加第一张卡片</button>

    <view class="preset-card {{creatingExampleCard ? 'preset-card-disabled' : ''}}" data-type="word" bindtap="handleCreateExampleCard">
      <view class="preset-card-top">
        <view class="preset-card-type">单词</view>
        <view class="preset-card-plus">＋</view>
      </view>
      <view class="preset-card-content">clutch</view>
      <view class="preset-card-meaning">关键时刻顶得住</view>
    </view>

    <view class="preset-card {{creatingExampleCard ? 'preset-card-disabled' : ''}}" data-type="phrase" bindtap="handleCreateExampleCard">
      <view class="preset-card-top">
        <view class="preset-card-type">短语</view>
        <view class="preset-card-plus">＋</view>
      </view>
      <view class="preset-card-content">break a leg</view>
      <view class="preset-card-meaning">祝你好运，尤其常用于演出或上台前</view>
    </view>

    <view class="preset-card {{creatingExampleCard ? 'preset-card-disabled' : ''}}" data-type="sentence" bindtap="handleCreateExampleCard">
      <view class="preset-card-top">
        <view class="preset-card-type">句子</view>
        <view class="preset-card-plus">＋</view>
      </view>
      <view class="preset-card-content">I'll keep you posted.</view>
      <view class="preset-card-meaning">有进展我会告诉你</view>
    </view>
  </view>

  <!-- ===== Card Library (only when cards exist) ===== -->
  <view wx:if="{{totalCardCount > 0}}" class="library-section">
    <view class="section-header">
      <text class="section-title">卡片库</text>
    </view>

    <!-- Library Tabs / Filter Pills -->
    <view class="library-tabs-wrap">
      <scroll-view class="library-tabs-scroll" scroll-x="{{true}}">
        <view class="library-tabs">
          <view
            wx:for="{{libraryTabs}}"
            wx:key="key"
            class="library-tab {{currentLibraryTab === item.key ? 'library-tab-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onLibraryTabTap"
          >
            <text>{{item.label}}</text>
            <text wx:if="{{item.count > 0}}" class="library-tab-count">{{item.count}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="library-tabs-fade" />
    </view>

    <!-- Library preparation tip -->
    <view wx:if="{{showLibraryPreparationTip}}" class="library-tip">
      部分卡片需要重试分析或补全内容，准备好后会进入学习任务。
    </view>

    <!-- New-only study entry card (only in 未学习 tab, hidden when task in progress) -->
    <view wx:if="{{currentLibraryTab === 'new' && !isManageMode && !hideNewStudyEntry}}" class="new-study-card">
      <view class="new-study-card-header">
        <text class="new-study-card-title">学习新卡</text>
        <view class="new-study-card-dot"></view>
      </view>
      <text class="new-study-card-subtitle">{{newOnlyEntryState.subtitle}}</text>
      <view class="new-study-card-action">
        <button
          class="new-study-btn {{newOnlyEntryState.enabled ? '' : 'new-study-btn-disabled'}}"
          disabled="{{!newOnlyEntryState.enabled || reviewEntryLoading}}"
          catchtap="handleStartNewOnlySession"
        >{{newOnlyEntryState.label}}</button>
        <view wx:if="{{newOnlyEntryState.enabled}}" class="new-study-arrow">→</view>
      </view>
    </view>

    <!-- Category Type Filter Pills -->
    <view class="category-filter-pills">
      <view
        wx:for="{{categoryFilterOptions}}"
        wx:key="*this"
        class="category-pill {{selectedCategoryFilter === item ? 'category-pill-active' : ''}}"
        data-index="{{index}}"
        bindtap="onCategoryPillTap"
      >{{item}}</view>
    </view>

    <!-- Search (only when > 10 cards) -->
    <view wx:if="{{totalCardCount > 10}}" class="search-row {{showFixedSearch ? 'search-row-fixed' : ''}}">
      <view class="search-box">
        <text class="search-icon">⌕</text>
        <input
          class="search-input"
          type="text"
          placeholder="搜索英文、理解、备注或来源"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
        />
        <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">清空</view>
      </view>
    </view>

    <view wx:if="{{totalCardCount > 10 && showFixedSearch}}" class="search-row-spacer"></view>

    <!-- Manage Mode Toolbar -->
    <view wx:if="{{isManageMode}}" class="manage-toolbar manage-toolbar-fixed">
      <view class="manage-toolbar-title">已选 {{selectedCardIds.length}} 张卡片</view>
      <view class="manage-toolbar-actions">
        <button class="manage-btn" bindtap="selectAllCards">全选/取消</button>
        <button class="manage-btn danger-btn" bindtap="handleBatchDelete">批量删除</button>
        <button class="manage-btn" bindtap="exitManageMode">退出管理</button>
      </view>
    </view>

    <view wx:if="{{isManageMode}}" class="manage-toolbar-spacer"></view>

    <!-- Card List -->
    <view class="list-section">
      <view wx:if="{{filteredCards.length === 0 && displayCurrentCount === 0 && totalCardCount > 0}}" class="empty-state">
        没有找到匹配的卡片，换个关键词或筛选条件试试。
      </view>

      <block wx:else>
        <block wx:for="{{filteredCards}}" wx:key="id">
          <view
            class="card-item home-card-item {{item.selected ? 'card-item-selected' : ''}}"
            data-id="{{item.id}}"
            bindtap="openCard"
            bindlongpress="onCardLongPress"
          >
            <view class="card-top-row">
              <view class="card-tags">
                <view class="card-tag card-tag-home">{{item.category || '单词'}}</view>
              </view>
              <view wx:if="{{currentLibraryTab === 'all'}}" class="card-status-pill {{item.displayStatusClass || item.stateClass}}">
                {{item.displayStatusLabel || item.stateLabel}}
              </view>
            </view>

            <view class="card-title">
              {{item.englishPreview}}
            </view>

            <view wx:if="{{item.understandingPreview}}" class="card-desc">
              {{item.understandingPreview}}
            </view>
            <view wx:else class="card-desc card-desc-placeholder">
              还没有写下你的理解，可以现在补充
            </view>

            <view wx:if="{{item.reviewCountText || item.whereEncountered}}" class="card-meta">
              <view class="card-meta-text">{{item.reviewCountText}}</view>
              <view wx:if="{{item.whereEncountered}}" class="card-source-pill">来自：{{item.whereEncountered}}</view>
            </view>
          </view>
        </block>
      </block>
    </view>

    <!-- Back to Top -->
    <view
      wx:if="{{showBackToTop && !isManageMode && !searchKeyword}}"
      class="back-to-top-btn"
      bindtap="scrollToHomeTop"
    >
      ↑ 顶部
    </view>

    <!-- Batch Panel -->
    <view wx:if="{{isBatchPanelVisible}}" class="batch-mask" bindtap="closeBatchPanel">
      <view class="batch-panel" catchtap="noop">
        <view class="batch-panel-title">{{batchPanelTitle}}</view>
        <block wx:for="{{batchPanelOptions}}" wx:key="*this">
          <view class="batch-option" data-value="{{item}}" bindtap="onBatchPanelOptionTap">
            {{item}}
          </view>
        </block>
        <view class="batch-cancel" bindtap="closeBatchPanel">取消</view>
      </view>
    </view>
  </view>
</view>
