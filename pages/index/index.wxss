}

.today-filter-card .filter-label {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #7a8a82;
}

.today-filter-card .filter-picker-row {
  min-height: 66rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #f8fbf9;
  border: 1rpx solid #e1eee6;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.today-filter-card .filter-picker {
  flex: 1;
}

.today-filter-card .picker-field {
  padding: 0;
  min-height: 66rpx;
  line-height: 66rpx;
  background: transparent;
  border: none;
  box-shadow: none;
  font-size: 26rpx;
  font-weight: 600;
  color: #42534a;
}

.today-filter-card .filter-count {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #8a9a91;
}

/* ===== 首页视觉优化：安静的知识库，不做红黄绿侧边条 ===== */

