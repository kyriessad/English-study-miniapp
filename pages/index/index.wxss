.home-ambient {
  position: fixed;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.home-ambient-image {
  display: block;
  width: 100%;
  height: 100%;
}

.home-page {
  position: relative;
  z-index: 1;
  height: 100vh;
  overflow: hidden;
  padding-bottom: calc(24rpx + var(--custom-tab-bar-space));
  box-sizing: border-box;
  color: #153729;
  background: transparent;
  font-family: "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.home-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100%;
  overflow: hidden;
  padding: 8rpx 34rpx 12rpx;
}

.home-masthead {
  position: relative;
  flex: 0 0 auto;
  padding: 4rpx 8rpx 28rpx;
}

.home-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 52rpx;
  box-sizing: border-box;
  color: #52695d;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 7rpx;
}

.home-date {
  flex: 0 0 auto;
  letter-spacing: 4rpx;
}

.home-greeting {
  margin-top: 18rpx;
  color: #123a2b;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 56rpx;
  font-weight: 400;
  line-height: 1.08;
  letter-spacing: 0;
}

.home-tagline {
  margin-top: 14rpx;
  color: #61736a;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 3rpx;
}

.home-status {
  flex: 0 0 auto;
  min-height: 220rpx;
  margin: 0 0 32rpx;
  border: 1rpx solid rgba(255, 255, 255, .78);
  border-radius: 44rpx;
  background: transparent;
  box-shadow: 0 12rpx 32rpx rgba(57, 91, 68, .05);
}

.home-search {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  width: 100%;
  min-height: 98rpx;
  margin: 0 0 24rpx;
  padding: 14rpx 18rpx 14rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, .88);
  border-radius: 32rpx;
  color: #173e2e;
  background: rgba(255, 255, 255, .38);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .9), 0 14rpx 32rpx rgba(49, 84, 62, .08);
  box-sizing: border-box;
  text-align: left;
}

.home-search::after { border: 0; }

.home-search-placeholder {
  flex: 1;
  min-width: 0;
  margin-left: 2rpx;
  color: #73877b;
  font-size: 25rpx;
  font-weight: 400;
  letter-spacing: .5rpx;
}

.home-search-icon {
  position: relative;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  margin-right: 20rpx;
  border: 3rpx solid #416854;
  border-radius: 50%;
  box-sizing: border-box;
}

.home-search-icon::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 13rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #416854;
  transform: rotate(45deg);
}

.home-search-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.home-search-scope {
  margin-top: 3rpx;
  color: #708278;
  font-size: 19rpx;
  font-weight: 400;
  line-height: 1.35;
}

.liquid-panel {
  border: 2rpx solid rgba(255, 255, 255, .78);
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-shadow: 0 12rpx 32rpx rgba(53, 86, 64, .05);
}

.liquid-pressable {
  position: relative;
  overflow: hidden;
  transition: transform .3s cubic-bezier(.2, .72, .2, 1), opacity .3s ease, box-shadow .3s ease, border-color .3s ease, background-color .3s ease;
}

.liquid-pressed {
  transform: scale(.976);
}

.liquid-panel.liquid-pressed,
.recommendation-hero.liquid-pressed,
.home-primary-action.liquid-pressed,
.home-secondary-action.liquid-pressed {
  background: rgba(255, 255, 255, .18);
  border-color: rgba(255, 255, 255, .94);
  box-shadow: 0 8rpx 24rpx rgba(48, 83, 61, .08);
}

.hero-card-pressed {
  opacity: .96;
}

.liquid-pressable::after,
.hero-sound::after,
.hero-remember::after,
.daily-remember::after,
.home-primary-action::after,
.home-secondary-action::after {
  border: 0;
}

.liquid-panel,
.home-primary-action {
  background-color: transparent;
}

.recommendation-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  min-height: 280rpx;
  margin-bottom: 36rpx;
  padding: 28rpx 32rpx 24rpx;
  overflow: hidden;
  border-radius: 36rpx;
  border-color: rgba(255, 255, 255, .86);
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-shadow: 0 12rpx 32rpx rgba(48, 83, 61, .05);
  box-sizing: border-box;
}

.recommendation-heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recommendation-kicker {
  display: flex;
  align-items: center;
  color: #6a8075;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 6rpx;
}

.recommendation-kicker::after {
  content: '';
  width: 72rpx;
  height: 1rpx;
  margin-left: 18rpx;
  background: rgba(52, 83, 66, .32);
}

.hero-sound {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, .86);
  border-radius: 50%;
  background: rgba(255, 255, 255, .42);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .9);
}

.sound-icon-image {
  position: relative;
  z-index: 1;
  width: 34rpx;
  height: 34rpx;
}

.recommendation-english {
  max-width: 610rpx;
  margin-top: 22rpx;
  color: #123b2b;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 0;
  word-break: break-word;
}

.recommendation-english-compact {
  font-size: 49rpx;
  line-height: 1.12;
}

.recommendation-english-small {
  font-size: 39rpx;
  line-height: 1.16;
}

.recommendation-zh {
  max-width: 580rpx;
  margin-top: 28rpx;
  color: #4f675b;
  font-size: 26rpx;
  line-height: 1.55;
  letter-spacing: 1rpx;
  word-break: break-word;
}

.hero-footer {
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 22rpx;
}

.hero-motto {
  color: #7a8d83;
  font-size: 17rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
}

.hero-remember {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 174rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 1rpx solid rgba(255, 255, 255, .9);
  border-radius: 999rpx;
  color: #234b39;
  background: rgba(255, 255, 255, .5);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .96), 0 10rpx 26rpx rgba(54, 88, 66, .08);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 72rpx;
}

.hero-remember-saved {
  color: #f8fffa;
  background: rgba(50, 104, 76, .84);
}

.bookmark-icon-image {
  width: 31rpx;
  height: 31rpx;
  margin-left: 16rpx;
}

.today-section {
  margin-top: 48rpx;
}

.section-heading-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 12rpx 20rpx;
}

.section-heading {
  color: #173c2d;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1.15;
}

.section-note {
  color: #829188;
  font-size: 15rpx;
  line-height: 1.55;
  letter-spacing: 3rpx;
  text-align: left;
}

.daily-row {
  display: flex;
  align-items: center;
  min-height: 142rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 26rpx 22rpx 22rpx;
  border-radius: 36rpx;
  box-sizing: border-box;
}

.daily-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 94rpx;
  width: 94rpx;
  height: 94rpx;
  margin-right: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, .78);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .22);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .94);
}

.daily-icon-image {
  width: 54rpx;
  height: 54rpx;
}

.daily-copy,
.discover-copy {
  flex: 1;
  min-width: 0;
}

.daily-en {
  display: -webkit-box;
  overflow: hidden;
  color: #173a2b;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.25;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.daily-zh {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  color: #667a6f;
  font-size: 23rpx;
  line-height: 1.4;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.daily-remember {
  flex: 0 0 auto;
  min-width: 82rpx;
  height: 52rpx;
  margin: 0 2rpx 0 14rpx;
  padding: 0 12rpx;
  border: 0;
  border-radius: 999rpx;
  color: #486b59;
  background: rgba(255, 255, 255, .18);
  font-size: 19rpx;
  line-height: 52rpx;
}

.daily-remember-saved {
  color: #fff;
  background: rgba(55, 108, 80, .78);
}

.chevron,
.action-arrow {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #315846;
  border-right: 3rpx solid #315846;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.chevron {
  margin-left: 14rpx;
}

.home-actions {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  gap: 20rpx;
  margin-top: 0;
}

.home-primary-action,
.home-secondary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  box-sizing: border-box;
  color: #173e2e;
  font-size: 28rpx;
  font-weight: 600;
}

.home-primary-action,
.home-secondary-action {
  height: 92rpx;
  border-radius: 999rpx;
  background: transparent;
}

.home-action-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 14rpx;
}

.home-primary-action .action-arrow {
  margin-left: 18rpx;
  border-top-color: #315846;
  border-right-color: #315846;
}

.home-add-plus {
  margin-right: 10rpx;
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.discover-section {
  margin-top: 34rpx;
}

.discover-caption {
  padding: 0 12rpx 18rpx;
  color: #6b8074;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 4rpx;
}

.discover-panel {
  overflow: hidden;
  padding: 0 28rpx;
  border-radius: 40rpx;
}

.discover-icon-image {
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  margin: 0 28rpx 0 5rpx;
  box-sizing: border-box;
}

.discover-title {
  color: #244a38;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.discover-subtitle {
  margin-top: 5rpx;
  color: #728379;
  font-size: 21rpx;
  line-height: 1.4;
}

@media (max-width: 350px) {
  .home-content {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .home-greeting {
    font-size: 61rpx;
  }

  .recommendation-hero {
    padding-right: 34rpx;
    padding-left: 34rpx;
  }

  .recommendation-english {
    font-size: 50rpx;
  }

  .recommendation-english-compact {
    font-size: 43rpx;
  }

  .recommendation-english-small {
    font-size: 35rpx;
  }

  .daily-icon-wrap {
    flex-basis: 80rpx;
    width: 80rpx;
    height: 80rpx;
    margin-right: 18rpx;
  }

  .daily-remember {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .liquid-pressable,
  .liquid-pressed,
  .recommendation-hero.liquid-pressed {
    transition: none;
    transform: none;
  }
}

/* The home screen is intentionally one viewport: keep its actions discoverable without page scrolling. */
.home-page { height: 100vh; min-height: 0; overflow: hidden; }
.home-content { height: 100%; overflow: hidden; padding: 4rpx 28rpx 8rpx; }
.home-masthead { padding-bottom: 14rpx; }
.home-meta { min-height: 42rpx; }
.home-greeting { margin-top: 8rpx; font-size: 50rpx; }
.home-tagline { margin-top: 8rpx; }
.home-search { min-height: 82rpx; margin-bottom: 14rpx; padding-top: 10rpx; padding-bottom: 10rpx; }
.home-search-placeholder { font-size: 25rpx; }
.home-search-scope { font-size: 19rpx; }
.home-tagline { letter-spacing: 0; font-size: 25rpx; }
.home-search-scope { font-size: 23rpx; color: #526a5b; }
.recommendation-hero { min-height: 0; background: rgba(249,252,250,.86); margin-bottom: 22rpx; padding: 18rpx 22rpx 14rpx; border-radius: 30rpx; }
.recommendation-kicker { font-size: 23rpx; letter-spacing: 2rpx; color: #526a5b; }
.recommendation-english { display: -webkit-box; overflow: hidden; margin-top: 10rpx; font-size: 34rpx; line-height: 1.2; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.recommendation-english-small { font-size: 31rpx; line-height: 1.22; }
.recommendation-english-compact { font-size: 36rpx; line-height: 1.2; }
.recommendation-zh { display: -webkit-box; overflow: hidden; margin-top: 8rpx; font-size: 22rpx; line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.hero-footer { align-items: center; margin-top: 10rpx; }
.hero-sound { min-height: 44px; min-width: 44px; width: 48rpx; height: 48rpx; }
.hero-remember { min-height: 44px; height: 54rpx; line-height: 54rpx; min-width: 148rpx; padding: 0 18rpx; background: #38634c; color: #fff; font-size: 23rpx; }
.hero-remember .bookmark-icon-image { display: none; }
.hero-remember-saved { background: #e0ede4; color: #315543; }
.home-review-entry { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 16rpx 20rpx; margin: 0 0 20rpx; min-height: 78rpx; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.5); border-radius: 24rpx; background: rgba(233,244,237,.26); color: #315543; text-align: left; line-height: 1.35; }
.home-review-entry::after { border: 0; }
.home-review-copy { min-width: 0; display: flex; flex-direction: column; padding-right: 16rpx; }
.home-review-title { font-size: 25rpx; font-weight: 600; }
.home-review-note { overflow: hidden; font-size: 19rpx; color: #526a5b; margin-top: 3rpx; white-space: nowrap; text-overflow: ellipsis; }
.home-actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 0; }
.home-primary-action, .home-secondary-action { flex: 0 0 auto; width: 100%; height: 58rpx; font-size: 23rpx; }
.home-action-icon { width: 28rpx; height: 28rpx; margin-right: 8rpx; }
.home-primary-action .action-arrow { margin-left: 10rpx; }

/* Let today's sentence sit lightly over the shared ambient artwork. */
.recommendation-hero {
  border-color: rgba(255, 255, 255, .56);
  background: linear-gradient(140deg, rgba(238, 249, 241, .38), rgba(224, 240, 230, .24));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .36), 0 12rpx 30rpx rgba(43, 76, 54, .09);
  -webkit-backdrop-filter: blur(5px) saturate(1.08);
  backdrop-filter: blur(5px) saturate(1.08);
}
.home-add-plus { margin-right: 4rpx; font-size: 29rpx; }

/* Inline dictionary search keeps the learner on the home tab. */
.home-search-active { margin-bottom: 18rpx; }
.home-search-input { flex: 1; min-width: 0; height: 58rpx; padding: 0; color: #173e2e; font-size: 29rpx; line-height: 58rpx; }
.home-search-back,
.home-search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  min-height: 44px;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  color: #315d48;
  background: transparent;
}
.home-search-back { margin-right: 4rpx; font-size: 34px; font-weight: 300; line-height: 1; }
.home-search-clear { margin-left: 4rpx; color: #72867a; font-size: 27px; line-height: 1; }
.home-search-back::after,
.home-search-clear::after { border: 0; }
.home-search-active .home-search-icon { margin-right: 12rpx; }
.home-search-input-placeholder { color: #89988f; font-size: 27rpx; }
.home-inline-search { display: flex; flex: 1 1 auto; flex-direction: column; min-height: 0; padding: 4rpx 2rpx 12rpx; overflow: hidden; }
.inline-search-results { flex: 1; min-height: 0; height: 0; }
.inline-results-heading { padding: 8rpx 10rpx 14rpx; color: #62776a; font-size: 22rpx; letter-spacing: 1rpx; }
.inline-results-count { margin-left: 8rpx; color: #819188; }
.inline-result-card { margin: 0 0 12rpx; border: 1rpx solid rgba(255,255,255,.72); border-radius: 26rpx; background: rgba(243,252,247,.57); box-shadow: 0 8rpx 22rpx rgba(49,84,62,.045); overflow: hidden; }
.inline-result-card-open { background: rgba(245,252,248,.8); border-color: rgba(255,255,255,.9); }
.inline-result-summary { padding: 20rpx 24rpx; min-height: 72rpx; box-sizing: border-box; }
.inline-result-word-row { display: flex; align-items: baseline; min-width: 0; }
.inline-result-word { color: #173e2e; font-family: Georgia, "Times New Roman", serif; font-size: 33rpx; font-weight: 600; }
.inline-result-phonetic { margin-left: 12rpx; color: #738579; font-size: 21rpx; }
.inline-result-chevron { margin-left: auto; padding-left: 12rpx; color: #72917c; font-size: 30rpx; line-height: 1; transition: transform .2s ease; }
.inline-result-chevron-open { transform: rotate(180deg); }
.inline-result-meaning { display: -webkit-box; margin-top: 9rpx; overflow: hidden; color: #4f6658; font-size: 24rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.inline-result-detail { padding: 0 24rpx 24rpx; }
.inline-result-detail-top { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0 10rpx; border-top: 1rpx solid rgba(62,107,76,.15); }
.inline-result-detail-label { color: #718779; font-size: 21rpx; letter-spacing: 2rpx; }
.inline-result-sound { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; border: 1rpx solid rgba(73,122,90,.22); border-radius: 50%; background: rgba(255,255,255,.45); }
.inline-result-sound::after, .inline-result-add::after { border: 0; }
.inline-result-sound-icon { width: 30rpx; height: 30rpx; }
.inline-result-senses { display: flex; flex-direction: column; gap: 10rpx; }
.inline-result-sense, .inline-result-full-meaning { color: #254c37; font-size: 25rpx; line-height: 1.6; word-break: break-word; }
.inline-result-pos { margin-right: 12rpx; color: #718779; font-size: 21rpx; font-style: italic; }
.inline-result-example { margin-top: 20rpx; padding: 16rpx 18rpx; border-left: 3rpx solid rgba(64,113,79,.38); background: rgba(224,240,229,.34); border-radius: 0 14rpx 14rpx 0; }
.inline-result-example-en { color: #173e2e; font-family: Georgia, "Times New Roman", serif; font-size: 27rpx; line-height: 1.45; }
.inline-result-example-zh { margin-top: 6rpx; color: #64796a; font-size: 22rpx; line-height: 1.45; }
.inline-result-collocations { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.inline-result-collocation { padding: 7rpx 13rpx; border-radius: 999rpx; color: #42644c; background: rgba(205,230,212,.42); font-size: 21rpx; }
.inline-result-add { width: 100%; min-height: 72rpx; margin: 22rpx 0 0; border-radius: 999rpx; color: #f7fff9; background: #3f6c51; font-size: 24rpx; line-height: 72rpx; }
.inline-search-state { display: flex; align-items: center; justify-content: center; flex: 1; gap: 14rpx; min-height: 120rpx; padding: 20rpx; color: #738579; font-size: 25rpx; text-align: center; }
.inline-search-error { color: #9b6158; }
.inline-search-spinner { width: 28rpx; height: 28rpx; border: 3rpx solid rgba(81,125,96,.2); border-top-color: #517d60; border-radius: 50%; animation: inline-search-spin .75s linear infinite; }
@keyframes inline-search-spin { to { transform: rotate(360deg); } }
