page { background: #f2f8ef; }

.home-page {
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 0 10rpx;
  overflow: hidden;
  color: #16351f;
  background: radial-gradient(circle at 78% 4%, rgba(255,253,248,.9) 0, rgba(255,253,248,0) 33%), linear-gradient(180deg, #f2f8ef 0%, #edf6e9 42%, #f2f8ef 100%);
}
.home-page > view:not(.home-glow) { position: relative; z-index: 1; }
.home-glow { position: absolute; z-index: 0; border-radius: 50%; pointer-events: none; }
.home-glow-top { top: 16rpx; right: -120rpx; width: 380rpx; height: 250rpx; background: radial-gradient(circle, rgba(135,166,128,.1), rgba(135,166,128,0) 68%); transform: rotate(-18deg); }
.home-glow-side { top: 670rpx; left: -170rpx; width: 360rpx; height: 360rpx; background: radial-gradient(circle, rgba(199,224,195,.28), rgba(199,224,195,0) 70%); }
.home-header { flex: 0 0 78rpx; min-height: 0; display: flex; align-items: center; justify-content: space-between; padding: 6rpx 44rpx; box-sizing: border-box; }
.home-greeting { color: #27472d; font-family: Georgia, "Times New Roman", serif; font-size: 40rpx; font-weight: 400; line-height: 1.2; }
.home-notification { position: relative; flex: 0 0 42rpx; width: 42rpx; height: 42rpx; margin-right: 2rpx; border: 4rpx solid #496b45; border-bottom: 0; border-radius: 22rpx 22rpx 8rpx 8rpx; box-sizing: border-box; }
.home-notification::before { content: ''; position: absolute; left: -8rpx; right: -8rpx; bottom: -5rpx; height: 5rpx; border-radius: 999rpx; background: #496b45; }
.home-notification::after { content: ''; position: absolute; left: 14rpx; bottom: -14rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #496b45; }
.recommendation-card { flex: 0 1 680rpx; min-height: 0; display: flex; flex-direction: column; overflow: hidden; border-radius: 12rpx 12rpx 0 0; background: #fffdf8; border: 1rpx solid rgba(73,107,69,.12); box-shadow: 0 12rpx 34rpx rgba(35,64,38,.07); }
.recommendation-hero { flex: 0 0 315rpx; min-height: 0; display: flex; flex-direction: column; justify-content: flex-start; overflow: hidden; box-sizing: border-box; padding: 46rpx 56rpx 20rpx; background: radial-gradient(circle at 82% 16%, rgba(255,253,248,.24), rgba(255,253,248,0) 36%), linear-gradient(128deg, #aeba9f 0%, #98aa90 52%, #b9c2af 100%); }
.recommendation-hero:active { opacity: .9; }
.recommendation-kicker { color: #28482e; font-size: 26rpx; font-weight: 600; line-height: 1.4; }
.recommendation-rule { width: 88rpx; height: 4rpx; margin-top: 12rpx; border-radius: 999rpx; background: rgba(255,253,248,.94); }
.recommendation-english { margin-top: 12rpx; color: #fffdf8; font-family: Georgia, "Times New Roman", serif; font-size: 64rpx; font-style: italic; font-weight: 400; line-height: 1.06; word-break: break-word; }
.recommendation-english-compact { font-size:50rpx; line-height:1.08; }
.recommendation-english-small { font-size:38rpx; line-height:1.12; }
.feature-quick-actions { display: flex; gap: 12rpx; margin-top: 6rpx; }
.feature-quick-button { min-width: 104rpx; height: 42rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid rgba(255,253,248,.72); border-radius: 999rpx; color: #fffdf8; background: rgba(39,71,45,.12); font-size: 19rpx; line-height: 40rpx; }
.feature-quick-button::after, .row-remember::after { border: 0; }
.feature-quick-button-saved { color: #28482e; background: rgba(255,253,248,.72); }
.recommendation-list { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; justify-content: flex-start; padding: 20rpx 56rpx 24rpx; background: #fffdf8; }
.recommendation-row { flex: 0 0 120rpx; display: flex; align-items: center; min-width: 0; padding: 18rpx 0; border-bottom: 1rpx solid #dce5da; box-sizing: border-box; }
.recommendation-copy, .discover-copy { flex: 1; min-width: 0; }
.recommendation-row-en { color: #29482e; font-size: 26rpx; font-weight: 600; line-height: 1.35; word-break: break-word; }
.recommendation-row-zh { margin-top: 4rpx; color: #49604c; font-size: 22rpx; line-height: 1.45; word-break: break-word; }
.row-remember { flex: 0 0 auto; min-width: 98rpx; height: 50rpx; margin: 0 0 0 16rpx; padding: 0 14rpx; border: 0; border-radius: 999rpx; color: #496b45; background: #e8f1e4; font-size: 20rpx; line-height: 50rpx; }
.row-remember-saved { color: #fffdf8; background: #5f8558; }
.chevron { flex: 0 0 18rpx; width: 18rpx; height: 18rpx; margin-left: 20rpx; border-top: 3rpx solid #496b45; border-right: 3rpx solid #496b45; transform: rotate(45deg); box-sizing: border-box; }
.home-add-action { align-self: center; display: flex; align-items: center; justify-content: center; min-height: 68rpx; height: 68rpx; margin: 22rpx 0 0; padding: 0 42rpx; border: 1rpx solid #c9d8c7; border-radius: 999rpx; color: #315737; font-size: 25rpx; font-weight: 500; line-height: 1.3; box-sizing: border-box; }
.home-add-plus { margin-right: 12rpx; font-size: 34rpx; font-weight: 300; }
.home-action-pressed { background: #e8f1e4; }
.discover-section { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; margin: 0; padding: 32rpx 56rpx 22rpx; background: #fffdf8; box-sizing: border-box; }
.discover-heading { flex: 0 0 auto; display: inline-block; margin-bottom: 8rpx; color: #315737; font-size: 32rpx; font-weight: 600; line-height: 1.35; }
.discover-row { position: relative; flex: 1 1 0; display: flex; align-items: center; min-height: 116rpx; box-sizing: border-box; }
.discover-row:not(:last-child)::after { content: ''; position: absolute; right: 0; bottom: 0; left: 98rpx; height: 1rpx; background: #dce5da; }
.discover-icon { position: relative; flex: 0 0 54rpx; width: 54rpx; height: 54rpx; margin-right: 34rpx; margin-left: 10rpx; color: #5f8558; box-sizing: border-box; }
.discover-icon-cup { flex-basis: 42rpx; width: 42rpx; height: 38rpx; margin-right: 46rpx; border: 3rpx solid #5f8558; border-top-width: 2rpx; border-radius: 3rpx 3rpx 12rpx 12rpx; }
.discover-icon-cup::after { content: ''; position: absolute; top: 7rpx; right: -17rpx; width: 16rpx; height: 20rpx; border: 3rpx solid #5f8558; border-left: 0; border-radius: 0 10rpx 10rpx 0; }
.discover-icon-book::before, .discover-icon-book::after { content: ''; position: absolute; top: 4rpx; width: 25rpx; height: 44rpx; border: 3rpx solid #5f8558; box-sizing: border-box; }
.discover-icon-book::before { left: 2rpx; border-right-width: 1rpx; border-radius: 12rpx 2rpx 2rpx 4rpx; transform: skewY(8deg); }
.discover-icon-book::after { right: 2rpx; border-left-width: 1rpx; border-radius: 2rpx 12rpx 4rpx 2rpx; transform: skewY(-8deg); }
.discover-icon-words { display: flex; flex-basis: 46rpx; align-items: center; justify-content: center; width: 46rpx; height: 52rpx; margin-right: 42rpx; border: 3rpx solid #5f8558; border-radius: 6rpx; font-size: 18rpx; font-weight: 700; }
.discover-title { color: #315737; font-size: 26rpx; font-weight: 600; line-height: 1.35; }
.discover-subtitle { margin-top: 5rpx; color: #49604c; font-size: 22rpx; line-height: 1.4; }
@media (max-height: 700px) {
  .home-header { flex-basis: 78rpx; padding-top: 6rpx; padding-bottom: 6rpx; }
  .recommendation-card { flex-basis: 680rpx; }
  .recommendation-hero { flex-basis: 315rpx; padding-top: 42rpx; padding-bottom: 18rpx; }
  .recommendation-english { margin-top: 10rpx; font-size: 58rpx; }
  .recommendation-english-compact { font-size:46rpx; }
  .recommendation-english-small { font-size:36rpx; }
  .feature-quick-actions { margin-top: 5rpx; }
  .recommendation-list { padding-top: 16rpx; padding-bottom: 20rpx; }
  .recommendation-row { flex-basis: 112rpx; }
  .home-add-action { min-height: 64rpx; height: 64rpx; margin-top: 18rpx; }
  .discover-section { padding-top: 26rpx; padding-bottom: 18rpx; }
  .discover-row { min-height: 108rpx; }
}
@media (max-width: 350px) {
  .home-header { padding-right: 28rpx; padding-left: 28rpx; }
  .recommendation-hero, .recommendation-list, .discover-section { padding-right: 44rpx; padding-left: 44rpx; }
  .recommendation-english { font-size: 50rpx; }
  .recommendation-english-compact { font-size:42rpx; }
  .recommendation-english-small { font-size:34rpx; }
}

/* Keep the home composition inside the viewport above the native tab bar. */
.home-page {
  height: 100vh;
  min-height: 0;
  padding-bottom: 0;
  box-sizing: border-box;
}
.home-header { flex: 0 0 78rpx; }
.recommendation-card {
  flex: 0 0 680rpx;
  height: 680rpx;
  min-height: 0;
}
.recommendation-list { min-height: 0; }
.discover-section {
  flex: 1 1 0;
  min-height: 0;
  overflow: hidden;
}
.discover-row { min-height: 0; }
