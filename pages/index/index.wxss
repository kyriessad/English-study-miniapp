page {
  background-color: #e7f1ea;
}

.home-ambient {
  position: fixed;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.home-ambient-image {
  display: block;
  width: 100%;
  height: 100%;
}

.home-page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding-bottom: calc(48rpx + var(--custom-tab-bar-space));
  box-sizing: border-box;
  color: #153729;
  background: transparent;
  font-family: "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.home-content {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  overflow-x: hidden;
  padding: 22rpx 34rpx 72rpx;
}

.home-masthead {
  position: relative;
  padding: 10rpx 14rpx 40rpx;
}

.home-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 52rpx;
  box-sizing: border-box;
  color: #52695d;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 7rpx;
}

.home-date {
  flex: 0 0 auto;
  letter-spacing: 4rpx;
}

.home-greeting {
  margin-top: 30rpx;
  color: #123a2b;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 70rpx;
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: 0;
}

.home-tagline {
  margin-top: 14rpx;
  color: #61736a;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 3rpx;
}

.home-status {
  min-height: 300rpx;
  margin: 0 0 32rpx;
  border: 1rpx solid rgba(255, 255, 255, .78);
  border-radius: 44rpx;
  background: transparent;
  box-shadow: 0 12rpx 32rpx rgba(57, 91, 68, .05);
}

.liquid-panel {
  border: 2rpx solid rgba(255, 255, 255, .78);
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-shadow: 0 12rpx 32rpx rgba(53, 86, 64, .05);
}

.liquid-pressable {
  position: relative;
  overflow: hidden;
  transition: transform .3s cubic-bezier(.2, .72, .2, 1), opacity .3s ease, box-shadow .3s ease, border-color .3s ease, background-color .3s ease;
}

.liquid-pressed {
  transform: scale(.976);
}

.liquid-panel.liquid-pressed,
.recommendation-hero.liquid-pressed,
.home-primary-action.liquid-pressed {
  background: rgba(255, 255, 255, .16);
  border-color: rgba(255, 255, 255, .94);
  box-shadow: 0 8rpx 24rpx rgba(48, 83, 61, .08);
}

.hero-card-pressed {
  opacity: .96;
}

.discover-row.liquid-pressed {
  background: rgba(255, 255, 255, .14);
}

button.liquid-pressable::after,
.hero-sound::after,
.hero-remember::after,
.daily-remember::after,
.home-primary-action::after,
.home-secondary-action::after {
  border: 0;
}

button.liquid-panel,
button.home-primary-action {
  background-color: transparent;
}

.recommendation-hero {
  position: relative;
  min-height: 500rpx;
  padding: 42rpx 42rpx 34rpx;
  border-radius: 50rpx;
  border-color: rgba(255, 255, 255, .86);
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-shadow: 0 14rpx 36rpx rgba(48, 83, 61, .05);
  box-sizing: border-box;
}

.recommendation-hero > view,
.recommendation-hero > button {
  position: relative;
  z-index: 2;
}

.recommendation-heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recommendation-kicker {
  display: flex;
  align-items: center;
  color: #6a8075;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 6rpx;
}

.recommendation-kicker::after {
  content: '';
  width: 72rpx;
  height: 1rpx;
  margin-left: 18rpx;
  background: rgba(52, 83, 66, .32);
}

.hero-sound {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, .86);
  border-radius: 50%;
  background: rgba(255, 255, 255, .42);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .9);
}

.sound-icon-image {
  position: relative;
  z-index: 1;
  width: 34rpx;
  height: 34rpx;
}

.recommendation-english {
  max-width: 610rpx;
  margin-top: 62rpx;
  color: #123b2b;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 58rpx;
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: 0;
  word-break: break-word;
}

.recommendation-english-compact {
  font-size: 49rpx;
  line-height: 1.12;
}

.recommendation-english-small {
  font-size: 39rpx;
  line-height: 1.16;
}

.recommendation-zh {
  max-width: 580rpx;
  margin-top: 28rpx;
  color: #4f675b;
  font-size: 26rpx;
  line-height: 1.55;
  letter-spacing: 1rpx;
  word-break: break-word;
}

.hero-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 38rpx;
}

.hero-footer-space {
  flex: 1;
}

.hero-motto {
  color: #7a8d83;
  font-size: 17rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
}

.hero-motto text,
.section-note text {
  display: block;
}

.hero-remember {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 174rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 1rpx solid rgba(255, 255, 255, .9);
  border-radius: 999rpx;
  color: #234b39;
  background: rgba(255, 255, 255, .5);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .96), 0 10rpx 26rpx rgba(54, 88, 66, .08);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 72rpx;
}

.hero-remember-saved {
  color: #f8fffa;
  background: rgba(50, 104, 76, .84);
}

.bookmark-icon-image {
  width: 31rpx;
  height: 31rpx;
  margin-left: 16rpx;
}

.today-section {
  margin-top: 48rpx;
}

.section-heading-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 12rpx 20rpx;
}

.section-heading {
  color: #173c2d;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1.15;
}

.section-note {
  color: #829188;
  font-size: 15rpx;
  line-height: 1.55;
  letter-spacing: 3rpx;
  text-align: left;
}

.daily-row {
  display: flex;
  align-items: center;
  min-height: 142rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 26rpx 22rpx 22rpx;
  border-radius: 36rpx;
  box-sizing: border-box;
}

.daily-row > view,
.daily-row > button {
  position: relative;
  z-index: 1;
}

.daily-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 94rpx;
  width: 94rpx;
  height: 94rpx;
  margin-right: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, .78);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .22);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .94);
}

.daily-icon-image {
  width: 54rpx;
  height: 54rpx;
}

.daily-copy,
.discover-copy {
  flex: 1;
  min-width: 0;
}

.daily-en {
  display: -webkit-box;
  overflow: hidden;
  color: #173a2b;
  font-family: Georgia, "Times New Roman", "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.25;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.daily-zh {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  color: #667a6f;
  font-size: 23rpx;
  line-height: 1.4;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.daily-remember {
  flex: 0 0 auto;
  min-width: 82rpx;
  height: 52rpx;
  margin: 0 2rpx 0 14rpx;
  padding: 0 12rpx;
  border: 0;
  border-radius: 999rpx;
  color: #486b59;
  background: rgba(255, 255, 255, .18);
  font-size: 19rpx;
  line-height: 52rpx;
}

.daily-remember-saved {
  color: #fff;
  background: rgba(55, 108, 80, .78);
}

.chevron,
.action-arrow {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #315846;
  border-right: 3rpx solid #315846;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.chevron {
  margin-left: 14rpx;
}

.home-actions {
  margin-top: 28rpx;
}

.home-primary-action,
.home-secondary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  box-sizing: border-box;
  color: #173e2e;
  font-size: 27rpx;
  font-weight: 500;
}

.home-primary-action {
  height: 96rpx;
  border-radius: 999rpx;
}

.home-primary-action .action-arrow {
  margin-left: 22rpx;
}

.home-secondary-action {
  height: 78rpx;
  margin-top: 14rpx;
  border: 0;
  background: transparent;
  font-size: 24rpx;
}

.home-add-plus {
  margin-right: 10rpx;
  font-size: 34rpx;
  font-weight: 300;
}

.discover-section {
  margin-top: 34rpx;
}

.discover-caption {
  padding: 0 12rpx 18rpx;
  color: #6b8074;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 4rpx;
}

.discover-panel {
  overflow: hidden;
  padding: 0 28rpx;
  border-radius: 40rpx;
}

.discover-row {
  display: flex;
  align-items: center;
  min-height: 130rpx;
  box-sizing: border-box;
}

.discover-row:not(:last-child) {
  border-bottom: 1rpx solid rgba(70, 101, 82, .14);
}

.discover-row > view {
  position: relative;
  z-index: 1;
}

.discover-icon-image {
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
  margin: 0 28rpx 0 5rpx;
  box-sizing: border-box;
}

.discover-title {
  color: #244a38;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.discover-subtitle {
  margin-top: 5rpx;
  color: #728379;
  font-size: 21rpx;
  line-height: 1.4;
}

@media (max-width: 350px) {
  .home-content {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .home-greeting {
    font-size: 61rpx;
  }

  .recommendation-hero {
    padding-right: 34rpx;
    padding-left: 34rpx;
  }

  .recommendation-english {
    font-size: 50rpx;
  }

  .recommendation-english-compact {
    font-size: 43rpx;
  }

  .recommendation-english-small {
    font-size: 35rpx;
  }

  .daily-icon-wrap {
    flex-basis: 80rpx;
    width: 80rpx;
    height: 80rpx;
    margin-right: 18rpx;
  }

  .daily-remember {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .liquid-pressable,
  .liquid-pressed,
  .recommendation-hero.liquid-pressed {
    transition: none;
    transform: none;
  }
}
