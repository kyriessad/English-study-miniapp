  background: #fff8f6;
  text-align: center;
  font-size: 24rpx;
  color: #b47a6e;
  line-height: 1.5;
}

/* ===== Phase 4B: 卡片库轻提示 ===== */

.library-tip {
  margin-bottom: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(242, 249, 242, 0.8);
  border: 1rpx solid #dcebd8;
  font-size: 23rpx;
  color: #7f8d82;
  line-height: 1.5;
}

/* ===== 4C-1a: New-only study entry card in 未学习 tab ===== */
.new-study-card {
  margin-bottom: 16rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #ccebd8;
  box-shadow: 0 10rpx 26rpx rgba(86, 126, 82, 0.08);
  box-sizing: border-box;
}

.new-study-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.new-study-card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2f5f3a;
  line-height: 1.3;
}

.new-study-card-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #66af6a;
  opacity: 0.4;
}

.new-study-card-subtitle {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #7f8d82;
  line-height: 1.5;
  margin-bottom: 18rpx;
}

.new-study-card-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.new-study-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #78bd73 0%, #5eaa64 100%);
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(86, 126, 82, 0.16);
  text-align: center;
}

.new-study-btn::after {
  border: none;
}

.new-study-btn-disabled {
  background: #e8ede9 !important;
  color: #9aa89d !important;
  border: 1rpx solid #dce8dc !important;
  box-shadow: none !important;
}

.new-study-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  font-weight: 700;
  color: #5eaa64;
  line-height: 1;
  margin-right: 4rpx;
}

/* ===== Phase 5-8B: Action Queue Sync Status Bar ===== */

.sync-status-bar {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #e1e8df;
  box-shadow: 0 4rpx 12rpx rgba(86, 126, 82, 0.04);
}

.sync-status-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.sync-dropped-row {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #eef3e9;
}

.sync-status-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

.syncing-text {
  color: #6f7f91;
}

.pending-text {
  color: #b47a25;
}

.dropped-text {
  color: #bd6b74;
}

.sync-dropped-row {
  cursor: pointer;
}

/* ===== Phase 6C: Home page polish ===== */

/* Subtitle — lighter than old .subtitle */
.subtitle-home {
  font-size: 26rpx;
  color: #8a9a8e;
  line-height: 1.65;
  margin-top: 4rpx;
}

/* Status overview card — compact two-stat card */
.status-overview-card {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #dcebd8;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(86, 126, 82, 0.06);
  box-sizing: border-box;
  position: relative;
  z-index: 1;
  transition: background 0.15s;
}

.status-overview-card--hover {
  background: rgba(245, 250, 243, 0.95);
}

.status-overview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.status-overview-num {
  font-size: 46rpx;
  font-weight: 800;
  color: #2f5f3a;
  line-height: 1.15;
}

.status-overview-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a9a8e;
}

.status-overview-divider {
  width: 1rpx;
  height: 56rpx;
  background: #e2ede2;
  flex-shrink: 0;
}

.status-overview-arrow {
  font-size: 40rpx;
  font-weight: 700;
  color: #5eaa64;
  margin-left: 16rpx;
  flex-shrink: 0;
  line-height: 1;
  display: flex;
  align-items: center;
}

/* Main actions — 添加卡片 25% + 进入复习页 75% */
.main-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}

.main-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.main-btn::after {
  border: none;
}

.add-main-btn {
  flex: 1;
  color: #3f7449;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #dcebd8;
  box-shadow: 0 10rpx 24rpx rgba(86, 126, 82, 0.07);
}

.review-main-btn {
  flex: 3;
  color: #ffffff;
  background: linear-gradient(135deg, #78bd73 0%, #5eaa64 100%);
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(86, 126, 82, 0.18);
}

.review-main-btn[disabled] {
  background: #e8ede9 !important;
  color: #9aa89d !important;
  border: 1rpx solid #dce8dc !important;
  box-shadow: none !important;
}

/* Weak sync bar — very light, non-intrusive */
.weak-sync-bar {
  margin-top: 22rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(242, 247, 242, 0.8);
  border: 1rpx solid #e8f0e8;
  position: relative;
  z-index: 1;
}

.weak-sync-text {
  font-size: 23rpx;
  font-weight: 500;
  color: #8a9a8e;
  line-height: 1.5;
}

/* ===== 0-Card Quick Start ===== */
.quick-start-section {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.quick-start-guide {
  font-size: 30rpx;
  color: #2f5f3a;
  line-height: 1.65;
  text-align: center;
  padding: 0 16rpx;
  margin-bottom: 28rpx;
  font-weight: 600;
}

.first-card-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #78bd73 0%, #5eaa64 100%);
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(86, 126, 82, 0.18);
  margin-bottom: 32rpx;
}

.first-card-btn::after {
  border: none;
}

/* Preset card */
.preset-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #e7eee4;
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 8rpx 22rpx rgba(86, 126, 82, 0.06);
  box-sizing: border-box;
  transition: background 0.15s ease;
}

.preset-card:active {
  background: #f7faf5;
}

.preset-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.preset-card-type {
  font-size: 23rpx;
  font-weight: 700;
  color: #5eaa64;
  padding: 6rpx 14rpx;
  background: #f0faf4;
  border-radius: 999rpx;
  line-height: 1.4;
}

.preset-card-plus {
  font-size: 34rpx;
  font-weight: 700;
  color: #5eaa64;
  line-height: 1;
}

.preset-card-content {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.4;
  word-break: break-word;
}

.preset-card-meaning {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #657465;
  line-height: 1.5;
}

.preset-card-disabled {
  opacity: 0.5;
  pointer-events: none;
}
