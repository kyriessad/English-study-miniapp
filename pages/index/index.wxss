.page {
  min-height: 100vh;
  background: #f6f7fb;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.25;
}

.subtitle {
  font-size: 27rpx;
  color: #6b7280;
  line-height: 1.7;
}

.top-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.primary-btn,
.secondary-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.primary-btn {
  color: #ffffff;
  background: #22c55e;
  border: 1rpx solid #16a34a;
  box-shadow: 0 8rpx 20rpx rgba(34, 197, 94, 0.16);
}

.secondary-btn {
  color: #475569;
  background: #ffffff;
  border: 1rpx solid #d8dee8;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.primary-btn::after,
.secondary-btn::after,
.manage-btn::after,
.mini-btn::after,
.danger-mini-btn::after {
  border: none;
}

.context-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  padding-bottom: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #e9edf3;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.mode-card {
  background: #f8fbff;
  border-color: #dbe7f4;
}

.context-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.context-main {
  gap: 6rpx;
}

.context-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #243041;
}

.context-subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6b7280;
  line-height: 1.6;
  font-weight: 500;
}



.filter-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #e9edf3;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.filter-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.filter-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #5b6675;
}

.filter-picker-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 14rpx;
  align-items: center;
}

.filter-picker {
  width: 100%;
}

.picker-field {
  min-height: 84rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid #e6eaf0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #243041;
  box-sizing: border-box;
}

.filter-count {
  font-size: 30rpx;
  font-weight: 600;
  color: #7b8694;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  min-height: 84rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid #e6eaf0;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #243041;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.03);
}

.search-clear {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #64748b;
}

.manage-toolbar {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #e9edf3;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.manage-toolbar-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.manage-toolbar-actions {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.manage-btn {
  margin: 0;
  padding: 0 22rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #526172;
  background: #f8fafc;
  border: 1rpx solid #d9e1e8;
}

.danger-btn {
  color: #b4534b;
  border-color: #f0d4ce;
  background: #fff6f4;
}

.list-section {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.empty-state {
  padding: 56rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.7;
  color: #97a1af;
  border: 1rpx solid #e9edf3;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.card-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #e9edf3;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.card-item-selected {
  border-color: #c8d7e6;
  background: #f8fbff;
  box-shadow: 0 10rpx 28rpx rgba(100, 116, 139, 0.08);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
}

.card-tag {
  padding: 8rpx 16rpx;
  background: #f2f5f8;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6b7280;
  line-height: 1.35;
}

.card-state {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  background: #eef4fb;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #5f7894;
  line-height: 1.35;
}

.card-title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.35;
  word-break: break-word;
}

.card-desc {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  background: #f8fafc;
  border: 1rpx solid #edf1f5;
  border-radius: 16rpx;
  font-size: 27rpx;
  color: #59687a;
  line-height: 1.7;
  word-break: break-word;
}

.card-meta {
  margin-top: 16rpx;
  padding-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  border-top: 1rpx solid #eef2f6;
}

.card-meta-text {
  font-size: 24rpx;
  color: #9aa5b4;
  line-height: 1.5;
}

.card-actions {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
}

.mini-btn {
  margin: 0;
  width: 100%;
  padding: 0;
  min-height: 70rpx;
  line-height: 70rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #526172;
  border: 1rpx solid #d9e1e8;
  background: #ffffff;
}

.mini-btn-primary {
  color: #ffffff;
  border-color: #64748b;
  background: #7c93ad;
  box-shadow: 0 8rpx 18rpx rgba(124, 147, 173, 0.18);
}

.danger-mini-btn {
  color: #ffffff;
  border-color: #dc2626;
  background: #ef4444;
  box-shadow: 0 8rpx 18rpx rgba(239, 68, 68, 0.16);
}

.batch-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.35);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
  z-index: 999;
}

.batch-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.batch-panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
  margin-bottom: 12rpx;
}

.batch-option,
.batch-cancel {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #111827;
  border-top: 1rpx solid #eaecf0;
}

.batch-cancel {
  margin-top: 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  background: #f8fafc;
  border-top: none;
}

@media (max-width: 520px) {
  .top-actions {
    grid-template-columns: 1fr 1fr;
  }
}

.quick-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-filter-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #dbe3ec;
  font-size: 25rpx;
  color: #5b6675;
  line-height: 1.4;
  font-weight: 600;
}

.quick-filter-pill-active {
  background: #eef6ff;
  border-color: #bfd5ee;
  color: #3d5f82;
}

.list-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.list-counts {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}

.view-switch {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #64748b;
  padding: 10rpx 18rpx;
  background: #ffffff;
  border: 1rpx solid #dbe3ec;
  border-radius: 999rpx;
}

.card-item-compact {
  padding: 20rpx 22rpx;
}

.card-item-compact .card-title {
  margin-top: 14rpx;
  font-size: 32rpx;
  line-height: 1.45;
}

.card-item-compact .card-meta {
  margin-top: 12rpx;
}

.result-control-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.result-control-section {
  display: flex;
  flex-direction: column;
