/* 今日复习内容页：顶部状态药丸 */
.today-control-section {
  gap: 0;
}

.today-quick-filter-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 0;
}

.today-filter-pill {
  min-width: 0;
  padding: 14rpx 0;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: #ffffff;
}

.today-filter-all {
  color: #2f9461;
  border-color: #cfe9dc;
}

.today-filter-again {
  color: #ff5a68;
  border-color: #ffd2d8;
  background: #fffafa;
}

.today-filter-hard {
  color: #f59e0b;
  border-color: #ffe2b8;
  background: #fffdf8;
}

.today-filter-good {
  color: #2f9461;
  border-color: #cfe9dc;
  background: #fbfffd;
}

.today-filter-all.today-filter-active {
  color: #ffffff;
  background: #42b879;
  border-color: #42b879;
}

.today-filter-again.today-filter-active {
  color: #ffffff;
  background: #ff5a68;
  border-color: #ff5a68;
}

.today-filter-hard.today-filter-active {
  color: #ffffff;
  background: #f59e0b;
  border-color: #f59e0b;
}

.today-filter-good.today-filter-active {
  color: #ffffff;
  background: #42b879;
  border-color: #42b879;
}

.quick-filter-count {
  margin-left: 6rpx;
}

/* 搜索框 + 筛选：合并成一个完整搜索区域 */
.search-row {
  width: 100%;
}

.search-box {
  width: 100%;
  min-height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  background: #ffffff;
  border: 1rpx solid #e1e8ed;
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.03);
}

.search-icon {
  flex-shrink: 0;
  margin-right: 12rpx;
  font-size: 34rpx;
  color: #9aa5b1;
  line-height: 1;
}

.search-box .search-input {
  flex: 1;
  min-height: 84rpx;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
  font-size: 27rpx;
  color: #243041;
}

.search-clear {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #9aa5b1;
}

.search-divider {
  flex-shrink: 0;
  width: 1rpx;
  height: 34rpx;
  margin: 0 18rpx;
  background: #dfe7ec;
}

.search-filter-action {
  flex-shrink: 0;
  font-size: 27rpx;
  font-weight: 700;
  color: #2f9461;
  line-height: 1;
}

/* 今日复习内容页：用左边框替代独立圆形图标 */
.card-item.review-accent-again {
  border-left: 8rpx solid #ff5a68;
  padding-left: 18rpx;
}

.card-item.review-accent-hard {
  border-left: 8rpx solid #f59e0b;
  padding-left: 18rpx;
}

.card-item.review-accent-good {
  border-left: 8rpx solid #42b879;
  padding-left: 18rpx;
}

/* 卡片右上角状态标签颜色统一 */
.card-status-pill {
  border: 1rpx solid transparent;
}

.card-status-pill.status-again {
  color: #ff4d5e;
  background: #fff2f4;
  border-color: #ffb8c1;
}

.card-status-pill.status-hard {
  color: #f59e0b;
  background: #fff8ec;
  border-color: #ffd99a;
}

.card-status-pill.status-good {
  color: #2f9461;
  background: #eefaf3;
  border-color: #aee2c4;
}

.card-status-pill.status-unknown {
  color: #7b8794;
  background: #f3f6f9;
  border-color: #e5eaf0;
}

/* 今日复习内容页不再显示旧的右侧筛选按钮 */
.more-filter-btn {
  display: none;
}

/* 今日复习内容页顶部卡片：替换旧 context-card 蓝灰感 */
.today-reviewed-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f3fbf6 0%, #ffffff 100%);
  border: 1rpx solid #d7efdf;
  box-shadow: 0 10rpx 28rpx rgba(47, 148, 97, 0.08);
  box-sizing: border-box;
}

.today-reviewed-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #42b879;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(66, 184, 121, 0.22);
  flex-shrink: 0;
}

.today-reviewed-main {
  flex: 1;
  min-width: 0;
}

.today-reviewed-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #235f3d;
  line-height: 1.3;
}

.today-reviewed-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #7b8b82;
  line-height: 1.4;
}

/* 记住了：也加绿色左侧状态线 */
.card-item.review-accent-good {
  border-left: 8rpx solid #42b879;
