}

/* 首页右侧快速滚动条 */
.home-fast-scroll {
  position: fixed;
  right: 10rpx;

  /* 往下放，避开“进入复习页”和“筛选” */
  top: 620rpx;
  bottom: 150rpx;

  width: 36rpx;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-fast-scroll-track {
  position: relative;
  width: 8rpx;
  height: 100%;
  border-radius: 999rpx;
  background: rgba(116, 130, 116, 0.14);
}

.home-fast-scroll-thumb {
  position: absolute;
  left: 50%;
  width: 28rpx;
  height: 58rpx;
  border-radius: 999rpx;
  transform: translate(-50%, -50%);
  background: rgba(94, 170, 100, 0.82);
  box-shadow: 0 8rpx 22rpx rgba(86, 126, 82, 0.22);
}

/* ===== 首页下滑后的悬浮搜索框：和普通搜索框保持同款 ===== */
.search-row-fixed {
  position: fixed;

  /* 关键：覆盖 .search-row 的 width: 100%，否则会横向溢出 */
  width: auto;

  left: 24rpx;
  right: 24rpx;
  top: 0rpx;
  z-index: 120;

  height: 84rpx;
  padding: 0;
  box-sizing: border-box;
  background: transparent;
}

.search-row-spacer {
  height: 100rpx;
}

/* 固定态搜索框本体：做成图二那种完整搜索条 */
.search-row-fixed .search-box {
  width: 100%;
  max-width: 100%;
  height: 84rpx;
  min-height: 84rpx;

  display: flex;
  align-items: center;

  padding: 0 22rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
  overflow: hidden;

  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #e1e8df;
  box-shadow: 0 8rpx 22rpx rgba(86, 126, 82, 0.08);
}

/* 固定态搜索图标 */
.search-row-fixed .search-icon {
  flex-shrink: 0;
  width: 28rpx;
  margin-right: 12rpx;

  font-size: 28rpx;
  color: #9aa89d;
  line-height: 1;
}

/* 固定态输入框：必须允许被压缩，否则会把“筛选”挤出去 */
.search-row-fixed .search-box .search-input {
  flex: 1;
  width: 0;
  min-width: 0;

  height: 84rpx;
  min-height: 84rpx;

  padding: 0;
  font-size: 24rpx;
  color: #263128;
  background: transparent;
}

/* 固定态分割线 */
.search-row-fixed .search-divider {
  flex-shrink: 0;
  width: 1rpx;
  height: 34rpx;
  margin: 0 16rpx;

  background: #dfe8dc;
}

/* 固定态右侧筛选：给足宽度，避免被切掉 */
.search-row-fixed .search-filter-action {
  flex-shrink: 0;
  width: 76rpx;

  font-size: 25rpx;
  font-weight: 800;
  color: #5eaa64;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}

/* 普通态也限制宽度，防止内部撑出屏幕 */
.search-box {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.search-input {
  min-width: 0;
}

/* 搜索框固定后，筛选面板紧跟搜索框，不产生突兀空隙 */
.filter-card,
.home-filter-card,
.today-filter-card {
  position: relative;
  z-index: 70;
}

/* ===== 上滑时浮出的“↑ 顶部”按钮 ===== */
.back-to-top-btn {
  position: fixed;
  right: 32rpx;
  top: 202rpx;
  z-index: 130;

  height: 54rpx;
  line-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;

  font-size: 23rpx;
  font-weight: 800;
  color: #3f7449;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #dcebd8;
  box-shadow: 0 10rpx 26rpx rgba(86, 126, 82, 0.16);
}

/* ===== 批量管理模式：工具栏固定在页面上方 ===== */
.manage-toolbar-fixed {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 0rpx;
  z-index: 130;

  margin-top: 0;
  padding: 20rpx 22rpx;
  box-sizing: border-box;

  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #dce9d8;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(86, 126, 82, 0.12);
}

.manage-toolbar-fixed .manage-toolbar-title {
  font-size: 28rpx;
  line-height: 1.35;
  color: #2f5f3a;
}

.manage-toolbar-fixed .manage-toolbar-actions {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.manage-toolbar-fixed .manage-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
}

.manage-toolbar-spacer {
  height: 252rpx;
}

/* ===== 首页/列表卡片：长内容截断 ===== */

/* 英文内容：最多 2 行 */
.card-title,
.home-card-item .card-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-word;
}

/* 我的理解：最多 1 行 */
.card-desc,
.home-card-item .card-desc {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-word;
}

/* 补充备注：最多 1 行 */
.card-note-preview {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: #fbfaf6;
  border: 1rpx solid #f0eadb;
  color: #8a7a55;
  font-size: 23rpx;
  line-height: 1.5;

  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-word;
}

.analysis-status-pill {
  flex-shrink: 0;
