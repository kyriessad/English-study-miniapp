@import "../discover/index.wxss";

.listening-play {
  padding-right: 28rpx;
  padding-left: 28rpx;
  box-sizing: border-box;
}
.listening-ready {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-bottom: 0;
}
.play-head { flex: 0 0 auto; }
.play-spacer { flex: 1 1 auto; min-height: 0; }
.transcript-scroll {
  flex: 1 1 auto;
  height: 0;
  min-height: 0;
}
.play-hero { padding: 8rpx 8rpx 28rpx; }
.play-kicker { color: #5f7a68; font-size: 22rpx; }
.play-title { margin-top: 10rpx; color: #17391f; font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.play-summary { margin-top: 14rpx; color: #315543; font-size: 26rpx; line-height: 1.6; }
.play-tags { margin-top: 16rpx; }
.listening-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.listening-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, .76);
  background: rgba(255, 255, 255, .28);
  color: #5f7a68;
  font-size: 20rpx;
  line-height: 1.3;
}
.player-dock {
  position: relative !important;
  z-index: 40;
  flex: 0 0 auto;
  box-sizing: border-box;
  margin: 0 -28rpx;
  padding: 12rpx 28rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, .82);
  background: #e7f1ea;
  box-shadow: 0 -10rpx 28rpx rgba(47, 79, 58, .08);
}
.player-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.play-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  min-width: 112rpx;
  height: 56rpx;
  margin: 0 !important;
  padding: 0;
  line-height: 56rpx;
  border-radius: 999rpx;
  color: #f8fffa;
  font-size: 24rpx;
  background: rgba(55, 105, 78, .88);
}
.play-toggle::after { border: 0; }
.play-main {
  flex: 1;
  min-width: 0;
}
.play-slider {
  display: block;
  width: 100%;
  height: 24px;
  margin: 0;
}
.play-time {
  display: flex;
  justify-content: space-between;
  margin-top: 2rpx;
  color: #5f7a68;
  font-size: 20rpx;
  line-height: 1.2;
}
.transcript-toggle {
  width: 100%;
  height: 72rpx;
  margin: 0 0 8rpx;
  padding: 0;
  line-height: 72rpx;
  border-radius: 999rpx;
  color: #214936;
  background: rgba(255, 255, 255, .32);
}
.transcript-toggle::after { border: 0; }
.transcript { padding: 12rpx 0 70vh; }
page .liquid-theme-page.listening-play .sentence {
  margin-bottom: 14rpx;
  padding: 22rpx 22rpx 18rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, .42);
  background: rgba(255, 255, 255, .28);
  transition: background-color .32s ease, border-color .32s ease;
}
.sentence.is-idle {
  opacity: .5;
}
.sentence.is-active {
  opacity: 1;
  border-color: rgba(255, 255, 255, .86);
  background: rgba(255, 255, 255, .46);
}
.sentence-top { display: flex; align-items: center; min-height: 48rpx; }
.sentence-speaker { color: #5f7a68; font-size: 22rpx; }
.sentence-now {
  display: none;
  align-items: center;
  gap: 6rpx;
  margin-left: 12rpx;
  color: #47765d;
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: .04em;
  white-space: nowrap;
  pointer-events: none;
}
.sentence-now.is-on { display: flex; }
.sentence-now-icon {
  width: 28rpx;
  height: 28rpx;
}
.sentence-add {
  margin-left: auto;
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  padding: 0;
  line-height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .42);
}
.sentence-add::after { border: 0; }
.sentence-add-icon { width: 28rpx; height: 28rpx; }
.sentence-en { margin-top: 8rpx; color: #17391f; font-size: 30rpx; line-height: 1.5; }
.sentence-zh { margin-top: 8rpx; color: #315543; font-size: 26rpx; line-height: 1.55; }
.sentence-zh-hint { margin-top: 8rpx; color: #8a968b; font-size: 22rpx; }

.sentence.is-idle { opacity: 1; }
.sentence.is-active { border-left: 4rpx solid #47765d; background: rgba(249,252,250,.88); }
.sentence-zh-hint { color: #526a5b; }
