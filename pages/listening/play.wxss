@import "../discover/index.wxss";

.listening-play { padding-bottom: 80rpx; }
.play-hero { padding: 8rpx 8rpx 28rpx; }
.play-kicker { color: #5f7a68; font-size: 22rpx; }
.play-title { margin-top: 10rpx; color: #17391f; font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.play-summary { margin-top: 14rpx; color: #315543; font-size: 26rpx; line-height: 1.6; }
.player-card {
  padding: 28rpx 24rpx 22rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, .82);
  background: rgba(255, 255, 255, .34);
}
.play-toggle {
  width: 160rpx;
  height: 72rpx;
  margin: 0 auto 18rpx;
  padding: 0;
  line-height: 72rpx;
  border-radius: 999rpx;
  color: #214936;
  font-size: 28rpx;
  background: rgba(255, 255, 255, .42);
}
.play-toggle::after { border: 0; }
.play-time { display: flex; justify-content: space-between; color: #5f7a68; font-size: 22rpx; }
.transcript-toggle {
  width: 100%;
  height: 72rpx;
  margin: 24rpx 0 8rpx;
  padding: 0;
  line-height: 72rpx;
  border-radius: 999rpx;
  color: #214936;
  background: rgba(255, 255, 255, .32);
}
.transcript-toggle::after { border: 0; }
.transcript { margin-top: 12rpx; }
.sentence {
  margin-bottom: 14rpx;
  padding: 22rpx 22rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .28);
}
.sentence.is-active { background: rgba(255, 255, 255, .5); }
.sentence-top { display: flex; align-items: center; min-height: 48rpx; }
.sentence-speaker { color: #5f7a68; font-size: 22rpx; }
.sentence-add {
  margin-left: auto;
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  padding: 0;
  line-height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .42);
}
.sentence-add::after { border: 0; }
.sentence-add-icon { width: 28rpx; height: 28rpx; }
.sentence-en { margin-top: 8rpx; color: #17391f; font-size: 30rpx; line-height: 1.5; }
.sentence-zh { margin-top: 8rpx; color: #315543; font-size: 26rpx; line-height: 1.55; }
.sentence-zh-hint { margin-top: 8rpx; color: #8a968b; font-size: 22rpx; }
