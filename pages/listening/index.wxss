@import "../discover/index.wxss";

.listening-page { padding-bottom: 80rpx; }
.listening-list { margin-top: 8rpx; }
.listening-card {
  margin-bottom: 18rpx;
  padding: 28rpx 26rpx 26rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, .82);
  background: rgba(255, 255, 255, .34);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .72), 0 12rpx 30rpx rgba(49, 84, 62, .05);
}
.listening-card-meta {
  display: flex;
  gap: 16rpx;
  color: #5f7a68;
  font-size: 22rpx;
}
.listening-card-title {
  margin-top: 12rpx;
  color: #17391f;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.35;
}
.listening-card-summary {
  margin-top: 10rpx;
  color: #315543;
  font-size: 26rpx;
  line-height: 1.55;
}
.listening-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.listening-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, .76);
  background: rgba(255, 255, 255, .28);
  color: #5f7a68;
  font-size: 20rpx;
  line-height: 1.3;
}
