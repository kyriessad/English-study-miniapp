<view class="today-page liquid-theme-page" style="padding-top: {{safeTop}}px;">
  <image class="theme-ambient-image" src="/assets/home/home-ambient-v6.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="today-hero" style="padding-right: {{menuRightInset}}px;">
    <view class="today-back" bindtap="goBack">‹</view>
    <view class="today-hero__title">今天看过</view>
    <view class="today-hero__history-link" bindtap="onHistoryLinkTap">历史记录 ›</view>
  </view>

  <view wx:if="{{loading}}" class="today-loading">加载中...</view>

  <view wx:elif="{{empty && loadFailed}}" class="today-empty">
    <view class="today-empty__icon">○</view>
    <view class="today-empty__text">网络不可用，请检查当前网络</view>
    <view class="today-empty__retry" bindtap="onRetryTap">重试</view>
  </view>

  <view wx:elif="{{empty}}" class="today-empty">
    <view class="today-empty__icon">○</view>
    <view class="today-empty__text">今天还没看过卡片</view>
  </view>

  <view wx:else class="today-list">
    <!-- Result Filter Pills -->
    <view class="today-filter-row">
      <view
        wx:for="{{resultFilterOptions}}"
        wx:key="key"
        class="today-filter-pill {{resultFilter === item.key ? 'today-filter-pill--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onResultFilterTap"
      >
        <text>{{item.label}}</text>
        <text class="today-filter-pill__count">{{item.count}}</text>
      </view>
    </view>

    <!-- Empty state for filtered results -->
    <view wx:if="{{filteredItems.length === 0}}" class="today-filter-empty">
      今天还没有这类复习内容
    </view>

    <view
      wx:for="{{filteredItems}}"
      wx:key="cardId"
      class="today-card"
      data-id="{{item.cardId}}"
      bindtap="onCardTap"
    >
      <view class="today-card__top-row">
        <view class="today-card__tag today-card__tag--type">{{item.cardType}}</view>
        <view class="today-card__tag today-card__tag--result today-card__tag--result-{{item.lastResult || 'default'}}">{{item.lastResultLabel}}</view>
      </view>
      <view class="today-card__content">{{item.content}}</view>
      <view class="today-card__understanding" wx:if="{{item.understanding}}">{{item.understanding}}</view>

      <view class="today-card__meta">
        <view wx:if="{{item.whereEncountered}}" class="today-card__source-pill">来自：{{item.whereEncountered}}</view>
      </view>
    </view>
  </view>
</view>
