.today-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfcf7 0%, #f4f8ee 52%, #f8faf4 100%);
  padding-bottom: 40rpx;
}

.today-hero {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx 20rpx;
}

.today-hero__icon {
  font-size: 36rpx;
  color: #66af6a;
  margin-right: 16rpx;
}

.today-hero__title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2f5f3a;
  flex: 1;
}

.today-hero__sub {
  font-size: 26rpx;
  color: #7f8d82;
}

.today-offline-banner {
  margin: 16rpx 28rpx 0;
  padding: 16rpx 24rpx;
  background: rgba(242, 247, 242, 0.8);
  border: 1rpx solid #e8f0e8;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #8a9a8e;
}

.today-loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8a9a8e;
}

.today-empty {
  padding: 120rpx 0;
  text-align: center;
}

.today-empty__icon {
  font-size: 72rpx;
  color: #9aa89d;
  margin-bottom: 24rpx;
}

.today-empty__text {
  font-size: 28rpx;
  color: #8a9a8e;
  margin-bottom: 24rpx;
}

.today-empty__retry {
  display: inline-block;
  padding: 12rpx 48rpx;
  background: linear-gradient(135deg, #78bd73 0%, #5eaa64 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(86, 126, 82, 0.16);
}

.today-list {
  padding: 20rpx 28rpx;
}

.today-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 26rpx rgba(86, 126, 82, 0.07);
}

.today-card__top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.today-card__content {
  font-size: 32rpx;
  font-weight: 700;
  color: #263128;
  margin-bottom: 8rpx;
}

.today-card__understanding {
  font-size: 28rpx;
  color: #657465;
  margin-bottom: 8rpx;
}

.today-card__source {
  font-size: 24rpx;
  color: #9ba8a0;
  margin-bottom: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.today-card__meta {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.today-card__tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.today-card__tag--count {
  background: #f5f8fb;
  color: #5f768d;
}

.today-card__tag--result {
  background: #f0faf4;
  color: #3f8b61;
}

.today-card__tag--type {
  background: #f3f7f5;
  color: #7b8981;
}
