.today-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfcf7 0%, #f4f8ee 52%, #f8faf4 100%);
  padding-bottom: 40rpx;
}

.today-hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 70rpx 28rpx 20rpx;
}

.today-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .82);
  border-radius: 18rpx;
  color: #214936;
  background: rgba(255, 255, 255, .34);
  font-size: 44rpx;
  line-height: 1;
}

.today-hero__icon {
  font-size: 36rpx;
  color: #66af6a;
  margin-right: 16rpx;
}

.today-hero__title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2f5f3a;
  flex: 1;
}

.today-hero__history-link {
  margin: 0;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #47765d;
  font-weight: 400;
}

.today-offline-banner {
  margin: 16rpx 28rpx 0;
  padding: 16rpx 24rpx;
  background: rgba(242, 247, 242, 0.8);
  border: 1rpx solid #e8f0e8;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #8a9a8e;
}

.today-loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8a9a8e;
}

.today-empty {
  padding: 120rpx 0;
  text-align: center;
}

.today-empty__icon {
  font-size: 72rpx;
  color: #9aa89d;
  margin-bottom: 24rpx;
}

.today-empty__text {
  font-size: 28rpx;
  color: #8a9a8e;
  margin-bottom: 24rpx;
}

.today-empty__retry {
  display: inline-block;
  padding: 12rpx 48rpx;
  background: linear-gradient(135deg, #78bd73 0%, #5eaa64 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(86, 126, 82, 0.16);
}

.today-list {
  padding: 20rpx 28rpx;
}

.today-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 26rpx rgba(86, 126, 82, 0.07);
}

.today-card__top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.today-card__content {
  font-size: 32rpx;
  font-weight: 700;
  color: #263128;
  margin-bottom: 8rpx;
}

.today-card__understanding {
  font-size: 28rpx;
  color: #657465;
  margin-bottom: 8rpx;
}

.today-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.today-card__source-pill {
  flex-shrink: 1;
  min-width: 0;
  max-width: 280rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef8ef;
  color: #5f9f79;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.today-card__tag {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.today-card__tag--count {
  background: #f5f8fb;
  color: #5f768d;
}

.today-card__tag--result {
  background: #f3f6f8;
  color: #5f768d;
}

/* 反馈结果颜色与"看一看"页四个反馈按钮语义对齐 */
/* forgot / 想不起来 */
.today-card__tag--result-forgot {
  background: rgba(240, 98, 98, 0.10);
  color: #d95555;
}

/* shaky / 不太稳 */
.today-card__tag--result-shaky {
  background: rgba(246, 162, 58, 0.13);
  color: #c98422;
}

/* got_it / 基本掌握 */
.today-card__tag--result-got_it {
  background: rgba(53, 183, 121, 0.12);
  color: #2f9d69;
}

/* fluent / 很熟了 */
.today-card__tag--result-fluent {
  background: rgba(79, 120, 168, 0.10);
  color: #4f78a8;
}

.today-card__tag--type {
  background: #f3f7f5;
  color: #7b8981;
}

/* ===== Result Filter Pills ===== */

.today-filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.today-filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid #dfe9dc;
  font-size: 24rpx;
  font-weight: 700;
  color: #657465;
}

.today-filter-pill--active {
  color: #3f7449;
  background: #f0faf4;
  border-color: #ccebd8;
}

.today-filter-pill__count {
  font-size: 22rpx;
  font-weight: 800;
  color: #5e8f6e;
  opacity: 1;
}

.today-filter-pill--active .today-filter-pill__count {
  color: #3f7449;
}

.today-filter-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: #8a9a8e;
}

/* Liquid theme final layer */
.today-page { min-height:100vh; padding-bottom:calc(72rpx + env(safe-area-inset-bottom)); overflow-x:hidden; overflow-y:auto; background:transparent; box-sizing:border-box; }
.today-hero { padding:34rpx 28rpx 20rpx; }
.today-hero__icon { display:flex; align-items:center; justify-content:center; width:56rpx; height:56rpx; margin-right:16rpx; border:1rpx solid rgba(255,255,255,.8); border-radius:50%; background:rgba(255,255,255,.32); }
.today-hero__icon-image { width:32rpx; height:32rpx; opacity:.72; }
.today-hero__title { color:#153729; font-family:"PingFang SC", "Microsoft YaHei", sans-serif; font-size:40rpx; font-weight:400; }
.today-hero__history-link { color:#47765d; }
.today-loading { color:#687c71; }
.today-empty { padding:110rpx 24rpx; }
.today-empty__icon { color:#87978e; font-size:60rpx; }
.today-empty__text { color:#687c71; font-size:26rpx; }
.today-empty__retry { padding:12rpx 44rpx; border-radius:999rpx; color:#fff; background:rgba(55,105,78,.84); box-shadow:inset 0 2rpx 0 rgba(255,255,255,.24), 0 12rpx 24rpx rgba(48,83,61,.12); }
.today-list { padding:18rpx 28rpx; }
.today-filter-row { gap:10rpx; margin-bottom:20rpx; }
.today-filter-pill { padding:11rpx 18rpx; color:#687c71; background:rgba(255,255,255,.28); border-color:rgba(255,255,255,.76); }
.today-filter-pill--active { color:#fff; background:rgba(69,111,86,.8); border-color:rgba(255,255,255,.62); }
.today-filter-pill__count { color:inherit; }
.today-filter-empty { color:#87978e; }
.today-card { padding:24rpx 26rpx; margin-bottom:16rpx; border-radius:34rpx; border-color:rgba(255,255,255,.82); background:rgba(255,255,255,.34); box-shadow:inset 0 2rpx 0 rgba(255,255,255,.72), 0 12rpx 30rpx rgba(49,84,62,.05); -webkit-backdrop-filter:none; backdrop-filter:none; }
.today-card__content { color:#153729; font-family:Baskerville, "Palatino Linotype", Georgia, serif; font-size:30rpx; font-weight:400; }
.today-card__understanding { color:#315543; }
.today-card__source-pill { color:#47765d; background:rgba(228,242,231,.58); }
.today-card__tag--type { color:#47765d; background:rgba(228,242,231,.52); }
.today-card__tag--result-forgot { color:#9d5f58; background:rgba(255,235,232,.68); }
.today-card__tag--result-shaky { color:#9b773b; background:rgba(251,241,217,.7); }
.today-card__tag--result-got_it { color:#47765d; background:rgba(228,242,231,.7); }
.today-card__tag--result-fluent { color:#55718e; background:rgba(231,239,248,.7); }
