<view class="page {{(!currentCard && !allDone) || pageState === 'completed' ? 'page-empty' : ''}}">
  <view class="header">
    <view class="title">
      <block wx:if="{{allDone || pageState === 'completed'}}">这轮复习完成</block>
      <block wx:else>今日复习</block>
    </view>
    <view wx:if="{{!allDone && pageState !== 'completed' && currentCard}}" class="subtitle">先想一想，再看理解。</view>
  </view>

  <!-- ===== Progress Bar ===== -->
  <view wx:if="{{currentCard && !allDone && totalCount > 0}}" class="review-progress-section">
    <view class="review-progress-text">今日进度 {{displayCurrentNo}} / {{displayTotal}}</view>
    <view class="review-progress-bar">
      <view class="review-progress-fill" style="width: {{totalCount > 0 ? finishedCount / totalCount * 100 : 0}}%;"></view>
    </view>
  </view>

  <!-- ===== LOADING ===== -->
  <view wx:if="{{pageState === 'loading' || isLoading}}" class="empty-state">
    正在加载复习内容...
  </view>

  <!-- ===== ERROR ===== -->
  <view wx:elif="{{pageState === 'error' || reviewError}}" class="done-panel">
    <view class="done-title done-title--plain">复习任务加载失败</view>
    <view class="done-text">{{reviewError}}</view>
    <view class="done-actions">
      <button class="done-action-btn done-primary-btn" bindtap="retryLoadReview">
        重新加载
      </button>
    </view>
  </view>

  <!-- ===== NO CARDS ===== -->
  <view wx:elif="{{!allDone && !currentCard && !isLoading}}" class="empty-state">
    <view class="empty-title">目前没有需要复习的内容。</view>
    <view class="empty-subtitle">等到下一批内容到期，或者回首页继续添加新卡片。</view>
    <view class="empty-actions">
      <button class="empty-primary-btn" bindtap="goToAddPage">添加卡片</button>
    </view>
  </view>

  <!-- ===== ACTIVE CARD (normal + offline_playing + submitting) ===== -->
  <block wx:elif="{{currentCard && !allDone}}">
    <view class="task-card {{answerVisible ? 'task-card-open' : 'task-card-closed'}}">
      <view class="task-meta-row">
        <view class="task-category">
          {{currentCard.category || '单词'}}
        </view>

        <view class="task-progress">
          {{displayCurrentNo}} / {{displayTotal}}
        </view>
      </view>

      <view class="task-main {{currentCard.category === '句子' ? 'task-main-sentence' : ''}}">
        <scroll-view
          wx:if="{{currentCard.category === '句子'}}"
          scroll-y
          class="task-english-scroll"
        >
          <view class="task-english task-english-sentence">
            {{currentCard.englishText}}
          </view>
        </scroll-view>

        <view wx:else class="task-english">
          {{currentCard.englishText}}
        </view>
      </view>

      <view class="task-answer-slot">
        <block wx:if="{{answerVisible}}">
          <scroll-view scroll-y class="task-answer-scroll">
            <view class="task-answer-panel">
              <view class="task-answer-top">
                <view class="task-answer-title">我的理解</view>

                <text
                  wx:if="{{currentCard.myUnderstanding}}"
                  class="review-edit-btn"
                  bindtap="editCurrentCard"
                >
                  ✓ 编辑
                </text>
              </view>

              <scroll-view
                wx:if="{{currentCard.myUnderstanding}}"
                scroll-y
                class="task-answer task-answer-limited"
              >
                <view>
                  {{currentCard.myUnderstanding}}
                </view>
              </scroll-view>

              <view wx:else class="task-answer-placeholder" bindtap="editCurrentCard">
                还没有写下你的理解，可以现在补充
              </view>

              <view wx:if="{{currentCard.notes}}" class="task-notes">
                <view class="task-notes-divider"></view>
                <view class="task-label">补充备注</view>
                <scroll-view scroll-y class="task-notes-text task-notes-limited">
                  <view>
                    {{currentCard.notes}}
                  </view>
                </scroll-view>
              </view>
            </view>
          </scroll-view>
        </block>
      </view>
    </view>

    <view class="task-actions answer-toggle-actions">
      <button
        wx:if="{{!answerVisible}}"
        class="action-btn reveal-btn"
        bindtap="revealAnswer"
      >
        查看理解
      </button>

      <view
        wx:else
        class="review-collapse-text"
        bindtap="hideAnswer"
      >
        ︿ 收起理解
      </view>
    </view>

    <view wx:if="{{answerVisible}}" class="feedback-title">这次回忆得怎么样？</view>

    <view wx:if="{{answerVisible}}" class="task-actions feedback-actions">
      <button class="action-btn action-again" bindtap="submitReview" data-result="forgot" disabled="{{submittingFeedback}}">
        <text class="action-icon">×</text>
        <text>想不起来</text>
      </button>

      <button class="action-btn action-hard" bindtap="submitReview" data-result="shaky" disabled="{{submittingFeedback}}">
        <text class="action-icon">?</text>
        <text>不太稳</text>
      </button>

      <button class="action-btn action-good" bindtap="submitReview" data-result="got_it" disabled="{{submittingFeedback}}">
        <text class="action-icon">✓</text>
        <text>基本掌握</text>
      </button>

      <button class="action-btn action-easy" bindtap="submitReview" data-result="fluent" disabled="{{submittingFeedback}}">
        <text class="action-icon">★</text>
        <text>很熟了</text>
      </button>
    </view>

  </block>

  <!-- ===== COMPLETED ===== -->
  <view wx:elif="{{allDone || pageState === 'completed'}}" class="done-panel">
    <view class="done-title done-title--plain">复习已完成</view>
    <view class="done-text">今日复习情况已更新，可以前往查看。</view>
    <view class="done-actions">
      <button
        class="done-action-btn done-primary-btn"
        bindtap="navigateToTodayReviewStatus"
      >
        查看今日复习情况
      </button>
      <button
        class="done-action-btn done-secondary-btn"
        bindtap="goToHomePage"
      >
        返回首页
      </button>
    </view>
  </view>
</view>
