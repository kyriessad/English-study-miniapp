<view wx:if="{{loading}}" class="page review-page core-status liquid-theme-page" style="padding-top: {{safeTop}}px;"><image class="theme-ambient-image" src="/assets/home/home-ambient-v6.jpg" mode="aspectFill" aria-hidden="true"></image><text>正在准备本轮复习…</text></view>
<view wx:elif="{{error}}" class="page review-page core-status core-status-error liquid-theme-page" style="padding-top: {{safeTop}}px;"><image class="theme-ambient-image" src="/assets/home/home-ambient-v6.jpg" mode="aspectFill" aria-hidden="true"></image><view>{{error}}</view><button class="text-link" bindtap="retryLoad">重新加载</button></view>
<view class="page review-page liquid-theme-page" style="padding-top: {{safeTop}}px;" wx:elif="{{current}}">
  <image class="theme-ambient-image" src="/assets/home/home-ambient-v6.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="review-top">
    <button class="close-button" bindtap="exit">×</button>
    <view class="review-progress">{{currentNo}} / {{total}}</view>
  </view>
  <view class="review-progress-track"><view class="review-progress-fill" style="width:{{total > 0 ? currentNo / total * 100 : 0}}%"></view></view>
  <view class="review-focus">
    <view class="review-en">{{current.en}}</view>
    <view wx:if="{{current.where}}" class="review-context"><text class="review-context-label">在哪里遇到</text><text>{{current.where}}</text></view>
    <view wx:if="{{current.context}}" class="review-source-context">{{current.context}}</view>
    <view class="review-lexical-row">
      <view wx:if="{{phoneticDisplay || current.phonetic}}" class="review-phonetic">{{phoneticDisplay || current.phonetic}}</view>
      <view wx:elif="{{lexicalInfoLoading}}" class="review-phonetic review-phonetic-muted">音标加载中…</view>
      <button class="review-pronunciation {{pronunciationPlaying ? 'review-pronunciation-playing' : ''}}" bindtap="onPronunciationTap" disabled="{{pronunciationLoading || !pronunciationAvailable}}">{{pronunciationLoading ? '加载中' : (pronunciationPlaying ? '播放中' : '发音')}}</button>
    </view>
    <view class="review-divider"></view>
    <view class="review-label">选择最合适的中文理解</view>
  </view>
  <view class="options">
    <button wx:for="{{current.options}}" wx:key="optionId" class="option {{answered && selectedOptionId === item.optionId ? (isCorrect ? 'option-correct' : 'option-wrong') : ''}}" data-option-id="{{item.optionId}}" bindtap="choose" disabled="{{submitting || answered}}">
      <text wx:if="{{answered && selectedOptionId === item.optionId && !isCorrect}}" class="option-status option-cross">×</text>
      <text class="option-text">{{item.text}}</text>
      <text wx:if="{{answered && selectedOptionId === item.optionId && isCorrect}}" class="option-status option-check">✓</text>
      <text wx:if="{{!answered || selectedOptionId !== item.optionId}}" class="option-arrow">›</text>
    </button>
  </view>
  <button class="unknown-button {{answered && selectedOptionId === 'unknown' && !isCorrect ? 'unknown-button-wrong' : ''}}" bindtap="unknown" disabled="{{submitting || answered}}">—　不知道　—</button>
  <view wx:if="{{showExample}}" class="review-example">
    <view class="review-example-label">例句</view>
    <block wx:if="{{current.example}}">
      <view class="review-example-en">{{current.example}}</view>
      <view wx:if="{{current.exampleZh}}" class="review-example-zh">{{current.exampleZh}}</view>
    </block>
  </view>
  <view wx:if="{{awaitingNext}}" class="review-auto-next">回答正确，正在进入下一题…</view>
</view>
