@import "../../styles/core.wxss";

.review-home-page { height:100vh; min-height:0; padding:0; padding-bottom:0; overflow:hidden; }
.review-ambient {
  position: fixed;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.review-ambient-image {
  display: block;
  width: 100%;
  height: 100%;
}

.review-home-hero { position:relative; isolation:isolate; flex:0 0 auto; min-height:0; padding:58rpx 56rpx 30rpx; box-sizing:border-box; overflow:hidden; }
.review-home-hero > .page-title,
.review-home-hero > .review-today,
.review-home-hero > .review-lead { position:relative; z-index:2; }
.review-home-hero .page-title { font-size:58rpx; }
.review-today { margin-top:12rpx; font-size:27rpx; color:#607564; }
.review-lead { margin-top: 48rpx; }
.review-quote { margin-top:0; padding-top:0; }
.review-quote-line { color:#607564; font-family:Georgia,"Times New Roman",serif; font-size:42rpx; font-style:italic; line-height:1.3; }
.review-caption { margin-top:18rpx; color:#607564; font-size:27rpx; }
.review-home-card { display:block; flex:0 0 712rpx; min-height:0; margin:0; padding:60rpx 58rpx 28rpx; border-radius:22rpx 22rpx 0 0; background:#fffdf9; box-sizing:border-box; }
.review-home-card .section-title { font-size:31rpx; }
.review-home-card .page-subtitle { margin-top:12rpx; font-size:25rpx; }
.size-row { gap:22rpx; margin-top:49rpx; }
.size-option { display:flex; align-items:center; justify-content:center; height:120rpx; min-height:0; padding:0; border-radius:18rpx; box-sizing:border-box; }
.size-number { font-family:Georgia,"Times New Roman",serif; font-size:48rpx; }
.review-start { width:87%; height:120rpx; line-height:120rpx; margin:66rpx auto 0; }
.review-tip { margin-top:36rpx; color:#607564; font-size:23rpx; text-align:center; }

/* Liquid theme final layer */
.review-home-page {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  height: auto;
  padding: 0 28rpx calc(140rpx + var(--custom-tab-bar-space));
  overflow-x: hidden;
  overflow-y: auto;
  box-sizing: border-box;
  background: transparent;
}

.review-home-page > .tab-enter {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  min-height: 0;
}

.review-home-hero {
  flex: 0 0 auto;
  min-height: 0;
  padding: 70rpx 8rpx 40rpx;
  box-sizing: border-box;
}

.review-home-hero .page-title {
  color: #153729;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 66rpx;
  font-weight: 400;
}

.review-today,
.review-caption {
  color: #687c71;
  font-size: 26rpx;
}

.review-lead {
  margin-top: 52rpx;
}

.review-quote {
  margin-top: 0;
}

.review-quote-line {
  color: #5d7666;
  font-family: Baskerville, "Palatino Linotype", Georgia, serif;
  font-size: 44rpx;
  line-height: 1.27;
}

.review-home-card {
  flex: 0 0 auto;
  margin: 0;
  padding: 42rpx 30rpx 34rpx;
  border: 2rpx solid rgba(255, 255, 255, .84);
  border-radius: 46rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, .38), rgba(248, 252, 249, .18) 58%, rgba(230, 246, 239, .26));
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, .9), 0 18rpx 44rpx rgba(49, 84, 62, .08);
  -webkit-backdrop-filter: blur(3px) saturate(1.04);
  backdrop-filter: blur(3px) saturate(1.04);
}

.review-stat {
  color: #153729;
  font-family: Baskerville, "Palatino Linotype", Georgia, serif;
  font-size: 88rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
}

.review-stat-label {
  margin-top: 10rpx;
  color: #687c71;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  text-align: center;
}

.review-card-rule {
  width: 72rpx;
  height: 3rpx;
  margin: 28rpx auto 8rpx;
  border-radius: 999rpx;
  background: rgba(71, 118, 93, .35);
}

.review-resume-note {
  margin-top: 12rpx;
  color: #687c71;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.size-row {
  display: flex;
  gap: 14rpx;
  margin-top: 34rpx;
}

.size-option {
  flex: 1;
  height: 112rpx;
  border-radius: 30rpx;
}

.size-number {
  color: #214936;
  font-family: Baskerville, "Palatino Linotype", Georgia, serif;
  font-size: 48rpx;
  font-weight: 400;
}

.size-option-active .size-number {
  color: #fff;
}

.review-start {
  width: 100%;
  height: 86rpx;
  margin-top: 36rpx;
  line-height: 86rpx;
  font-size: 28rpx;
}

.review-links {
  display: flex;
  justify-content: center;
  gap: 36rpx;
  margin-top: 22rpx;
}

.review-tip {
  margin-top: 22rpx;
  color: #47765d;
  font-size: 23rpx;
  text-align: center;
}

@media (max-width: 350px) {
  .review-home-page { padding-right: 20rpx; padding-left: 20rpx; }
  .review-home-hero { padding-right: 20rpx; padding-left: 20rpx; }
  .review-lead { margin-top: 36rpx; }
  .review-quote-line { font-size: 39rpx; }
}
