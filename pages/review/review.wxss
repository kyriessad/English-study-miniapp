.page {
  min-height: 100vh;
  padding: 28rpx 40rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f6fbf7 0%, #f8fcf8 46%, #f5fbf6 100%);
  color: #214a32;
  display: flex;
  flex-direction: column;
}

.page-empty {
  background:
    radial-gradient(circle at 50% 34%, rgba(198, 246, 209, 0.58) 0%, rgba(229, 248, 235, 0.34) 30%, rgba(255, 255, 255, 0) 58%),
    linear-gradient(180deg, #ffffff 0%, #fbfffc 34%, #f5fbf7 100%);
}

/* 顶部区域 */
.header {
  margin-bottom: 24rpx;
  padding-top: 16rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #255f3d;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.subtitle {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: #7d9183;
  line-height: 1.6;
}


/* ===== 未完成复习进度提示区 ===== */
.resume-panel {
  margin-top: 72rpx;
  padding: 44rpx 36rpx 38rpx;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 22rpx 54rpx rgba(53, 183, 121, 0.12);
  border: 1rpx solid rgba(53, 183, 121, 0.10);
  box-sizing: border-box;
  text-align: center;
}

.resume-title {
  font-size: 42rpx;
  font-weight: 850;
  color: #255f3d;
  line-height: 1.32;
  letter-spacing: 1rpx;
}

.resume-title::after {
  content: "";
  display: inline-block;
  width: 34rpx;
  height: 8rpx;
  margin-left: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8bd8a8 0%, #d8f3df 100%);
  vertical-align: middle;
}

.resume-desc {
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: #f2fbf6;
  color: #2f8f5c;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.45;
}

.resume-subdesc {
  margin-top: 22rpx;
  color: #7f9186;
  font-size: 27rpx;
  line-height: 1.65;
}

.resume-actions {
  margin-top: 42rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.resume-primary-btn,
.resume-secondary-btn {
  width: 100%;
  height: 98rpx;
  line-height: normal;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 800;
  padding: 0;
  margin: 0;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.resume-primary-btn::after,
.resume-secondary-btn::after {
  border: none;
}

.resume-primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #63d99a 0%, #35b779 100%);
  box-shadow: 0 16rpx 34rpx rgba(53, 183, 121, 0.22);
}

.resume-secondary-btn {
  color: #4f9b6d;
  background: #ffffff;
  border: 2rpx solid #bfe4cc;
  box-shadow: 0 12rpx 26rpx rgba(53, 183, 121, 0.08);
}

.resume-primary-btn:active,
.resume-secondary-btn:active {
  transform: scale(0.985);
  opacity: 0.92;
}


/* 复习中：稳定翻牌式卡片 */
.task-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 30rpx 34rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 46rpx rgba(53, 183, 121, 0.10);
  display: flex;
  flex-direction: column;
  margin-top: 34rpx;
  overflow: hidden;
}

/* 未查看理解：白卡变短，英文在卡片视觉中心 */
.task-card-closed {
  height: 430rpx;
}

/* 查看理解后：白卡展开，理解区固定 */
.task-card-open {
  height: 690rpx;
}

/* 顶部眉批：去药丸化 */
.task-meta-row {
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.task-category {
  font-size: 24rpx;
  font-weight: 400;
  color: #5f8f72;
  line-height: 38rpx;
}

.task-progress {
  font-size: 24rpx;
  font-weight: 400;
  color: #a8a8a8;
  line-height: 38rpx;
}

/* 英文区：固定高度，英文水平 + 垂直居中 */
.task-main {
  height: 260rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}

.task-english {
  font-size: 60rpx;
  font-weight: 850;
  color: #1f3d2c;
  text-align: center;
  line-height: 1.28;
  word-break: break-word;
}

/* 答案区：固定高度，始终占位 */
.task-answer-slot {
  flex: 1;
  min-height: 0;
  margin-top: 18rpx;
  box-sizing: border-box;
}

/* 未查看理解时，不保留理解区视觉空间 */
.task-card-closed .task-answer-slot {
  display: none;
}

/* 理解内部滚动，不能撑高卡片 */
.task-answer-scroll {
  height: 100%;
  box-sizing: border-box;
}

.task-answer-panel {
  min-height: 100%;
  padding: 24rpx 26rpx;
  background: rgba(53, 183, 121, 0.055);
  border: 1rpx solid rgba(53, 183, 121, 0.10);
  border-radius: 26rpx;
  box-sizing: border-box;
}

/* 我的理解标题行 */
.task-answer-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.task-answer-title {
  font-size: 26rpx;
  color: #2d4b38;
  font-weight: 700;
  line-height: 1.4;
}

.review-edit-btn {
  font-size: 24rpx;
  color: #35a873;
  font-weight: 600;
  line-height: 1.4;
  flex-shrink: 0;
}

/* 我的理解正文 */
.task-answer {
  font-size: 29rpx;
  color: #26382d;
  line-height: 1.7;
  text-align: left;
  word-break: break-word;
}

/* 空状态：只保留一个虚线入口 */
.task-answer-placeholder {
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(53, 183, 121, 0.28);
  color: #8aa498;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
  background: rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 补充备注：有内容才出现 */
.task-notes {
  margin-top: 22rpx;
}

.task-notes-divider {
  height: 1rpx;
  background: rgba(53, 183, 121, 0.16);
  margin-bottom: 18rpx;
}

.task-label {
  font-size: 25rpx;
  color: #7f9186;
  margin-bottom: 10rpx;
  line-height: 1.4;
  font-weight: 600;
}

.task-notes-text {
  font-size: 27rpx;
  color: #68786e;
  line-height: 1.7;
  word-break: break-word;
}

/* 卡片外操作区 */
.task-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 26rpx;
}

.answer-toggle-actions {
  min-height: 104rpx;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
}

/* 查看理解按钮 */
.reveal-btn {
  width: 86%;
  height: 92rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #63d99a 0%, #35b779 100%);
  box-shadow: 0 16rpx 34rpx rgba(53, 183, 121, 0.20);
}

/* 收起理解：放在卡片外，弱化纯文本 */
.review-collapse-text {
  width: 100%;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: #9ba8a0;
  line-height: 1.4;
}

/* 反馈按钮 */
.feedback-actions {
  gap: 14rpx;
  margin-top: 12rpx;
}

.feedback-title {
  margin-top: 18rpx;
  text-align: center;
  color: #5d7968;
  font-size: 27rpx;
  font-weight: 700;
}

.action-btn {
  flex: 1;
  height: 82rpx;
  line-height: normal;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 800;
  padding: 0;
  border: 1rpx solid transparent;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  text-align: center;
  box-sizing: border-box;
}

.action-btn::after {
  border: none;
}

.action-icon {
  font-size: 24rpx;
  line-height: 1;
  font-weight: 900;
}

/* 想不起来 */
.action-again {
  color: #d95555;
  background: rgba(240, 98, 98, 0.10);
  border-color: rgba(240, 98, 98, 0.17);
}

/* 不太稳 */
.action-hard {
  color: #c98422;
  background: rgba(246, 162, 58, 0.13);
  border-color: rgba(246, 162, 58, 0.20);
}

/* 基本掌握 */
.action-good {
  color: #2f9d69;
  background: rgba(53, 183, 121, 0.12);
  border-color: rgba(53, 183, 121, 0.20);
}

/* 很熟了 */
.action-easy {
  color: #4f78a8;
  background: rgba(79, 120, 168, 0.10);
  border-color: rgba(79, 120, 168, 0.16);
}

.action-btn[disabled] {
  opacity: 0.58;
}

/* 完成页主体卡片 */

/* 完成页主体卡片 */
.done-panel {
  margin-top: 22rpx;
  background: #ffffff;
  border-radius: 42rpx;
  padding: 42rpx 34rpx 34rpx;
  text-align: center;
  color: #65766b;
  box-shadow: 0 22rpx 54rpx rgba(53, 183, 121, 0.12);
  box-sizing: border-box;
}

/* 零卡片空状态 */
.empty-state {
  flex: 1;
  min-height: calc(100vh - 180rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 18rpx 120rpx;
  box-sizing: border-box;
  background: transparent;
  box-shadow: none;
  border-radius: 0;
  margin-top: 0;
  color: #65766b;
}

.empty-illustration {
  position: relative;
  width: 500rpx;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 34rpx;
}

.empty-glow {
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(116, 224, 151, 0.23) 0%, rgba(153, 233, 179, 0.12) 34%, rgba(255, 255, 255, 0) 68%);
  filter: blur(2rpx);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.empty-illustration-img {
  position: relative;
  z-index: 2;
  width: 500rpx;
  height: 500rpx;
  display: block;
  transform: translateX(25rpx);
}

.empty-icon-area {
  position: relative;
  z-index: 2;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: rgba(237, 248, 241, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 28rpx 80rpx rgba(53, 183, 121, 0.12);
}

.empty-icon {
  font-size: 112rpx;
  line-height: 1;
}

.sparkle {
  position: absolute;
  z-index: 3;
  color: #a6e7b9;
  font-weight: 800;
  line-height: 1;
}

.sparkle-tl {
  top: 108rpx;
  left: 42rpx;
  font-size: 30rpx;
  opacity: 0.76;
}

.sparkle-tr {
  top: 74rpx;
  right: 74rpx;
  font-size: 34rpx;
  opacity: 0.84;
}

.sparkle-bl {
  bottom: 82rpx;
  left: 84rpx;
  font-size: 26rpx;
  opacity: 0.58;
}

.empty-title {
  margin-top: 0;
  font-size: 46rpx;
  line-height: 1.28;
  font-weight: 900;
  color: #23603e;
  letter-spacing: 1rpx;
}

.empty-subtitle {
  margin-top: 22rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #90a498;
  font-weight: 500;
}

.empty-actions {
  width: 100%;
  margin-top: 58rpx;
  display: flex;
  justify-content: center;
}

.empty-primary-btn {
  width: 620rpx;
  height: 102rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 999rpx;
  background:
    linear-gradient(135deg, rgba(110, 226, 161, 0.95) 0%, rgba(60, 194, 122, 1) 68%, rgba(48, 181, 111, 1) 100%);
  color: #ffffff;
  font-size: 35rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  line-height: normal;
  box-shadow:
    0 20rpx 42rpx rgba(53, 183, 121, 0.26),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.empty-primary-btn::after {
  border: none;
}

.empty-primary-btn:active {
  transform: scale(0.985);
  opacity: 0.94;
}

.empty-primary-btn:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.done-title {
  position: relative;
  font-size: 42rpx;
  font-weight: 800;
  color: #255f3d;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.done-title::before {
  content: "";
  margin-right: 0;
}

.done-title::after {
  content: "✓";
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: #dff4e7;
  color: #35b779;
  font-size: 22rpx;
  font-weight: 800;
  vertical-align: middle;
}

.done-title--plain::after {
  display: none;
}

.done-text {
  margin-top: 20rpx;
  padding: 20rpx 26rpx;
  border-radius: 26rpx;
  background: #f2fbf6;
  color: #5e9f78;
  font-size: 28rpx;
  line-height: 1.65;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 完成页按钮 */
.done-actions {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.done-action-btn,
.finish-action-btn {
  width: 100%;
  height: 98rpx;
  line-height: normal;
  border-radius: 999rpx;
  font-size: 35rpx;
  font-weight: 700;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(53, 183, 121, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.done-action-btn::after,
.finish-action-btn::after {
  border: none;
}

.done-primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #63d99a 0%, #35b779 100%);
  box-shadow: 0 14rpx 28rpx rgba(53, 183, 121, 0.25);
}

.done-secondary-btn,
.finish-action-btn {
  color: #4f9b6d;
  background: #ffffff;
  border: 2rpx solid #bfe4cc;
}

.done-btn-icon {
  font-size: 40rpx;
  color: inherit;
  line-height: 1;
}

.action-btn:active,
.done-action-btn:active,
.finish-action-btn:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.title::after {
  content: "";
  display: inline-block;
  width: 34rpx;
  height: 8rpx;
  margin-left: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8bd8a8 0%, #d8f3df 100%);
  vertical-align: middle;
}

/* ===== 复习页：长句与长答案内容控制 ===== */

/* 句子英文区：固定 3 行高度，内部滚动 */
.task-english-scroll {
  width: 100%;
  max-height: 178rpx;
  height: 178rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.task-english-sentence {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.42;
  text-align: left;
  color: #1f3d2c;
  word-break: break-word;
}

/* 句子模式下，英文区不要用过度居中的巨大视觉 */
.task-main-sentence {
  align-items: center;
  justify-content: center;
}

/* 我的理解：最多 2 行高度，内部滚动 */
.task-answer-limited {
  height: 100rpx;
  max-height: 100rpx;
  overflow: hidden;
  box-sizing: border-box;
}

/* 补充备注：最多 2 行高度，内部滚动 */
.task-notes-limited {
  height: 92rpx;
  max-height: 92rpx;
  overflow: hidden;
  box-sizing: border-box;
}

/* ===== Phase 3: Offline / Pending Badges ===== */

.offline-badge {
  margin-top: 18rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: #fff8e7;
  border: 1rpx solid #f5e3b8;
  color: #b8860b;
  font-size: 25rpx;
  text-align: center;
  line-height: 1.5;
  font-weight: 600;
}

.pending-badge {
  margin-top: 18rpx;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: #edf5fd;
  border: 1rpx solid #d0e1f5;
  color: #4a7db5;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.4;
  font-weight: 500;
}
