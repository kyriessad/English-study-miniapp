@import "../../styles/core.wxss";
.review-context{display:flex;align-items:center;justify-content:center;gap:12rpx;margin-top:22rpx;text-align:center;color:#738477;font-size:23rpx;line-height:1.5}.review-context-label{padding:4rpx 12rpx;border-radius:999rpx;background:#e9f3e6;color:#5f8063;font-size:20rpx}.review-source-context{display:-webkit-box;max-width:560rpx;margin-top:8rpx;overflow:hidden;color:#93a096;font-size:21rpx;line-height:1.45;text-align:center;-webkit-box-orient:vertical;-webkit-line-clamp:2}.unknown-button{display:block;margin:22rpx auto 0;padding:0;color:#9aa49c;background:transparent;font-size:24rpx}.unknown-button::after{border:0}

.review-page { height:100vh; min-height:0; padding:46rpx 52rpx 36rpx; overflow:hidden; }
.review-top { flex:0 0 62rpx; }
.close-button { width:56rpx; height:56rpx; color:#203b27; font-size:48rpx; }
.review-progress { color:#203b27; font-family:Georgia,"Times New Roman",serif; font-size:27rpx; }
.review-progress-track { flex:0 0 8rpx; height:8rpx; margin-top:16rpx; }
.review-focus { flex:0 0 470rpx; margin-top:12rpx; }
.review-en { font-size:78rpx; line-height:1.08; font-style:italic; font-weight:400; }
.review-lexical-row { display:flex; align-items:center; justify-content:center; gap:18rpx; min-height:58rpx; margin-top:14rpx; }
.review-phonetic { margin-top:0; font-family:Georgia,"Times New Roman",serif; font-size:29rpx; color:#607564; }
.review-phonetic-muted { color:#99a69b; font-family:inherit; font-size:22rpx; }
.review-pronunciation { width:108rpx; height:54rpx; line-height:54rpx; padding:0; margin:0; border:1rpx solid #cbdcc8; border-radius:999rpx; background:#f3f8f0; color:#527a57; font-size:22rpx; }
.review-pronunciation::after { border:0; }
.review-pronunciation[disabled] { background:#f3f5f2; color:#a5aea6; }
.review-pronunciation-playing { border-color:#789372; background:#789372; color:#fff; }
.review-divider { width:74rpx; height:3rpx; margin-top:36rpx; background:#bdcdb9; }
.review-label { margin-top:34rpx; font-size:25rpx; color:#607564; }
.options { gap:12rpx; margin-top:0; }
.option { min-height:90rpx; padding:18rpx 34rpx; border-radius:16rpx; }
.option-text { font-size:29rpx; }
.option-arrow { color:#496f4e; font-size:44rpx; }
.unknown-button { margin-top:auto; font-size:25rpx; color:#8b9a8c; }
.unknown-button-wrong { color:#c4544e; background:rgba(255,241,239,.92); }
.review-example { margin-top:22rpx; padding:22rpx 26rpx; border:1rpx solid #d5e1d1; border-radius:16rpx; background:rgba(255,255,250,.76); }
.review-example-label { color:#496f4e; font-size:23rpx; font-weight:600; }
.review-example-en { margin-top:10rpx; color:#315737; font-family:Georgia,"Times New Roman",serif; font-size:25rpx; line-height:1.5; }
.review-example-zh { margin-top:7rpx; color:#748177; font-size:23rpx; line-height:1.5; }
.review-example-status { margin-top:10rpx; color:#829084; font-size:23rpx; line-height:1.5; }
.review-example-error { display:flex; align-items:center; justify-content:space-between; gap:16rpx; color:#a16b5f; }
.review-example-retry { flex:0 0 auto; height:50rpx; line-height:50rpx; padding:0 18rpx; margin:0; border:1rpx solid #d6dfd2; border-radius:999rpx; background:#f5f9f3; color:#5b805f; font-size:21rpx; }
.review-example-retry::after { border:0; }
.review-continue { flex:0 0 70rpx; margin-top:18rpx; }
.review-auto-next { display:block; width:100%; min-height:72rpx; margin-top:18rpx; padding:12rpx 20rpx; border:1rpx solid rgba(79,122,93,.28); border-radius:999rpx; background:rgba(239,249,242,.7); color:#315b40; font-size:24rpx; line-height:1.4; text-align:center; }
.review-auto-next::after { border:0; }
.review-legacy { width:100%; margin-top:8rpx; }
.review-legacy-answer { padding:24rpx 28rpx; border:1rpx solid rgba(92,130,103,.2); border-radius:20rpx; background:rgba(246,253,249,.63); color:#254534; font-size:31rpx; line-height:1.55; }
.review-legacy-options { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:24rpx; }
.review-legacy-options button { width:100%; min-height:94rpx; margin:0; padding:16rpx 12rpx; border:1rpx solid rgba(95,136,106,.22); border-radius:18rpx; background:rgba(247,253,249,.73); color:#315b40; font-size:27rpx; line-height:1.4; }
.review-legacy-options button::after { border:0; }

/* Liquid theme final layer */
.review-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  height: auto;
  padding: 34rpx 32rpx calc(54rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  overflow-y: auto;
  box-sizing: border-box;
}

.review-page.core-status {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 120rpx 32rpx;
}

.review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 auto;
  min-height: 58rpx;
}

.close-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  border: 1rpx solid rgba(255, 255, 255, .8);
  border-radius: 50%;
  color: #315d48;
  background: rgba(255, 255, 255, .3);
  font-size: 40rpx;
  line-height: 1;
}

.review-progress {
  color: #60756a;
  font-family: Baskerville, "Palatino Linotype", Georgia, serif;
  font-size: 26rpx;
}

.review-progress-track {
  flex: 0 0 auto;
  height: 8rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  overflow: hidden;
}

.review-focus {
  flex: 0 0 auto;
  margin-top: 48rpx;
  text-align: center;
}

.review-en {
  min-height: 0;
  color: #153729;
  font-family: Baskerville, "Palatino Linotype", Georgia, serif;
  font-size: 64rpx;
  font-style: italic;
  font-weight: 400;
  line-height: 1.14;
  word-break: break-word;
}

.review-context {
  color: #687c71;
}

.review-context-label {
  color: #47765d;
  background: rgba(228, 242, 231, .68);
}

.review-source-context {
  color: #87978e;
}

.review-lexical-row { margin-top: 20rpx; }
.review-phonetic { color: #60756a; font-size: 26rpx; }
.review-pronunciation { color: #47765d; background: rgba(255, 255, 255, .34); }
.review-divider { margin: 38rpx auto 0; background: rgba(71, 118, 93, .38); }
.review-label { margin-top: 26rpx; color: #687c71; font-size: 25rpx; }

.options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 28rpx;
}

.option {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 20rpx 28rpx;
  border-radius: 30rpx;
  color: #315543;
  text-align: left;
}

.option-text { flex: 1; font-size: 28rpx; line-height: 1.45; }
.option-arrow { margin-left: 18rpx; color: #47765d; font-size: 42rpx; }
.option-status { margin-right: 14rpx; font-size: 34rpx; }
.option-correct { background: rgba(221, 241, 226, .72); }
.option-wrong { background: rgba(255, 235, 232, .76); }

.unknown-button {
  flex: 0 0 auto;
  margin: 24rpx auto 0;
  color: #87978e;
  font-size: 24rpx;
}

.unknown-button-wrong { color: #9d5f58; background: rgba(255, 235, 232, .72); }

.review-example {
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  text-align: left;
}

.review-example-label { color: #47765d; font-size: 23rpx; font-weight: 600; }
.review-example-en { color: #315543; font-family: Baskerville, "Palatino Linotype", Georgia, serif; font-size: 26rpx; line-height: 1.55; }
.review-example-zh { color: #687c71; font-size: 23rpx; }
.review-auto-next { color: #60756a; }

.review-page .review-top { box-sizing: border-box; }
page .liquid-theme-page.review-page .options .option { min-height: 108rpx; height: auto; padding: 22rpx 28rpx; line-height: 1.55; display: flex; align-items: center; box-sizing: border-box; }
page .liquid-theme-page.review-page .options .option[disabled] { color: #315543; }
page .liquid-theme-page.review-page .options .option-wrong { color: #853e36; }
page .liquid-theme-page.review-page .review-pronunciation, page .liquid-theme-page.review-page .unknown-button { min-height: 44px; line-height: 44px; }
