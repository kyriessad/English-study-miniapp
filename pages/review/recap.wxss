@import "../../styles/core.wxss";

.recap-page { padding-right:44rpx; padding-left:44rpx; padding-bottom:56rpx; overflow:hidden; text-align:center; }
.recap-top { min-height:62rpx; }
.recap-kicker { font-size:28rpx; color:#203b27; }
.recap-celebration { margin:36rpx auto 12rpx; width:170rpx; height:150rpx; }
.recap-check { width:122rpx; height:122rpx; background:#dcebd9; color:#496f4e; font-size:72rpx; }
.recap-page > .page-title { font-size:48rpx; }
.recap-subtitle { font-size:25rpx; color:#607564; }
.recap-list { margin-top:38rpx; }
.recap-card { min-height:160rpx; padding:26rpx; border-radius:16rpx; }
.recap-status { flex-basis:72rpx; width:72rpx; height:72rpx; line-height:72rpx; font-size:38rpx; }
.recap-body { flex-basis:150rpx; }
.recap-en { font-size:26rpx; }
.recap-number { font-size:50rpx; }
.recap-examples { padding-left:22rpx; }
.recap-actions { margin-top:32rpx; }
.recap-actions .action { width:100%; }
.recap-card { display:block; min-height:0; padding:26rpx 30rpx; }
.recap-card::after { content:'›'; position:absolute; right:28rpx; top:50%; color:#496f4e; font-size:44rpx; transform:translateY(-50%); }
.recap-card { position:relative; padding-right:82rpx; }
.recap-en { color:#203b27; font-family:Georgia,"Times New Roman",serif; font-size:32rpx; font-weight:400; }
.recap-answer { margin-top:10rpx; color:#315737; font-size:26rpx; }
.recap-context { margin-top:8rpx; color:#728374; font-size:22rpx; }

/* Liquid theme final layer */
.recap-page {
  min-height: 100vh;
  padding: 34rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  overflow-y: auto;
  box-sizing: border-box;
  text-align: center;
}

.recap-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
}

.recap-top .close-button { flex: 0 0 auto; }
.recap-kicker { color: #60756a; font-size: 25rpx; }
.recap-celebration { width: 132rpx; height: 132rpx; margin: 48rpx auto 24rpx; }
.recap-check { display:flex; align-items:center; justify-content:center; width:132rpx; height:132rpx; border-radius:50%; font-size:64rpx; }
.recap-page > .page-title { color:#214936; font-family:"PingFang SC", "Microsoft YaHei", sans-serif; font-size:40rpx; font-weight:600; }
.recap-subtitle { color:#687c71; font-size:25rpx; line-height:1.5; }
.recap-list { margin-top:36rpx; text-align:left; }
.recap-card { min-height:0; margin-bottom:14rpx; padding:24rpx 64rpx 24rpx 26rpx; border-radius:32rpx; }
.recap-en { color:#153729; font-family:Baskerville, "Palatino Linotype", Georgia, serif; font-size:30rpx; font-weight:400; }
.recap-answer { color:#315543; font-size:25rpx; }
.recap-context { color:#87978e; font-size:22rpx; }
.recap-actions { margin-top:30rpx; }
.recap-actions .action { width:100%; height:82rpx; line-height:82rpx; }
.recap-actions .text-link { display:block; margin:20rpx auto 0; }
