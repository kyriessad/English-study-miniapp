.about-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfcf7 0%, #f4f8ee 52%, #f8faf4 100%);
  padding: 40rpx 28rpx;
  box-sizing: border-box;
}

.about-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 10rpx 26rpx rgba(86, 126, 82, 0.07);
  box-sizing: border-box;
}

.about-app-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #2f5f3a;
  line-height: 1.3;
}

.about-tagline {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7f8d82;
  line-height: 1.6;
}

.about-divider {
  margin: 28rpx 0;
  height: 1rpx;
  background: #edf3e9;
}

.about-desc {
  font-size: 26rpx;
  color: #657465;
  line-height: 1.7;
}

.about-version {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #9aa398;
}

.about-usage-card,
.about-contact-card {
  margin-top: 24rpx;
}

.about-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a5c40;
  margin-bottom: 20rpx;
}

.about-step {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.about-step:last-child {
  margin-bottom: 0;
}

.step-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #e8f2e8;
  color: #3a7a48;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 36rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 2rpx;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3a5c40;
  line-height: 1.5;
}

.step-desc {
  font-size: 24rpx;
  color: #7f8d82;
  line-height: 1.6;
  margin-top: 2rpx;
}

.about-contact-desc {
  font-size: 26rpx;
  color: #7f8d82;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.about-contact-btn {
  display: block;
  padding: 16rpx 0;
  border: 2rpx solid #4a7a52;
  border-radius: 40rpx;
  color: #4a7a52;
  font-size: 26rpx;
  font-weight: 500;
  background: #fff;
  text-align: center;
}

.about-contact-btn:active {
  background: #f0f8f0;
}
