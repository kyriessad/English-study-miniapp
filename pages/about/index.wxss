.about-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfcf7 0%, #f4f8ee 52%, #f8faf4 100%);
  padding: 40rpx 28rpx;
  box-sizing: border-box;
}

.about-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 10rpx 26rpx rgba(86, 126, 82, 0.07);
  box-sizing: border-box;
}

.about-app-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #2f5f3a;
  line-height: 1.3;
}

.about-tagline {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7f8d82;
  line-height: 1.6;
}

.about-divider {
  margin: 28rpx 0;
  height: 1rpx;
  background: #edf3e9;
}

.about-desc {
  font-size: 26rpx;
  color: #657465;
  line-height: 1.7;
}

.about-version {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #9aa398;
}

.about-usage-card,
.about-contact-card {
  margin-top: 24rpx;
}

.about-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3a5c40;
  margin-bottom: 20rpx;
}

.about-step {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.about-step:last-child {
  margin-bottom: 0;
}

.step-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #e8f2e8;
  color: #3a7a48;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 36rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 2rpx;
}

.step-content {
  flex: 1;
}

.step-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3a5c40;
  line-height: 1.5;
}

.step-desc {
  font-size: 24rpx;
  color: #7f8d82;
  line-height: 1.6;
  margin-top: 2rpx;
}

.about-contact-desc {
  font-size: 26rpx;
  color: #7f8d82;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.about-contact-btn {
  display: block;
  padding: 16rpx 0;
  border: 2rpx solid #4a7a52;
  border-radius: 40rpx;
  color: #4a7a52;
  font-size: 26rpx;
  font-weight: 500;
  background: #fff;
  text-align: center;
}

.about-contact-btn:active {
  background: #f0f8f0;
}

/* Liquid theme final layer */
.about-page { min-height:100vh; padding:0 28rpx calc(80rpx + env(safe-area-inset-bottom)); overflow-x:hidden; overflow-y:auto; background:transparent; box-sizing:border-box; }
.about-heading { display:flex; align-items:center; justify-content:space-between; min-height:72rpx; padding-top:70rpx; margin-bottom:24rpx; }
.about-back, .about-heading-space { width:56rpx; height:56rpx; }
.about-back { display:flex; align-items:center; justify-content:center; border:1rpx solid rgba(255,255,255,.82); border-radius:18rpx; color:#214936; background:rgba(255,255,255,.34); font-size:44rpx; line-height:1; }
.about-heading-title { flex:1; color:#153729; font-size:40rpx; text-align:center; }
.about-card { margin-bottom:18rpx; padding:34rpx 28rpx; border:1rpx solid rgba(255,255,255,.82); border-radius:38rpx; background:rgba(255,255,255,.34); box-shadow:inset 0 2rpx 0 rgba(255,255,255,.72), 0 14rpx 34rpx rgba(49,84,62,.055); -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px); }
.about-app-name { color:#153729; font-family:"PingFang SC", "Microsoft YaHei", sans-serif; font-size:38rpx; font-weight:400; }
.about-tagline { color:#687c71; font-size:24rpx; }
.about-divider { background:rgba(62,94,73,.13); }
.about-desc { color:#315543; font-size:25rpx; line-height:1.72; }
.about-version { color:#87978e; font-size:22rpx; }
.about-section-title { color:#214936; font-size:28rpx; font-weight:600; }
.step-num { display:flex; align-items:center; justify-content:center; width:40rpx; height:40rpx; margin-top:0; border:1rpx solid rgba(255,255,255,.7); border-radius:50%; color:#fff; background:rgba(69,111,86,.8); line-height:1; }
.step-title { color:#315543; font-size:25rpx; }
.step-desc { color:#687c71; font-size:23rpx; }
.about-contact-desc { color:#687c71; font-size:24rpx; }
.about-contact-btn { padding:16rpx 0; border:1rpx solid rgba(255,255,255,.8); color:#fff; background:rgba(55,105,78,.84); }
