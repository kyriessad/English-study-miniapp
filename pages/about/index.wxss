.about-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfcf7 0%, #f4f8ee 52%, #f8faf4 100%);
  padding: 40rpx 28rpx;
  box-sizing: border-box;
}

.about-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 10rpx 26rpx rgba(86, 126, 82, 0.07);
  box-sizing: border-box;
}

.about-app-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #2f5f3a;
  line-height: 1.3;
}

.about-tagline {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7f8d82;
  line-height: 1.6;
}

.about-divider {
  margin: 28rpx 0;
  height: 1rpx;
  background: #edf3e9;
}

.about-desc {
  font-size: 26rpx;
  color: #657465;
  line-height: 1.7;
}

.about-version {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #9aa398;
}
