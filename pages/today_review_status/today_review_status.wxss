.status-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.status-offline-banner {
  margin: 16rpx 28rpx 0;
  padding: 16rpx 24rpx;
  background: #fef3c7;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #b45309;
}

.status-loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #9ca3af;
}

.status-empty {
  padding: 120rpx 0;
  text-align: center;
}

.status-empty__icon {
  font-size: 72rpx;
  color: #d1d5db;
  margin-bottom: 24rpx;
}

.status-empty__text {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 24rpx;
}

.status-empty__retry {
  display: inline-block;
  padding: 12rpx 48rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.status-body {
  padding: 32rpx 28rpx;
}

.status-page-title {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 24rpx;
}

/* hero */
.status-hero {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.status-hero--done {
  margin-bottom: 0;
}

.status-hero__icon {
  font-size: 40rpx;
  color: #3b82f6;
  margin-right: 16rpx;
}

.status-hero__emoji {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.status-hero__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.status-hero__sub {
  font-size: 28rpx;
  color: #6b7280;
  margin-left: 56rpx;
  margin-bottom: 24rpx;
}

/* section */
.status-section {
  margin: 32rpx 0 24rpx;
}

.status-section__heading {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

/* progress */
.status-progress-wrap {
  margin-bottom: 8rpx;
}

.status-progress-bar {
  height: 12rpx;
  background: #e5e7eb;
  border-radius: 6rpx;
  overflow: hidden;
}

.status-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #22c55e, #16a34a);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.status-progress-nums {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

/* stats row */
.status-stats {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0 32rpx;
}

.status-stat {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.status-stat + .status-stat {
  margin-left: 16rpx;
}

.status-stat__value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.status-stat__label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* result grid */
.status-result-grid {
  display: flex;
  justify-content: space-between;
}

.status-result {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.status-result + .status-result {
  margin-left: 16rpx;
}

.status-result__value {
  font-size: 40rpx;
  font-weight: 700;
}

.status-result__value--mastered {
  color: #16a34a;
}

.status-result__value--consolidate {
  color: #d97706;
}

.status-result__label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* main button */
.status-main-btn-wrap {
  margin: 32rpx 0 40rpx;
  padding: 0 28rpx;
}

.status-main-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #2f5f3a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(47, 95, 58, 0.2);
}

.status-main-btn--disabled {
  background: #d1d5db;
  color: #9ca3af;
  box-shadow: none;
}

/* secondary entries */
.status-secondary {
  padding: 0 28rpx;
}

.status-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.status-entry--disabled {
  opacity: 0.45;
}

.status-entry__label {
  font-size: 30rpx;
  color: #1f2937;
}

.status-entry__arrow {
  font-size: 36rpx;
  color: #9ca3af;
}
