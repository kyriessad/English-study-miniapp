.status-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfcf7 0%, #f4f8ee 52%, #f8faf4 100%);
}

.status-offline-banner {
  margin: 16rpx 28rpx 0;
  padding: 16rpx 24rpx;
  background: rgba(242, 247, 242, 0.8);
  border: 1rpx solid #e8f0e8;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #8a9a8e;
}

.status-loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #8a9a8e;
}

.status-empty {
  padding: 120rpx 0;
  text-align: center;
}

.status-empty__icon {
  font-size: 72rpx;
  color: #9aa89d;
  margin-bottom: 24rpx;
}

.status-empty__text {
  font-size: 28rpx;
  color: #8a9a8e;
  margin-bottom: 24rpx;
}

.status-empty__retry {
  display: inline-block;
  padding: 12rpx 48rpx;
  background: linear-gradient(135deg, #78bd73 0%, #5eaa64 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(86, 126, 82, 0.16);
}

.status-body {
  padding: 32rpx 28rpx;
}

.status-page-title {
  font-size: 28rpx;
  color: #7f8d82;
  margin-bottom: 24rpx;
}

/* hero */
.status-hero {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.status-hero--done {
  margin-bottom: 0;
}

.status-hero__icon {
  font-size: 40rpx;
  color: #66af6a;
  margin-right: 16rpx;
}

.status-hero__emoji {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.status-hero__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2f5f3a;
}

.status-hero__sub {
  font-size: 28rpx;
  color: #7f8d82;
  margin-left: 56rpx;
  margin-bottom: 24rpx;
}

/* section */
.status-section {
  margin: 32rpx 0 24rpx;
}

.status-section__heading {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f5f3a;
  margin-bottom: 20rpx;
}

/* progress */
.status-progress-wrap {
  margin-bottom: 8rpx;
}

.status-progress-bar {
  height: 12rpx;
  background: #e7eee4;
  border-radius: 6rpx;
  overflow: hidden;
}

.status-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #78bd73, #5eaa64);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.status-progress-nums {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #263128;
}

/* stats row */
.status-stats {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0 32rpx;
}

.status-stat {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(86, 126, 82, 0.07);
}

.status-stat + .status-stat {
  margin-left: 16rpx;
}

.status-stat__value {
  font-size: 36rpx;
  font-weight: 700;
  color: #2f5f3a;
}

.status-stat__label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a9a8e;
}

/* result grid */
.status-result-grid {
  display: flex;
  justify-content: space-between;
}

.status-result {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 26rpx rgba(86, 126, 82, 0.07);
}

.status-result + .status-result {
  margin-left: 16rpx;
}

.status-result__value {
  font-size: 40rpx;
  font-weight: 700;
}

.status-result__value--mastered {
  color: #3f8b61;
}

.status-result__value--consolidate {
  color: #a7772e;
}

.status-result__label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a9a8e;
}

/* main button */
.status-main-btn-wrap {
  margin: 32rpx 0 40rpx;
  padding: 0 28rpx;
}

.status-main-btn {
  width: 100%;
  height: 86rpx;
  line-height: 86rpx;
  background: linear-gradient(135deg, #78bd73 0%, #5eaa64 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(86, 126, 82, 0.18);
}

.status-main-btn::after {
  border: none;
}

.status-main-btn--disabled {
  background: #e8ede9;
  color: #9aa89d;
  box-shadow: none;
}

/* daily goal hint */
.status-goal {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
  margin-top: 40rpx;
  padding: 16rpx 0;
}

.status-goal__label {
  font-size: 26rpx;
  color: #8a9a8e;
}

.status-goal__arrow {
  font-size: 26rpx;
  color: #9aa89d;
}

/* secondary entries */
.status-secondary {
  padding: 0 28rpx;
}

.status-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  border-radius: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 26rpx rgba(86, 126, 82, 0.07);
}

.status-entry--disabled {
  opacity: 0.45;
}

.status-entry__label {
  font-size: 30rpx;
  font-weight: 600;
  color: #263128;
}

.status-entry__arrow {
  font-size: 36rpx;
  color: #5eaa64;
}
