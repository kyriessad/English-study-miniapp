@import "../../styles/core.wxss";

.book-detail-page {
  height: 100vh;
  min-height: 100vh;
  padding: 30rpx 28rpx calc(90rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  background: transparent;
  box-sizing: border-box;
}
.wordbook-detail-shell { height: 100vh; min-height: 0; overflow: hidden; }
.wordbook-detail-shell .book-detail-page { position: relative; z-index: 1; background: transparent; }
.book-detail-page .subpage-top {
  margin: 0;
  align-items: center;
}

.book-detail-page .subpage-heading {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.book-detail-page .subpage-heading .page-title {
  color: #153729;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1.2;
}


.book-detail-page .back {
  color: #315d48;
  background: rgba(255, 255, 255, .32);
  border-color: rgba(255, 255, 255, .8);
}

.book-hero {
  display: flex;
  align-items: flex-start;
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 38rpx;
  border: 1rpx solid rgba(255, 255, 255, .82);
  background: rgba(255, 255, 255, .34);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .72), 0 12rpx 30rpx rgba(49, 84, 62, .05);
}

.book-cover.large {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 126rpx;
  height: 168rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, rgba(118, 153, 128, .82), rgba(65, 109, 82, .86)) !important;
}

.book-cover-mark {
  color: #fff;
  font-family: Baskerville, "Palatino Linotype", Georgia, serif;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.book-hero-copy {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.progress-title {
  color: #214936;
  font-size: 30rpx;
  line-height: 1.35;
}

.progress-count {
  color: #47765d;
  font-family: Baskerville, "Palatino Linotype", Georgia, serif;
  font-size: 32rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.progress-track {
  flex: 1;
  height: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .52);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #47765d;
}

.progress-percent {
  flex: 0 0 auto;
  color: #87978e;
  font-size: 20rpx;
}

.book-desc {
  margin-top: 14rpx;
  color: #687c71;
  font-size: 22rpx;
  line-height: 1.45;
}

.book-today {
  margin-top: 10rpx;
  color: #315543;
  font-size: 22rpx;
  line-height: 1.45;
}

.new-word-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 8rpx 16rpx 8rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, .78);
  border-radius: 999rpx;
  background: rgba(228, 241, 230, .55);
  color: #315d48;
  font-size: 20rpx;
  line-height: 1.2;
}

.new-word-chip-icon {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #47765d;
  border-radius: 50%;
  box-shadow:
    0 -8rpx 0 -5rpx #47765d,
    0 8rpx 0 -5rpx #47765d,
    -8rpx 0 0 -5rpx #47765d,
    8rpx 0 0 -5rpx #47765d;
}

.book-actions {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 0 8rpx;
}

.study-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  padding: 0 18rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1;
}

.study-cta::after { border: 0; }

.study-cta[disabled] { opacity: .4; }

.study-cta-primary {
  color: #fff;
  background: #47765d;
  border: 1rpx solid rgba(255, 255, 255, .28);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .22), 0 10rpx 22rpx rgba(49, 84, 62, .16);
}

.study-cta-secondary {
  color: #315d48;
  background: rgba(255, 255, 255, .28);
  border: 1rpx solid rgba(255, 255, 255, .82);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .7);
}

.study-cta-play {
  width: 0;
  height: 0;
  margin-right: 12rpx;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 18rpx solid #fffdf8;
}

.study-cta-book {
  width: 22rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border: 3rpx solid #315d48;
  border-radius: 4rpx 8rpx 8rpx 4rpx;
  box-sizing: border-box;
}

.detail-head {
  margin: 34rpx 4rpx 0;
}

.book-detail-page .detail-head .section-title {
  color: #214936;
  font-size: 32rpx;
  font-weight: 600;
}

.book-detail-page .section-link {
  color: #687c71;
  font-size: 24rpx;
}

.word-list-tools {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.meaning-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  flex: 0 0 44px;
  width: 44px;
  min-width: 44px;
  height: 44px;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, .82);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .32);
  color: #315d48;
  font-size: 0;
  line-height: 1;
}

.meaning-toggle::after { border: 0; }

.meaning-toggle-icon {
  width: 27rpx;
  height: 27rpx;
}

.sort-control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  width: 48px;
  height: 44px;
  color: #466a55;
}

.sort-control-bars {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.sort-control-bar {
  width: 18rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.sort-control-bar-medium { width: 14rpx; }
.sort-control-bar-short { width: 10rpx; }
.sort-control-chevron { font-size: 22rpx; line-height: 1; }

.book-detail-page .book-filters {
  margin: 16rpx 4rpx 0;
}

.book-detail-page .book-filter-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 12rpx;
}

.book-detail-page .filter-tab {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

.entry-list {
  margin-top: 18rpx;
  padding: 6rpx 0;
  overflow: hidden;
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, .78);
  background: rgba(231, 244, 235, .18);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .38);
}

.book-detail-page .entry-swipe-row {
  position: relative;
  overflow: hidden;
}

.book-detail-page .entry-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 0;
  min-height: 178rpx;
  padding: 28rpx 22rpx;
  border: 0;
  border-bottom: 1rpx solid rgba(62, 94, 73, .12);
  border-radius: 0;
  background: rgba(234, 245, 237, .28);
  box-sizing: border-box;
  transition: transform .32s cubic-bezier(.22, .75, .18, 1);
  will-change: transform;
}

.book-detail-page .entry-card-meanings-hidden {
  min-height: 112rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
  align-items: center;
}

.book-detail-page .entry-card-meanings-visible {
  min-height: 178rpx;
}

.book-detail-page .entry-card-swiped { transform: translateX(-248rpx); }
.book-detail-page .entry-card-swiped.entry-card-favorite-only { transform: translateX(-112rpx); }

.book-detail-page .entry-swipe-actions {
  position: absolute;
  z-index: 3;
  top: 0;
  right: auto;
  bottom: 0;
  left: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  width: 248rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: rgba(69, 111, 86, .18);
}

.book-detail-page .entry-swipe-actions-favorite-only {
  width: 112rpx;
  padding: 0 16rpx;
}

.book-detail-page .entry-swipe-star,
.book-detail-page .entry-swipe-label {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  color: #214936;
}

.book-detail-page .entry-swipe-star::after,
.book-detail-page .entry-swipe-label::after { border: 0; }

.book-detail-page .entry-swipe-star {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
}

.book-detail-page .entry-swipe-star.is-on {
  background: #d7eadc;
}

.book-detail-page .entry-swipe-label {
  min-width: 112rpx;
  height: 80rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: #fff;
  font-size: 24rpx;
  line-height: 1.2;
}

.book-detail-page .entry-swipe-icon {
  width: 40rpx;
  height: 40rpx;
}

.entry-copy {
  position: relative;
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.entry-selected-bar {
  display: none;
}

.book-detail-page .entry-selected-bar.is-on {
  display: block;
  position: absolute;
  top: 4rpx;
  bottom: 4rpx;
  left: -22rpx;
  width: 8rpx;
  border-radius: 8rpx;
  background: #4b8066;
}

.entry-en {
  color: #153729;
  font-family: Baskerville, "Palatino Linotype", Georgia, serif;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1.25;
}

.entry-meaning-list {
  margin-top: 12rpx;
}

.entry-meaning-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 5rpx;
  color: #315543;
  font-size: 24rpx;
  line-height: 1.45;
}

.entry-pos {
  flex: 0 0 40rpx;
  color: #47765d;
  font-family: Baskerville, "Palatino Linotype", Georgia, serif;
  font-weight: 700;
}

.entry-meaning {
  flex: 1;
  min-width: 0;
}

.book-detail-page .entry-en-active {
  color: #214f3a !important;
  font-weight: 650;
}

.book-detail-page .entry-card.entry-card-selected {
  background: #deeee4 !important;
  border-bottom-color: #bad6c5 !important;
  box-shadow: inset 0 1rpx 0 #bad6c5;
}

.book-detail-page .entry-card-selected .entry-en,
.book-detail-page .entry-card-selected .entry-zh {
  color: #214f3a !important;
}

.entry-zh {
  margin-top: 8rpx;
  color: #315543;
  font-size: 24rpx;
  line-height: 1.45;
}

.entry-status {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.3;
}

.entry-status-unlearned {
  color: #5f7d68;
  background: rgba(228, 241, 230, .72);
}

.entry-status-learning {
  color: #3f6f93;
  background: rgba(214, 232, 244, .78);
}

.entry-status-mastered {
  color: #3d7a55;
  background: rgba(210, 232, 214, .82);
}

.entry-star {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  margin: 4rpx 0 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, .76);
  border-radius: 50%;
  background: rgba(255, 255, 255, .3);
  color: #87978e;
  font-size: 30rpx;
  line-height: 1;
}

.entry-star::after { border: 0; }

.entry-star-on {
  color: #47765d;
  background: rgba(228, 242, 231, .7);
}

.list-status {
  padding: 18rpx 0 12rpx;
  color: #87978e;
  font-size: 22rpx;
  text-align: center;
}

.entry-word-line { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
