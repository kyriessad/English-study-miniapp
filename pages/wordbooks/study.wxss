@import "../review/review.wxss";

.kind-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 44rpx;
  margin: 0 auto 12rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .42);
  color: #315d48;
  font-size: 20rpx;
}
.study-example {
  margin: 0 auto 18rpx;
  max-width: 620rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, .78);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .28);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .66);
}
.study-example-en {
  color: #214936;
  font-family: Baskerville, "Palatino Linotype", Georgia, serif;
  font-size: 28rpx;
  line-height: 1.55;
  text-align: center;
}
.study-example-hit {
  color: #47765d;
  font-weight: 700;
}
.study-example-zh {
  margin-top: 8rpx;
  color: #687c71;
  font-size: 22rpx;
  line-height: 1.45;
  text-align: center;
}
.study-example-muted {
  color: #87978e;
  font-size: 22rpx;
  text-align: center;
}
.review-auto-next {
  margin-top: 24rpx;
  color: #687c71;
  font-size: 23rpx;
  text-align: center;
}
