<view class="page discover-page" style="padding-top: {{safeTop}}px;">
  <view class="subpage-top">
    <view class="back" bindtap="goBack">‹</view>
    <view class="subpage-heading">
      <view class="page-title">发现更多英语</view>
      <view class="page-subtitle">选择一种方式积累英语</view>
    </view>
  </view>
  <view class="discover-tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="discover-tab" data-key="{{item.key}}" bindtap="open">
      <view class="discover-tab-visual discover-visual-{{item.key}}"><view class="discover-line-icon"></view></view>
      <view class="discover-tab-copy">
        <view class="discover-tab-title">{{item.title}}</view>
        <view class="discover-tab-sub">{{item.sub}}</view>
      </view>
      <view class="discover-tab-arrow">›</view>
    </view>
  </view>
</view>
