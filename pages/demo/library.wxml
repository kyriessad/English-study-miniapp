<view class="page library-page"><view class="eyebrow">COLLECTION</view><view class="page-title">我的英语</view><view class="library-count">{{cards.length}} 条个人内容</view><view class="search-wrap"><text class="icon icon-search"></text><input class="search" placeholder="搜索英文、理解或来源" bindinput="search" /></view><scroll-view class="library-tabs" scroll-x="true" show-scrollbar="false"><view class="library-tab-row"><view wx:for="{{tabs}}" wx:key="key" class="filter-tab {{filter === item.key ? 'filter-tab-active' : ''}}" data-filter="{{item.key}}" bindtap="chooseFilter">{{item.label}}</view></view></scroll-view><view class="library-list"><view wx:for="{{filtered}}" wx:key="id" class="library-item" data-id="{{item.id}}" bindtap="open"><view class="library-en">{{item.en}}</view><view class="library-zh">{{item.my || item.zh}}</view><view class="library-note">{{item.source}} · {{item.note}}</view></view><view wx:if="{{filtered.length === 0}}" class="empty">没有匹配内容</view></view><button class="action action-primary add-library" bindtap="add">＋ 添加我遇到的英语</button></view>
