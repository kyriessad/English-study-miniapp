@import "./demo.wxss";

.recap-page { padding-right:44rpx; padding-left:44rpx; padding-bottom:56rpx; overflow:hidden; text-align:center; }
.recap-top { min-height:62rpx; }
.recap-kicker { font-size:28rpx; color:#203b27; }
.recap-celebration { margin:36rpx auto 12rpx; width:170rpx; height:150rpx; }
.recap-check { width:122rpx; height:122rpx; background:#dcebd9; color:#496f4e; font-size:72rpx; }
.recap-page > .page-title { font-size:48rpx; }
.recap-subtitle { font-size:25rpx; color:#607564; }
.recap-list { margin-top:38rpx; }
.recap-card { min-height:160rpx; padding:26rpx; border-radius:16rpx; }
.recap-status { flex-basis:72rpx; width:72rpx; height:72rpx; line-height:72rpx; font-size:38rpx; }
.recap-body { flex-basis:150rpx; }
.recap-en { font-size:26rpx; }
.recap-number { font-size:50rpx; }
.recap-examples { padding-left:22rpx; }
.recap-actions { margin-top:32rpx; }
.recap-actions .action { width:100%; }
.recap-card { display:block; min-height:0; padding:26rpx 30rpx; }
.recap-card::after { content:'›'; position:absolute; right:28rpx; top:50%; color:#496f4e; font-size:44rpx; transform:translateY(-50%); }
.recap-card { position:relative; padding-right:82rpx; }
.recap-en { color:#203b27; font-family:Georgia,"Times New Roman",serif; font-size:32rpx; font-weight:400; }
.recap-answer { margin-top:10rpx; color:#315737; font-size:26rpx; }
.recap-context { margin-top:8rpx; color:#728374; font-size:22rpx; }
