<view class="page detail-page" wx:if="{{item}}"><view class="subpage-top"><view class="back" bindtap="goBack">‹</view><view class="eyebrow">{{mode === 'public' ? '公共素材详情' : '我的英语'}}</view><button wx:if="{{mode === 'personal'}}" class="top-text-button" bindtap="toggleEdit">{{editing ? '取消' : '编辑'}}</button></view><view class="detail-hero"><view class="detail-category">{{item.category || '英语表达'}}</view><view class="detail-en">{{english}}</view><view class="phonetic-row"><text>{{item.phonetic || '/.../'}}</text><button class="sound-btn" bindtap="play">◉</button></view><view class="detail-zh">{{item.zh}}</view><view class="detail-context">{{item.context || note || '记录这条英语的理解与使用场景'}}</view></view><view wx:if="{{editing}}" class="form-card"><view class="form-block"><view class="field-label">英文内容</view><textarea class="add-textarea" value="{{english}}" bindinput="onEnglishInput" auto-height></textarea></view><view class="form-block"><view class="field-label">我的理解</view><textarea class="add-textarea" value="{{my}}" bindinput="onMyInput" auto-height placeholder="可选"></textarea></view><view class="form-block"><view class="field-label">在哪里遇到</view><textarea class="add-textarea" value="{{note}}" bindinput="onNoteInput" auto-height placeholder="可选"></textarea></view><button class="action action-primary" bindtap="save">保存</button></view><view wx:else class="detail-sections"><view class="detail-section"><view class="section-title">我的理解</view><view class="section-value">{{my || '暂时没有填写，复习时使用参考理解'}}</view></view><view class="detail-section"><view class="section-title">参考信息</view><view class="section-value">{{item.zh}}</view><button class="outline-button" bindtap="analyze">{{analysis ? '已生成 AI 深入分析' : 'AI 深入分析'}}</button><view wx:if="{{analysis}}" class="analysis-panel"><view class="analysis-title">AI 深入分析</view><view class="analysis-row"><text class="analysis-label">常见理解</text><text>{{analysis.meaning}}</text></view><view class="analysis-row"><text class="analysis-label">使用场景</text><text>{{analysis.usages[0]}}</text></view><view class="analysis-row"><text class="analysis-label">例句</text><text>{{analysis.examples[0].en}} {{analysis.examples[0].zh}}</text></view><view class="analysis-row"><text class="analysis-label">相似表达</text><text>{{analysis.relatedText}}</text></view></view></view><view wx:if="{{mode === 'personal'}}" class="detail-section switch-row"><view><view class="section-title">参与复习</view><view class="section-muted">关闭后不会进入主导航复习</view></view><switch checked="{{participate}}" color="#5eaa64" bindchange="toggleParticipate" /></view></view><view wx:if="{{mode === 'public'}}" class="detail-bottom"><button class="action action-primary" bindtap="remember">{{saved || item.joined ? '已加入' : '想记住'}}</button></view></view>
