@import "./demo.wxss";

.library-page { padding-right:24rpx; padding-left:24rpx; padding-bottom:190rpx; overflow:visible; }
.library-heading { display:flex; align-items:center; justify-content:space-between; }
.library-heading .page-title { font-size:48rpx; }
.manage-button { min-width:108rpx; height:58rpx; line-height:58rpx; padding:0 20rpx; margin:6rpx 0 0; border:1rpx solid #9db49a; border-radius:999rpx; background:rgba(255,255,250,.55); color:#315737; font-size:24rpx; }
.manage-button::after { border:0; }
.library-view-tabs { height:78rpx; margin-top:26rpx; gap:0; border:1rpx solid #9db49a; border-radius:999rpx; overflow:hidden; background:#e4eee1; }
.library-view-tab { flex:1; display:flex; align-items:center; justify-content:center; padding:0; border:0; border-radius:0; background:transparent; color:#4d6752; font-size:29rpx; }
.library-view-tab-active { background:#789372; color:#fffdf8; }
.library-page .search-wrap { margin-top:22rpx; height:78rpx; }
.search-clear { display:flex; align-items:center; justify-content:center; flex:0 0 48rpx; width:48rpx; height:48rpx; padding:0; margin:0; border:0; border-radius:50%; background:#dce8d9; color:#536b58; font-size:31rpx; line-height:1; }
.search-clear::after { border:0; }
.library-filters { margin:20rpx 0 0; gap:12rpx; overflow:visible; }
.library-filters .filter-tab { padding:12rpx 26rpx; font-size:24rpx; }
.book-filters { display:block; width:100%; white-space:nowrap; overflow:hidden; }
.book-filter-row { display:inline-flex; gap:12rpx; padding-right:20rpx; }
.library-list { margin:22rpx -24rpx 0; padding:0 48rpx; background:rgba(255,255,250,.82); }
.library-item { display:flex; align-items:center; gap:20rpx; margin:0; padding:24rpx 4rpx; border:0; border-bottom:1rpx solid #d5e1d1; border-radius:0; background:transparent; }
.library-item-copy { flex:1; min-width:0; }
.library-wordbook-list { margin:22rpx 0 0; }
.library-wordbook-card { display:flex; align-items:center; min-height:142rpx; margin-bottom:14rpx; padding:24rpx 28rpx; border:1rpx solid #d8e3d5; border-radius:16rpx; background:rgba(255,253,248,.9); box-sizing:border-box; }
.library-wordbook-copy { flex:1; min-width:0; }
.library-wordbook-en { color:#203e27; font-family:Georgia,"Times New Roman",serif; font-size:36rpx; line-height:1.25; word-break:break-word; }
.library-wordbook-zh { margin-top:8rpx; color:#315737; font-size:25rpx; line-height:1.4; }
.library-wordbook-source { display:inline-block; margin-top:10rpx; padding:5rpx 14rpx; border-radius:999rpx; background:#e5f0e2; color:#55725a; font-size:20rpx; }
.library-wordbook-card .chevron { margin-right:4rpx; }
.selection-check { display:flex; align-items:center; justify-content:center; flex:0 0 42rpx; width:42rpx; height:42rpx; border:2rpx solid #9eb09d; border-radius:50%; color:#fff; font-size:25rpx; box-sizing:border-box; }
.selection-check-active { border-color:#789372; background:#789372; }
.library-en { font-family:Georgia,"Times New Roman",serif; font-size:34rpx; font-weight:400; }
.library-zh { margin-top:8rpx; color:#315737; font-size:26rpx; }
.library-source { color:#728374; font-size:21rpx; }
.library-empty { padding-top:110rpx; text-align:center; }
.library-empty-search-art .empty-book { left:70rpx; top:8rpx; width:98rpx; height:124rpx; border:3rpx solid #789372; border-radius:8rpx; background:#fffdf8; transform:none; }
.library-empty-search-art .empty-book::before { content:''; position:absolute; left:18rpx; right:18rpx; top:27rpx; height:3rpx; background:#b7c8b2; box-shadow:0 18rpx 0 #b7c8b2,0 36rpx 0 #b7c8b2; }
.library-empty-search-art .empty-book::after { display:none; }
.empty-search-lens { position:absolute; right:-31rpx; bottom:-24rpx; width:49rpx; height:49rpx; border:5rpx solid #52745a; border-radius:50%; box-sizing:border-box; }
.empty-search-lens::after { content:''; position:absolute; right:-19rpx; bottom:-13rpx; width:28rpx; height:5rpx; border-radius:3rpx; background:#52745a; transform:rotate(45deg); }
.library-empty-search-art .empty-leaf { left:54rpx; top:16rpx; opacity:.8; }
.library-clear-action { width:76%; margin:28rpx auto 0; border:1rpx solid #789372; background:transparent; color:#315737; }
.library-clear-action + .library-empty-action { margin-top:14rpx; }
.manage-bar { position:fixed!important; z-index:40!important; left:0; right:0; bottom:96rpx; display:flex; align-items:center; justify-content:space-between; height:104rpx; padding:0 34rpx; border-top:1rpx solid #ccd9c9; background:#fffdf9; box-sizing:border-box; color:#5e7162; font-size:23rpx; box-shadow:0 -8rpx 24rpx rgba(48,78,54,.08); }
.manage-select-all,.manage-delete { height:62rpx; line-height:62rpx; padding:0 26rpx; margin:0; border:0; border-radius:999rpx; background:transparent; color:#315737; font-size:24rpx; }
.manage-delete { color:#a8aaa8; }
.manage-delete-active { background:#f7e7e4; color:#a65750; }
.manage-select-all::after,.manage-delete::after { border:0; }
