<view class="page recap-page"><view class="eyebrow">REVIEW RECAP</view><view class="page-title">本轮复盘</view><view class="recap-subtitle">每张卡片只展示一次最终结果</view><view class="recap-list"><view wx:for="{{results}}" wx:key="card.id" class="recap-card {{item.correct ? 'recap-correct' : 'recap-wrong'}}" data-id="{{item.card.id}}" bindtap="open"><view class="recap-result">{{item.correct ? '答对' : '需要再巩固'}}</view><view class="recap-en">{{item.card.en}}</view><view class="recap-answer">正确答案：{{item.card.answer}}</view><view class="recap-meta">第 {{item.attempts}} 次作答 · 点击查看详情</view></view></view><view wx:if="{{results.length === 0}}" class="empty">本轮还没有完成的题目</view><view class="recap-actions"><button class="action action-primary" bindtap="again">再来一轮</button><button class="action action-secondary" bindtap="home">返回复习首页</button></view></view>
