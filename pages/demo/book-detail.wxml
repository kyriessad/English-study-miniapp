<view class="page book-detail-page" wx:if="{{book}}"><view class="subpage-top"><view class="back" bindtap="goBack">‹</view><view class="eyebrow">{{book.exam}}</view></view><view class="book-hero"><view class="book-cover large" style="background:{{book.color}}"><view class="book-cover-mark">A</view></view><view class="book-hero-copy"><view class="page-title">{{book.title}}</view><view class="book-desc">{{book.description}}</view><view class="progress-line"><view class="progress-track"><view class="progress-fill" style="width:{{book.learned / 50 * 100}}%"></view></view><text>已学习 {{book.learned}} 词</text></view></view></view><view class="book-actions"><button class="action action-primary" bindtap="joinBook">{{book.joined ? '已加入 · 停止学习' : '加入词汇书'}}</button><button class="action action-secondary" bindtap="startReview">开始词汇书复习</button></view><view class="section-head detail-head"><view class="section-title">示例词条</view><view class="section-link">{{entries.length}} 条展示</view></view><view class="entry-list"><view wx:for="{{entries}}" wx:key="id" class="entry-card"><view class="entry-copy"><view class="entry-en">{{item.en}}</view><view class="entry-phonetic">{{item.phonetic}}</view><view class="entry-zh">{{item.zh}}</view><view class="entry-sentence">{{item.sentence}}</view></view><button class="entry-add {{item.joined ? 'entry-add-done' : ''}}" data-id="{{item.id}}" bindtap="joinPersonal">{{item.joined ? '已加入' : '加入我的英语'}}</button></view></view></view>
