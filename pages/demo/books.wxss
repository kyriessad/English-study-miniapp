@import "./demo.wxss";
.page-subtitle{margin-top:10rpx;color:#7b887e;font-size:25rpx;line-height:1.6}.book-list{margin-top:24rpx}.book-card{display:flex;align-items:center;position:relative;margin-bottom:16rpx;padding:22rpx;border:1rpx solid #e6ece4;border-radius:26rpx;background:#fff;box-shadow:0 10rpx 24rpx rgba(86,126,82,.05)}.book-cover{display:flex;align-items:center;justify-content:center;flex:0 0 auto;width:112rpx;height:142rpx;border-radius:18rpx}.book-cover-mark{color:#5d8062;font-size:46rpx;font-weight:800}.book-copy{min-width:0;flex:1;margin-left:20rpx}.book-title{color:#2c3d31;font-size:30rpx;font-weight:700}.book-exam{margin-top:5rpx;color:#6f8273;font-size:22rpx}.book-desc{margin-top:11rpx;color:#869287;font-size:23rpx;line-height:1.45}.book-meta{margin-top:10rpx;color:#9ba69d;font-size:22rpx}.book-arrow{color:#8db395;font-size:46rpx;font-weight:300}
