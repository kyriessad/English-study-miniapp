<view class="page review-page" wx:if="{{current}}"><view class="review-top"><button class="top-text-button" bindtap="exit">退出</button><view class="review-progress"><text>{{index + 1}}</text> / {{cards.length}}</view></view><view class="review-card"><view class="review-label">选择正确的中文理解</view><view class="review-en">{{current.en}}</view><view class="review-context">{{current.context}}</view><view class="options"><button wx:for="{{current.options}}" wx:key="*this" class="option {{selected === index ? (index === 0 ? 'option-correct' : 'option-wrong') : ''}}" data-index="{{index}}" bindtap="choose"><text class="option-letter">{{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}</text><text class="option-text">{{item}}</text><text wx:if="{{selected === index && index === 0}}" class="option-check">✓</text><text wx:if="{{selected === index && index !== 0}}" class="option-check option-cross">×</text></button></view><button class="unknown-button" bindtap="unknown">不知道</button><view wx:if="{{reveal}}" class="answer-reveal">正确答案：{{current.answer}}</view><view wx:if="{{answered}}" class="feedback">{{reveal ? '第二次仍答错，答案已揭晓' : (attempt === 1 ? '第一次答错，本轮稍后再来一次' : '答对了')}}</view></view><button wx:if="{{answered}}" class="action action-primary" bindtap="next">下一题</button></view>
