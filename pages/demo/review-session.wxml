<view wx:if="{{loading}}" class="page review-page core-status" style="padding-top: {{safeTop}}px;">正在准备本轮复习…</view>
<view wx:elif="{{error}}" class="page review-page core-status core-status-error" style="padding-top: {{safeTop}}px;"><view>{{error}}</view><button class="text-link" bindtap="retryLoad">重新加载</button></view>
<view class="page review-page" style="padding-top: {{safeTop}}px;" wx:elif="{{current}}">
  <view class="review-top">
    <button class="close-button" bindtap="exit">×</button>
    <view class="review-progress">{{currentNo}} / {{total}}</view>
  </view>
  <view class="review-progress-track"><view class="review-progress-fill" style="width:{{total > 0 ? currentNo / total * 100 : 0}}%"></view></view>
  <view class="review-focus">
    <view class="review-en">{{current.en}}</view>
    <view class="review-phonetic">{{current.phonetic}}</view>
    <view class="review-divider"></view>
    <view class="review-label">选择最合适的中文理解</view>
  </view>
  <view wx:if="{{showDetailNotice}}" class="review-detail-notice">ⓘ　已查看详情，请再试一次</view>
  <view class="options">
    <button wx:for="{{current.options}}" wx:key="optionId" class="option {{answered && selectedOptionId === item.optionId ? (isCorrect ? 'option-correct' : 'option-wrong') : ''}}" data-option-id="{{item.optionId}}" bindtap="choose" disabled="{{submitting || answered}}">
      <text wx:if="{{answered && selectedOptionId === item.optionId && !isCorrect}}" class="option-status option-cross">×</text>
      <text class="option-text">{{item.text}}</text>
      <text wx:if="{{answered && selectedOptionId === item.optionId && isCorrect}}" class="option-status option-check">✓</text>
      <text wx:if="{{!answered || selectedOptionId !== item.optionId}}" class="option-arrow">›</text>
    </button>
  </view>
  <button class="unknown-button" bindtap="unknown" disabled="{{submitting || answered}}">—　不知道　—</button>
  <view wx:if="{{showExample}}" class="review-example"><view class="review-example-label">例句</view><view class="review-example-en">{{current.example || '再看一眼这条英语，然后重新选择。'}}</view></view>
  <button wx:if="{{showExample || awaitingNext}}" class="action action-primary review-continue" bindtap="next">{{awaitingNext ? '继续复习' : '再试一次'}}</button>
</view>
