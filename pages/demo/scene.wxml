<view class="page scene-page" style="padding-top: {{safeTop}}px;">
  <view class="subpage-top"><view class="back" bindtap="goBack">‹</view><view class="subpage-heading"><view class="page-title">{{title}}</view><view class="page-subtitle">{{type === 'reading' ? '精选短文和故事' : '日常口语实用场景'}}</view></view></view>
  <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false"><view class="category-row"><view wx:for="{{categories}}" wx:key="code" class="category-pill {{selectedCode === item.code ? 'category-pill-active' : ''}}" data-code="{{item.code}}" bindtap="selectCategory">{{item.title}}</view></view></scroll-view>
  <view class="scene-toolbar"><view><view class="section-title">{{selectedTitle}}</view><view class="scene-hint">浏览这一类真实表达</view></view><button class="ghost-button" bindtap="changeBatch">换一批</button></view>
  <view wx:if="{{loading && items.length === 0}}" class="core-status">正在加载公开素材…</view>
  <view wx:elif="{{error && items.length === 0}}" class="core-status core-status-error"><view>{{error}}</view><button class="text-link" bindtap="retryLoad">重新加载</button></view>
  <view class="material-list"><view wx:for="{{items}}" wx:key="id" class="material-card" data-id="{{item.id}}" bindtap="openDetail"><view class="material-top"><view class="material-tag">{{item.category}}</view></view><view class="material-en-row"><view class="material-en">{{item.en}}</view><button class="sound-btn" catchtap="play" data-id="{{item.id}}">◉</button></view><view class="material-phonetic">{{item.phonetic}}</view><view class="material-zh">{{item.zh}}</view><view class="material-context">{{item.context}}</view><button class="remember-compact {{item.joined ? 'remembered' : ''}}" catchtap="remember" data-id="{{item.id}}">{{item.joined ? '已加入' : '想记住'}}</button></view></view>
  <view wx:if="{{!loading && !error && items.length === 0}}" class="empty">暂无内容</view>
  <view wx:if="{{loadingMore && items.length > 0}}" class="list-status">正在加载…</view>
</view>
