<view class="page review-page" wx:if="{{entries.length}}"><view class="review-top"><view class="eyebrow">{{book.title}}</view><view class="review-progress"><text>{{index + 1}}</text> / {{entries.length}}</view></view><view class="review-card"><view class="review-label">选择正确的中文理解</view><view class="review-en">{{entries[index].en}}</view><view class="review-phonetic">{{entries[index].phonetic}}</view><view class="options"><button wx:for="{{entries[index].options}}" wx:key="*this" class="option {{selected === index ? (index === 0 ? 'option-correct' : 'option-wrong') : ''}}" data-index="{{index}}" bindtap="choose"><text class="option-letter">{{index === 0 ? 'A' : index === 1 ? 'B' : index === 2 ? 'C' : 'D'}}</text><text class="option-text">{{item}}</text></button></view><view wx:if="{{showAnswer}}" class="answer-reveal">正确答案：{{entries[index].zh}}</view><view wx:if="{{answered}}" class="feedback">{{showAnswer ? '第二次仍答错，答案已揭晓' : '答对了，记得很牢'}}</view></view><button wx:if="{{answered}}" class="action action-primary" bindtap="next">下一题</button></view>
