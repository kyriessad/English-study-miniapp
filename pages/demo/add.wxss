@import "./demo.wxss";

.add-page .form-card {
  display:flex;
  flex-direction:column;
}
.add-page .add-save {
  flex:0 0 auto;
  margin-top:auto;
  margin-bottom:0;
}

.add-page { padding-right:24rpx; padding-left:24rpx; padding-bottom:132rpx; overflow:visible; }
.add-header { margin:8rpx 8rpx 0; }
.add-header .subpage-heading .page-title { font-size:44rpx; }
.add-page .form-card { margin-top:28rpx; padding:30rpx; border-radius:16rpx; }
.add-page .form-block { margin-bottom:24rpx; }
.add-page .field-label { margin-bottom:10rpx; font-size:28rpx; }
.add-page .field-label::after { content:'  (可选)'; color:#607564; font-size:22rpx; font-weight:400; }
.add-page .form-block-primary .field-label::after { content:' *'; color:#d65b4f; font-size:28rpx; }
.add-page .add-textarea { min-height:112rpx; padding:18rpx 20rpx; border-radius:14rpx; font-size:26rpx; }
.add-page .form-block-primary .add-textarea { min-height:92rpx; }
.add-page .add-save { margin-top:12rpx; height:78rpx; line-height:78rpx; }
