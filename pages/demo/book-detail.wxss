@import "./demo.wxss";
.book-hero{display:flex;margin-top:24rpx;padding:24rpx;border-radius:28rpx;background:#fff;border:1rpx solid #e6ece4}.book-cover.large{width:132rpx;height:166rpx}.book-hero-copy{flex:1;margin-left:22rpx}.book-hero-copy .page-title{font-size:34rpx}.progress-line{margin-top:22rpx;color:#7c897e;font-size:22rpx}.progress-track{height:12rpx;margin-bottom:8rpx;border-radius:999rpx;background:#edf2eb;overflow:hidden}.progress-fill{height:100%;border-radius:999rpx;background:#5eaa64}.book-actions{margin-top:20rpx}.book-actions .action{margin-bottom:12rpx}.action-secondary{color:#56805d;background:#eaf4e9;border:1rpx solid #e0edde}.detail-head{margin-top:28rpx}.entry-list{margin-top:12rpx}.entry-card{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:14rpx;padding:22rpx;border:1rpx solid #e8eee5;border-radius:24rpx;background:#fff}.entry-copy{flex:1;min-width:0}.entry-en{color:#26352b;font-size:31rpx;font-weight:700}.entry-phonetic{margin-top:5rpx;color:#81a189;font-size:22rpx}.entry-zh{margin-top:7rpx;color:#657465;font-size:26rpx}.entry-sentence{margin-top:9rpx;color:#939e95;font-size:22rpx;line-height:1.5}.entry-add{flex:0 0 auto;width:150rpx;height:58rpx;line-height:58rpx;padding:0;margin:4rpx 0 0 15rpx;border:0;border-radius:999rpx;background:#5eaa64;color:#fff;font-size:22rpx}.entry-add::after{border:0}.entry-add-done{color:#57815e;background:#e8f2e7}
