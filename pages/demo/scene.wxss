@import "./demo.wxss";
.category-scroll{margin:24rpx -28rpx 0;padding:0 28rpx}.category-row{display:flex;gap:12rpx;white-space:nowrap}.category-pill{display:inline-block;padding:14rpx 22rpx;border-radius:999rpx;background:#fff;color:#718078;border:1rpx solid #e5ece2;font-size:25rpx}.category-pill-active{background:#5eaa64;color:#fff;border-color:#5eaa64}.scene-toolbar{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx}.scene-hint{margin-top:6rpx;color:#98a398;font-size:22rpx}.ghost-button{height:62rpx;line-height:62rpx;padding:0 22rpx;margin:0;border-radius:999rpx;color:#5e8f6e;background:#edf8ef;font-size:24rpx}.ghost-button::after{border:0}.material-list{margin-top:18rpx}.material-card{position:relative;margin-bottom:18rpx;padding:24rpx;border:1rpx solid #e8eee5;border-radius:26rpx;background:#fff;box-shadow:0 10rpx 24rpx rgba(86,126,82,.06)}.material-top{display:flex;justify-content:space-between;align-items:center}.material-tag{color:#78a17d;font-size:22rpx}.sound-btn{width:52rpx;height:52rpx;line-height:52rpx;padding:0;margin:0;border:1rpx solid #d8ebdc;border-radius:16rpx;background:#f5fbf7;color:#5eaa64;font-size:25rpx}.sound-btn::after{border:0}.material-en{margin-top:16rpx;color:#26352b;font-size:34rpx;line-height:1.4;font-weight:700}.material-zh{margin-top:8rpx;color:#647268;font-size:27rpx}.material-context{margin-top:10rpx;color:#98a398;font-size:23rpx}.material-card .remember-button{margin-top:18rpx;width:100%;height:68rpx;line-height:68rpx}.remember-button{border:0}.remember-button::after{border:0}
