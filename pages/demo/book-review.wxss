@import "./demo.wxss";
.review-phonetic{margin-top:8rpx;color:#81a189;text-align:center;font-size:23rpx}.answer-reveal{margin-top:18rpx;padding:18rpx;border-radius:16rpx;background:#fff7e8;color:#a16b2b;font-size:25rpx;text-align:center}

.book-review-page { height:100vh; min-height:0; padding:46rpx 52rpx 36rpx; overflow:hidden; }
.book-review-page .review-progress { font-family:Georgia,"Times New Roman",serif; font-size:27rpx; color:#203b27; }
.book-review-page .review-focus { flex-basis:470rpx; }
.book-review-page .review-en { font-size:78rpx; font-style:italic; font-weight:400; }
.book-review-page .option { min-height:90rpx; border-radius:16rpx; }
.book-review-page .review-example { margin-top:22rpx; padding:22rpx 26rpx; border:1rpx solid #d5e1d1; border-radius:16rpx; background:rgba(255,255,250,.76); }
.book-review-page .review-example-label { color:#496f4e; font-size:23rpx; font-weight:600; }
.book-review-page .review-example-en { margin-top:10rpx; color:#315737; font-family:Georgia,"Times New Roman",serif; font-size:25rpx; line-height:1.5; }
.book-review-page .review-continue { margin-top:18rpx; }
