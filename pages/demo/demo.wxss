.review-home-page {
  height:100vh;
  min-height:0;
  display:flex;
  flex-direction:column;
  padding-right:0;
  padding-bottom:0;
  padding-left:0;
  overflow:hidden;
}
.review-home-hero { flex:1; min-height:0; padding:46rpx 56rpx 30rpx; box-sizing:border-box; }
.review-home-hero .page-title { font-size:58rpx; }
.review-today { margin-top:10rpx; color:#607462; font-size:28rpx; }
.review-quote {
  margin-top:112rpx;
  color:#6b806d;
  font-family:Georgia,"Times New Roman",serif;
  font-size:43rpx;
  font-style:italic;
  line-height:1.25;
}
.review-quote-line + .review-quote-line { margin-top:5rpx; }
.review-rule { width:58rpx; height:2rpx; margin-top:36rpx; background:#98aa94; }
.review-caption { margin-top:30rpx; color:#6b806d; font-size:23rpx; }
.review-home-card {
  display:block;
  flex:0 0 410rpx;
  padding:40rpx 56rpx 30rpx;
  box-sizing:border-box;
  border-radius:18rpx 18rpx 0 0;
  background:#fffdf8;
}
.review-home-card .section-title { font-size:30rpx; }
.review-home-card .page-subtitle { margin-top:10rpx; }
.size-row { gap:20rpx; margin-top:30rpx; }
.size-option {
  padding:24rpx 8rpx;
  border:1rpx solid #cad8c8;
  border-radius:14rpx;
  background:transparent;
  color:#27472d;
}
.size-option-active { border-color:#789372; background:#789372; color:#fffdf8; }
.size-number { font-family:Georgia,"Times New Roman",serif; font-size:40rpx; font-weight:400; }
.size-label { display:none; }
.review-start { width:82%; margin:42rpx auto 0; }
.review-tip { margin-top:20rpx; color:#738475; font-size:21rpx; text-align:center; }

.review-page {
  height:100vh;
  min-height:0;
  display:flex;
  flex-direction:column;
  padding-right:40rpx;
  padding-bottom:36rpx;
  padding-left:40rpx;
  overflow:hidden;
}
.review-top { flex:0 0 60rpx; display:flex; align-items:center; justify-content:space-between; }
.close-button {
  width:48rpx;
  height:48rpx;
  padding:0;
  border:0;
  background:transparent;
  color:#16351f;
  font-size:48rpx;
  font-weight:300;
  line-height:44rpx;
}
.close-button::after { border:0; }
.review-progress { margin-right:120rpx; color:#27472d; font-family:Georgia,"Times New Roman",serif; font-size:25rpx; }
.review-progress-track {
  flex:0 0 8rpx;
  height:8rpx;
  margin-top:10rpx;
  overflow:hidden;
  border-radius:999rpx;
  background:#d7e2d4;
}
.review-progress-fill { height:100%; border-radius:999rpx; background:#789372; }
.review-focus {
  flex:0 0 470rpx;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  margin-top:12rpx;
}
.review-en {
  min-height:0;
  margin:0;
  color:#17391f;
  font-family:Georgia,"Times New Roman",serif;
  font-size:76rpx;
  font-style:italic;
  font-weight:400;
  line-height:1.08;
}
.review-phonetic { margin-top:14rpx; color:#607462; font-family:Georgia,"Times New Roman",serif; font-size:29rpx; }
.review-context { display:none; }
.review-divider { width:72rpx; height:2rpx; margin-top:34rpx; background:#b8c8b4; }
.review-label { margin-top:34rpx; color:#607462; font-size:24rpx; }
.options { flex:0 0 auto; gap:12rpx; margin-top:0; }
.option {
  min-height:82rpx;
  padding:14rpx 28rpx;
  border:1rpx solid #c6d6c3;
  border-radius:14rpx;
  background:rgba(255,253,248,.88);
  color:#17391f;
}
.option-text { font-size:28rpx; }
.option-arrow { margin-left:12rpx; color:#496b45; font-size:42rpx; font-weight:300; }
.option-status {
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 46rpx;
  width:46rpx;
  height:46rpx;
  margin-right:16rpx;
  border-radius:50%;
  color:#fff;
  font-size:30rpx;
}
.option-check { margin-right:0; margin-left:14rpx; background:#789372; }
.option-cross { background:#ce5650; }
.option-correct { border-color:#789372; background:rgba(232,243,230,.82); }
.option-wrong { border-color:#d86c63; background:#fff1ef; }
.unknown-button { margin-top:18rpx; color:#8b9a8c; font-size:22rpx; }
.answer-reveal { margin-top:12rpx; padding:12rpx; background:#edf5ea; color:#315737; }
.feedback { margin-top:10rpx; font-size:21rpx; }
.review-page > .action { height:60rpx; margin-top:10rpx; line-height:60rpx; }
@media (max-height:700px) {
  .review-focus { flex-basis:420rpx; }
  .review-en { font-size:68rpx; }
  .option { min-height:76rpx; }
}

.recap-page { padding-right:34rpx; padding-left:34rpx; text-align:center; }
.recap-top { display:flex; align-items:center; min-height:60rpx; }
.recap-kicker { position:absolute; left:50%; color:#315737; font-size:26rpx; transform:translateX(-50%); }
.recap-celebration {
  position:relative;
  width:150rpx;
  height:130rpx;
  margin:22rpx auto 4rpx;
}
.recap-check {
  display:flex;
  align-items:center;
  justify-content:center;
  width:106rpx;
  height:106rpx;
  margin:0 auto;
  border-radius:50%;
  background:rgba(207,225,201,.78);
  color:#496b45;
  font-size:64rpx;
}
.recap-page > .page-title { font-size:46rpx; text-align:center; }
.recap-subtitle { margin-top:12rpx; color:#657568; font-size:23rpx; }
.recap-list { margin-top:32rpx; }
.recap-card {
  display:flex;
  align-items:center;
  gap:18rpx;
  min-height:132rpx;
  margin-bottom:14rpx;
  padding:22rpx;
  border:1rpx solid #c8d7c5;
  border-radius:14rpx;
  background:rgba(255,253,248,.88);
  text-align:left;
}
.recap-status {
  flex:0 0 70rpx;
  width:70rpx;
  height:70rpx;
  color:#315737;
  background:#edf5ea;
  font-size:38rpx;
  line-height:70rpx;
}
.recap-body { flex:0 0 150rpx; }
.recap-en { color:#27472d; font-size:24rpx; }
.recap-number { margin-top:4rpx; color:#17391f; font-family:Georgia,"Times New Roman",serif; font-size:46rpx; line-height:1; }
.recap-number text { font-family:inherit; font-size:20rpx; }
.recap-examples { flex:1; min-width:0; padding-left:18rpx; border-left:1rpx solid #dce5da; }
.recap-example-label { color:#738475; font-size:19rpx; }
.recap-answer { margin-top:8rpx; color:#315737; font-size:21rpx; line-height:1.4; }
.recap-actions { margin-top:30rpx; }
.recap-actions .action { width:88%; margin:0 auto 18rpx; }
.recap-actions .text-link { display:block; margin:0 auto; color:#496b45; font-size:23rpx; }

/* Final visual refinements shared by the demo screens. */
.sound-btn::before {
  left:4rpx;
  top:9rpx;
  width:27rpx;
  height:30rpx;
  border:0;
  border-radius:0;
  background:#315737;
  clip-path:polygon(0 34%,34% 34%,76% 0,76% 100%,34% 66%,0 66%);
}
.sound-btn::after {
  left:22rpx;
  top:7rpx;
  width:16rpx;
  height:34rpx;
  border:3rpx solid transparent;
  border-right-color:#315737;
  border-radius:50%;
}
.add-page .form-card { min-height:1040rpx; box-sizing:border-box; }
.add-page .add-textarea { min-height:116rpx; }
.add-page .form-block-primary .add-textarea { min-height:88rpx; }
.add-page .form-block:last-child .add-textarea { min-height:82rpx; }
.discover-page {
  height:100vh;
  min-height:0;
  display:flex;
  flex-direction:column;
  padding-bottom:0;
  overflow:hidden;
}
.discover-page .discover-tabs {
  flex:1;
  margin:34rpx -26rpx 0;
  padding:22rpx 26rpx 40rpx;
  background:#fffdf8;
}
.discover-page .discover-tab {
  min-height:176rpx;
  margin-bottom:0;
  border:0;
  border-bottom:1rpx solid #d6e1d3;
  border-radius:0;
  background:transparent;
}

.core-status {
  padding:72rpx 30rpx;
  color:#607564;
  font-size:24rpx;
  line-height:1.6;
  text-align:center;
}
.core-status-error { color:#8d5b54; }
.core-status .text-link { display:block; margin:18rpx auto 0; }
.detail-bottom > .text-link { display:block; margin:18rpx auto 0; }

/* Shared final-screen surface: quiet green canvas, warm white content, serif English. */
page { background:#f1f8ee; color:#203b27; }
.page {
  min-height:100vh;
  box-sizing:border-box;
  padding-bottom:132rpx;
  background:
    radial-gradient(circle at 82% 4%, rgba(255,255,250,.82), rgba(255,255,250,0) 34%),
    linear-gradient(180deg,#f1f8ee 0%,#edf6ea 55%,#f1f8ee 100%);
  color:#203b27;
}
.page::before,.page::after { opacity:.22; }
.page-title { color:#203b27; font-family:Georgia,"Times New Roman","Songti SC",serif; font-weight:400; }
.page-subtitle { color:#607564; }
.back {
  flex:0 0 60rpx;
  width:60rpx;
  height:60rpx;
  border:1rpx solid rgba(76,111,77,.24);
  border-radius:50%;
  background:rgba(255,255,250,.46);
  color:#203b27;
  font-size:48rpx;
  line-height:52rpx;
}
.action { height:76rpx; line-height:76rpx; border-radius:999rpx; font-size:27rpx; font-weight:600; }
.action-primary { background:#789372; box-shadow:0 10rpx 24rpx rgba(67,101,65,.14); }
.action-secondary { border:1rpx solid #789372; background:rgba(255,255,250,.42); color:#315737; }
.search-wrap { border-color:#c7d7c3; background:rgba(255,255,250,.58); }
.sound-btn { border:0; background:transparent; }
.material-card,.book-card,.book-hero,.entry-card,.detail-section,.form-card,.library-item,.recap-card,.option {
  border-color:#d5e1d1;
  border-radius:16rpx;
  background:rgba(255,255,250,.84);
  box-shadow:none;
}
.category-pill,.filter-tab,.library-view-tab,.size-option {
  border-color:#c7d8c3;
  background:rgba(255,255,250,.42);
  color:#49654b;
}
.category-pill-active,.filter-tab-active,.library-view-tab-active,.size-option-active {
  border-color:#789372;
  background:#789372;
  color:#fffdf8;
}
.text-link,.ghost-button,.section-link,.book-arrow,.top-text-button { color:#496f4e; }
.field-label,.section-title,.book-title,.discover-tab-title { color:#274a30; }
.add-textarea { border-color:#c7d8c3; background:rgba(255,255,250,.42); }
.remember-button,.compact-remember,.remember-detail,.entry-add,.outline-button {
  border-color:#c7d8c3;
  background:#e7f1e3;
  color:#496f4e;
}
.remember-button.remembered,.compact-remember.remembered,.remember-detail.remembered,.entry-add-done {
  background:#d6e7d2;
  color:#416847;
}

