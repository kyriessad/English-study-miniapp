.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.form-card {
  padding: 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.meta-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.meta-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 64rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.meta-pill-text {
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1;
}

.meta-pill-arrow {
  font-size: 22rpx;
  color: #667085;
  line-height: 1;
}


.form-title {
  margin-bottom: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.grid-item {
  margin-bottom: 0;
}


.label {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #344054;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label-row .label { margin-bottom: 12rpx; }

.original-pronunciation-btn,
.example-pronunciation-btn {
  flex-shrink: 0;
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  line-height: 54rpx;
  padding: 0;
  margin: 0 0 12rpx 16rpx;
  border: 1rpx solid #cfe6d6;
  border-radius: 18rpx;
  background: #f5fbf7;
  color: #3f8b61;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.original-pronunciation-btn::after,
.example-pronunciation-btn::after { border: none; }
.original-pronunciation-btn[disabled],
.example-pronunciation-btn[disabled] { color: #a8b4ad; background: #f3f5f4; }
.original-pronunciation-btn-active,
.example-pronunciation-btn-active { color: #fff; background: #35b779; }

.reference-example-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.reference-example-line .reference-value { flex: 1; }

.no-margin {
  margin-bottom: 0;
}

.picker-field,
.textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  background: #ffffff;
}

.picker-field {
  min-height: 76rpx;
  line-height: 1.6;
  color: #1f2329;
}

.textarea {
  line-height: 1.0;
  word-break: break-word;
  color: #1f2329;
}

.textarea-english {
  min-height: 50rpx;
}

.textarea-understanding {
  min-height: 50rpx;
}

.textarea-where-encountered {
  min-height: 92rpx;
  max-height: 300rpx;
  line-height: 1.5;
}

.textarea-proxy {
  white-space: pre-wrap;
}

.textarea-placeholder {
  color: #98a2b3;
}

.textarea-lg {
  min-height: 280rpx;
}

.textarea-xl {
  min-height: 360rpx;
}

.suggestion-box {
  padding: 20rpx 24rpx;
  border: 2rpx dashed #bfdbfe;
  border-radius: 12rpx;
  background: #f8fbff;
}

.suggestion-box-loading {
  opacity: 0.88;
}

.suggestion-box-hidden {
  visibility: hidden;
  pointer-events: none;
}

.suggestion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.suggestion-title {
  font-size: 24rpx;
  color: #175cd3;
}

.accept-btn {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #175cd3;
  background: #eff8ff;
}

.suggestion-content {
  font-size: 28rpx;
  line-height: 1.7;
  color: #344054;
  word-break: break-word;
  white-space: normal;
}

.validation-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.validation-hint {
  color: #667085;
}

.validation-success {
  color: #027a48;
}

.validation-warning {
  color: #b54708;
}

.validation-error {
  color: #d92d20;
}

.textarea-english-invalid {
  border-color: #d8a6aa;
  background: #fffafa;
  box-shadow: 0 0 0 3rpx rgba(189, 107, 116, 0.08);
}

.validation-checking,
.validation-format-hint,
.validation-unavailable,
.ai-service-message {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #89948b;
}

.validation-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.validation-issue {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.validation-issue-high {
  color: #775726;
  background: #fff8e9;
  border: 1rpx solid #ead9ae;
}

.validation-issue-medium {
  color: #697269;
  background: #f7faf5;
  border: 1rpx solid #e1e9de;
}

.validation-issue-light {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
  color: #89948b;
  background: transparent;
}

.validation-issue-invalid {
  color: #94545c;
  background: #fff4f4;
  border: 1rpx solid #eccfd2;
}

.validation-issue-copy {
  min-width: 0;
  flex: 1;
}

.validation-issue-message {
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 600;
}

.validation-issue-detail {
  margin-top: 3rpx;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 400;
  opacity: 0.86;
  word-break: break-word;
}

.validation-action {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border: 1rpx solid #bcdcc7;
  border-radius: 999rpx;
  color: #3f8b61;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.validation-more {
  padding-left: 16rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #89948b;
}

.validation-format-hint {
  color: #7f9385;
}

.validation-unavailable,
.ai-service-message {
  color: #8a7764;
}

/* 「AI 分析」按钮：输入只做本地检查，点击后才启动后端正式分析 */
.ai-analyze-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.ai-analyze-btn {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #ffffff;
  background: #3f7449;
}

.ai-analyze-btn-active {
  color: #b7c9ba;
  background: #e3ece2;
}

.ai-analyze-btn-disabled {
  opacity: 0.45;
}

.ai-analyze-cancel {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #667085;
}

/* Edit-mode pronunciation section */
.edit-lexical-section {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: #f6faf7;
  border-radius: 14rpx;
  border: 1rpx solid #dce8df;
}

.edit-lexical-main {
  min-height: 36rpx;
  margin-bottom: 8rpx;
}

.edit-phonetic {
  font-size: 26rpx;
  color: #5f7569;
  line-height: 1.4;
  word-break: break-word;
}

.edit-phonetic-empty {
  font-size: 22rpx;
  color: #9ba8a0;
  line-height: 1.4;
}

.edit-voice-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.edit-voice-toggle {
  display: flex;
  align-items: center;
  gap: 0;
  font-size: 22rpx;
  color: #8ea798;
  line-height: 1;
}

.edit-voice-option {
  padding: 2rpx 8rpx;
  color: #8ea798;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.edit-voice-active {
  color: #35b779;
  font-weight: 800;
}

.edit-voice-sep {
  color: #c8d6cd;
  font-size: 20rpx;
  padding: 0 2rpx;
}

.edit-pronunciation-btn {
  width: 112rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  border: 1rpx solid #cfe6d6;
  background: #f5fbf7;
  color: #3f8b61;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.edit-pronunciation-btn::after {
  border: none;
}

.edit-pronunciation-btn[disabled] {
  color: #a8b4ad;
  background: #f3f5f4;
}

.edit-pronunciation-btn-active {
  color: #ffffff;
  background: #35b779;
}

.notes-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.notes-label-row .label {
  margin-bottom: 0;
}

.notes-example-pronounce-btn {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #cfe6d6;
  background: #f5fbf7;
  color: #3f8b61;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.notes-example-pronounce-btn-active {
  color: #ffffff;
  background: #35b779;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.submit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.submit-btn {
  flex: 1;
  margin: 0;
}

.primary-btn {
  margin-top: 16rpx;
}

.secondary-btn {
  color: #344054;
  background: #f2f4f7;
}

.danger-btn {
  margin-top: 16rpx;
  color: #ffffff;
  background: #d92d20;
}

@media (max-width: 520px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .submit-actions {
    flex-direction: column;
  }
}

.meta-pill-readonly {
  background: #f7faf8;
  border-color: #e5eee8;
  color: #60726b;
}

.textarea-readonly {
  background: #f8faf9;
  color: #263238;
}
/* ===== 低压学习风格最终覆盖层：添加 / 编辑 / 详情共用，只改视觉 ===== */
.page {
  min-height: 100vh;
  padding: 30rpx 28rpx 72rpx;
  box-sizing: border-box;
