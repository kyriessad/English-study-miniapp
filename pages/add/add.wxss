}



@media (max-width: 520px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .submit-actions {
    flex-direction: column;
  }
}

/* ===== 添加 / 编辑 / 详情页最终收口：只压缩底部空白，不改结构 ===== */

.form-card {
  padding-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.meta-pills {
  margin-bottom: 30rpx;
}

.submit-actions {
  margin-top: 16rpx;
  gap: 16rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.submit-btn {
  height: 86rpx;
  line-height: 86rpx;
}

.input-source {
  height: 80rpx;
  line-height: 80rpx;
  padding-top: 0;
  padding-bottom: 0;
}

.label-subtitle {
  margin-top: -4rpx;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  color: #a0a8a2;
  line-height: 1.4;
}

/* ===== Phase 7J-1: 最近用过来源快捷标签 ===== */
.recent-sources {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.recent-sources-label {
  font-size: 23rpx;
  color: #8a9689;
  line-height: 50rpx;
  flex-shrink: 0;
}

.recent-sources-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.source-pill {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f9f2;
  border: 1rpx solid #dfe9dc;
  font-size: 24rpx;
  color: #4a7454;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
}

/* Phase 8B-hotfix-6: unified reference area */
.reference-box {
  padding: 22rpx 24rpx;
  border: 1rpx solid #dcebd8;
  border-radius: 24rpx;
  background: #f1f8ef;
  box-shadow: 0 8rpx 20rpx rgba(86, 126, 82, 0.05);
}

.reference-box-loading {
  opacity: 0.88;
}

.reference-header {
  margin-bottom: 12rpx;
}

.reference-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #3f7449;
}

.reference-loading-text {
  font-size: 26rpx;
  color: #8a9689;
}

.reference-loading-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.reference-spinner {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 3rpx solid #dcebd8;
  border-top-color: #5eaa64;
  box-sizing: border-box;
  animation: reference-spin 0.8s linear infinite;
}

@keyframes reference-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.reference-row {
  margin-bottom: 50rpx;
}

.reference-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #5f8f72;
  margin-bottom: 4rpx;
}

.reference-value {
  font-size: 27rpx;
  color: #344036;
  line-height: 1.65;
  word-break: break-word;
}

.reference-label-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.reference-label-row .reference-label {
  margin-bottom: 0;
}

.reference-type-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #3f7449;
  background: #e7f5ea;
  border: 1rpx solid #ccebd8;
}

.reference-alt-item {
  margin-bottom: 8rpx;
}

.reference-alt-item:last-child {
  margin-bottom: 0;
}

.reference-alt-note {
  font-size: 22rpx;
  color: #8a9689;
  line-height: 1.5;
  margin-top: 2rpx;
}

.reference-dialogue {
  margin-bottom: 4rpx;
}

.reference-dialogue-zh {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #dcebd8;
}

.reference-translation {
  color: #6f7f71;
}

.reference-fill-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #dcebd8;
}

.reference-fill-btn {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
}

.reference-fill-btn-applied {
  color: #8a9689;
  background: #f7faf5;
  border-color: #e7eee4;
}

.reference-regenerate-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
}

.reference-regenerate-btn-disabled {
  color: #8a9689;
  background: #f7faf5;
  border-color: #e7eee4;
}

/* Final add/edit surface: one continuous learning sheet instead of stacked cards. */
page {
  background: #edf6ea;
}

.add-page {
  min-height: 100vh;
  padding: 18rpx 28rpx 72rpx;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 84% 2%, rgba(255, 255, 250, .88), rgba(255, 255, 250, 0) 32%),
    radial-gradient(circle at 8% 25%, rgba(203, 226, 199, .42), rgba(203, 226, 199, 0) 32%),
    linear-gradient(180deg, #f1f8ee 0%, #edf6ea 56%, #e8f2e5 100%);
  color: #203b27;
}

.add-page::before {
  content: '';
  position: absolute;
  top: 138rpx;
  right: -210rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(73, 107, 69, .08);
  border-radius: 50%;
  pointer-events: none;
}

.add-page .form-card {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - 18rpx);
  margin: 0 -28rpx -72rpx;
  padding: 30rpx 52rpx calc(70rpx + env(safe-area-inset-bottom));
  border: 0;
  border-radius: 26rpx 26rpx 0 0;
  background: linear-gradient(180deg, rgba(255, 253, 248, .72), rgba(247, 250, 243, .58));
  box-shadow: none;
}

.add-page .meta-pills {
  margin-bottom: 22rpx;
}

.add-page .meta-pill {
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 1rpx solid #bfd2bd;
  border-radius: 999rpx;
  background: rgba(237, 246, 234, .72);
  box-shadow: none;
}

.add-page .meta-pill-text {
