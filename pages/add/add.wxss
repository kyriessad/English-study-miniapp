}

.textarea-readonly {
  background: #f7faf5;
  color: #263128;
  border-color: #edf3e9;
}

.validation-text {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.validation-hint {
  color: #8a9689;
}

.validation-success {
  color: #3f8b61;
}

.validation-warning {
  color: #a7772e;
}

.validation-error {
  color: #bd6b74;
}

.suggestion-box {
  padding: 22rpx 24rpx;
  border: 1rpx solid #dcebd8;
  border-radius: 24rpx;
  background: #f1f8ef;
  box-shadow: 0 8rpx 20rpx rgba(86, 126, 82, 0.05);
}

.suggestion-title {
  font-size: 24rpx;
  font-weight: 800;
