}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  border-radius: 24rpx;
  font-size: 29rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.primary-btn {
  margin-top: 0;
  color: #ffffff;
  background: linear-gradient(135deg, #78bd73 0%, #5eaa64 100%);
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(86, 126, 82, 0.18);
}

.secondary-btn {
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
  box-shadow: 0 8rpx 20rpx rgba(86, 126, 82, 0.06);
}

.danger-btn {
  margin-top: 0;
  color: #b4534b;
  background: #fff7f5;
  border: 1rpx solid #f0d4ce;
  box-shadow: none;
}

.primary-btn::after,
.secondary-btn::after,
.danger-btn::after,
