.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.form-card {
  padding: 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.draft-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 0;
  padding: 14rpx 18rpx;
  border: 1rpx solid #cfe5d3;
  border-radius: 14rpx;
  background: #f1faf2;
  color: #4d7658;
  font-size: 23rpx;
  line-height: 1.4;
}

.draft-notice .text-link {
  flex: 0 0 auto;
  margin: 0;
  font-size: 22rpx;
}

.meta-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.meta-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 64rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.meta-pill-text {
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1;
}

.meta-pill-arrow {
  font-size: 22rpx;
  color: #667085;
  line-height: 1;
}


.form-title {
  margin-bottom: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.grid-item {
  margin-bottom: 0;
}


.label {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #344054;
}

.label-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.label-row .label {
  margin-bottom: 0;
  flex-shrink: 0;
}

.english-pronunciation-area {
  margin-left: auto;
  max-width: calc(100% - 150rpx);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  min-width: 0;
}

.original-pronunciation-btn,
.example-pronunciation-btn {
  flex-shrink: 0;
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  line-height: 54rpx;
  padding: 0;
  margin: 0 0 12rpx 16rpx;
  border: 1rpx solid #cfe6d6;
  border-radius: 18rpx;
  background: #f5fbf7;
  color: #3f8b61;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.original-pronunciation-btn::after,
.example-pronunciation-btn::after { border: none; }
.english-pronunciation-area .original-pronunciation-btn {
  margin: 0;
}
.original-pronunciation-btn[disabled],
.example-pronunciation-btn[disabled] { color: #a8b4ad; background: #f3f5f4; }
.original-pronunciation-btn-active,
.example-pronunciation-btn-active { color: #fff; background: #35b779; }

.reference-example-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.reference-example-line .reference-value { flex: 1; }

.no-margin {
  margin-bottom: 0;
}

.picker-field,
.textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  background: #ffffff;
}

.picker-field {
  min-height: 76rpx;
  line-height: 1.6;
  color: #1f2329;
}

.textarea {
  line-height: 1.0;
  word-break: break-word;
  color: #1f2329;
}

.textarea-english {
  min-height: 50rpx;
}

.phonetic-display {
  flex-shrink: 1;
  margin: 0;
  font-size: 26rpx;
  line-height: 1.4;
  color: #5f7569;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 360rpx;
}

.textarea-understanding {
  min-height: 50rpx;
}

.textarea-where-encountered {
  min-height: 92rpx;
  max-height: 300rpx;
  line-height: 1.5;
}

.textarea-proxy {
  white-space: pre-wrap;
}

.textarea-placeholder {
  color: #98a2b3;
}

.textarea-lg {
  min-height: 280rpx;
}

.textarea-xl {
  min-height: 360rpx;
}

.suggestion-box {
  padding: 20rpx 24rpx;
  border: 2rpx dashed #bfdbfe;
  border-radius: 12rpx;
  background: #f8fbff;
}

.suggestion-box-loading {
  opacity: 0.88;
}

.suggestion-box-hidden {
  visibility: hidden;
  pointer-events: none;
}

.suggestion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.suggestion-title {
  font-size: 24rpx;
  color: #175cd3;
}

.accept-btn {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #175cd3;
  background: #eff8ff;
}

.suggestion-content {
  font-size: 28rpx;
  line-height: 1.7;
  color: #344054;
  word-break: break-word;
  white-space: normal;
}

.validation-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.validation-hint {
  color: #667085;
}

.validation-success {
  color: #027a48;
}

.validation-warning {
  color: #b54708;
}

.validation-error {
  color: #d92d20;
}

.textarea-english-invalid {
  border-color: #d8a6aa;
  background: #fffafa;
  box-shadow: 0 0 0 3rpx rgba(189, 107, 116, 0.08);
}

.validation-checking,
.validation-format-hint,
.validation-unavailable,
.ai-service-message {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #89948b;
}

.validation-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.validation-issue {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.validation-issue-high {
  color: #775726;
  background: #fff8e9;
  border: 1rpx solid #ead9ae;
}

.validation-issue-medium {
  color: #697269;
  background: #f7faf5;
  border: 1rpx solid #e1e9de;
}

.validation-issue-light {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
  color: #89948b;
  background: transparent;
}

.validation-issue-invalid {
  color: #94545c;
  background: #fff4f4;
  border: 1rpx solid #eccfd2;
}

.validation-issue-copy {
  min-width: 0;
  flex: 1;
}

.validation-issue-message {
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 600;
}

.validation-issue-detail {
  margin-top: 3rpx;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 400;
  opacity: 0.86;
  word-break: break-word;
}

.validation-action {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border: 1rpx solid #bcdcc7;
  border-radius: 999rpx;
  color: #3f8b61;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.validation-more {
  padding-left: 16rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #89948b;
}

.validation-format-hint {
  color: #7f9385;
}

.validation-unavailable,
.ai-service-message {
  color: #8a7764;
}

/* 「AI 分析」按钮：输入只做本地检查，点击后才启动后端正式分析 */
.ai-analyze-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.example-translation-input {
  margin-top: 12rpx;
}

.ai-analyze-btn {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #ffffff;
  background: #3f7449;
}

.ai-analyze-btn-active {
  color: #b7c9ba;
  background: #e3ece2;
}

.ai-analyze-btn-disabled {
  opacity: 0.45;
}

.ai-analyze-cancel {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #667085;
}

.notes-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.notes-label-row .label {
  margin-bottom: 0;
}

.notes-example-pronounce-btn {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #cfe6d6;
  background: #f5fbf7;
  color: #3f8b61;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.notes-example-pronounce-btn-active {
  color: #ffffff;
  background: #35b779;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.submit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.submit-btn {
  flex: 1;
  margin: 0;
}

.primary-btn {
  margin-top: 16rpx;
}

.secondary-btn {
  color: #344054;
  background: #f2f4f7;
}

.danger-btn {
  margin-top: 16rpx;
  color: #ffffff;
  background: #d92d20;
}

@media (max-width: 520px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .submit-actions {
    flex-direction: column;
  }
}

.meta-pill-readonly {
  background: #f7faf8;
  border-color: #e5eee8;
  color: #60726b;
}

.textarea-readonly {
  background: #f8faf9;
  color: #263238;
}
/* ===== 低压学习风格最终覆盖层：添加 / 编辑 / 详情共用，只改视觉 ===== */
.page {
  min-height: 100vh;
  padding: 30rpx 28rpx 72rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fbfcf7 0%, #f4f8ee 52%, #f8faf4 100%);
}

.form-card {
  padding: 30rpx 28rpx 32rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  box-shadow: 0 14rpx 34rpx rgba(86, 126, 82, 0.09);
  box-sizing: border-box;
}

.meta-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 34rpx;
}

.meta-pill {
  display: flex;
  align-items: center;
  gap: 15rpx;
  min-height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dfe9dc;
  background: #fbfdf9;
  box-sizing: border-box;
  box-shadow: 0 6rpx 14rpx rgba(86, 126, 82, 0.04);
}

.meta-pill-category {
  color: #3f8b61;
  background: #f0faf4;
  border-color: #ccebd8;
}

.meta-pill-readonly {
  box-shadow: none;
}

.meta-pill-text {
  font-size: 27rpx;
  font-weight: 700;
  color: inherit;
  line-height: 1;
}

.meta-pill-arrow {
  font-size: 21rpx;
  color: currentColor;
  opacity: 0.72;
  line-height: 1;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #6f7f71;
  line-height: 1.4;
}

.picker-field,
.textarea {
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e1e8df;
  border-radius: 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.65;
  color: #263128;
  background: #fbfdf9;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.50);
}

.textarea {
  word-break: break-word;
  white-space: pre-wrap;
}

.textarea-english,
.textarea-understanding {
  min-height: 108rpx;
}

.form-item:nth-of-type(4) .textarea,
.textarea-lg,
.textarea-xl {
  min-height: 170rpx;
}

.textarea-readonly {
  background: #f7faf5;
  color: #263128;
  border-color: #edf3e9;
}

.validation-text {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.validation-hint {
  color: #8a9689;
}

.validation-success {
  color: #3f8b61;
}

.validation-warning {
  color: #a7772e;
}

.validation-error {
  color: #bd6b74;
}

.suggestion-box {
  padding: 22rpx 24rpx;
  border: 1rpx solid #dcebd8;
  border-radius: 24rpx;
  background: #f1f8ef;
  box-shadow: 0 8rpx 20rpx rgba(86, 126, 82, 0.05);
}

.suggestion-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #3f7449;
}

.accept-btn {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
}

.suggestion-content {
  font-size: 27rpx;
  line-height: 1.7;
  color: #344036;
}

.submit-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 8rpx);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  border-radius: 24rpx;
  font-size: 29rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.primary-btn {
  margin-top: 0;
  color: #ffffff;
  background: linear-gradient(135deg, #78bd73 0%, #5eaa64 100%);
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(86, 126, 82, 0.18);
}

.secondary-btn {
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
  box-shadow: 0 8rpx 20rpx rgba(86, 126, 82, 0.06);
}

.danger-btn {
  margin-top: 0;
  color: #b4534b;
  background: #fff7f5;
  border: 1rpx solid #f0d4ce;
  box-shadow: none;
}

.primary-btn::after,
.secondary-btn::after,
.danger-btn::after,
.submit-btn::after {
  border: none;
}



@media (max-width: 520px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .submit-actions {
    flex-direction: column;
  }
}

/* ===== 添加 / 编辑 / 详情页最终收口：只压缩底部空白，不改结构 ===== */

.form-card {
  padding-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.meta-pills {
  margin-bottom: 30rpx;
}

.submit-actions {
  margin-top: 16rpx;
  gap: 16rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.submit-btn {
  height: 86rpx;
  line-height: 86rpx;
}

.input-source {
  height: 80rpx;
  line-height: 80rpx;
  padding-top: 0;
  padding-bottom: 0;
}

/* ===== Phase 7J-1: 最近用过来源快捷标签 ===== */
.recent-sources {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.recent-sources-label {
  font-size: 23rpx;
  color: #8a9689;
  line-height: 50rpx;
  flex-shrink: 0;
}

.recent-sources-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.source-pill {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f9f2;
  border: 1rpx solid #dfe9dc;
  font-size: 24rpx;
  color: #4a7454;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
}

/* Phase 8B-hotfix-6: unified reference area */
.reference-box {
  padding: 22rpx 24rpx;
  border: 1rpx solid #dcebd8;
  border-radius: 24rpx;
  background: #f1f8ef;
  box-shadow: 0 8rpx 20rpx rgba(86, 126, 82, 0.05);
}

.reference-box-loading {
  opacity: 0.88;
}

.reference-header {
  margin-bottom: 12rpx;
}

.reference-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #3f7449;
}

.reference-loading-text {
  font-size: 26rpx;
  color: #8a9689;
}

.reference-loading-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.reference-spinner {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 3rpx solid #dcebd8;
  border-top-color: #5eaa64;
  box-sizing: border-box;
  animation: reference-spin 0.8s linear infinite;
}

@keyframes reference-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.reference-row {
  margin-bottom: 50rpx;
}

.reference-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #5f8f72;
  margin-bottom: 4rpx;
}

.reference-value {
  font-size: 27rpx;
  color: #344036;
  line-height: 1.65;
  word-break: break-word;
}

.reference-label-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.reference-label-row .reference-label {
  margin-bottom: 0;
}

.reference-type-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #3f7449;
  background: #e7f5ea;
  border: 1rpx solid #ccebd8;
}

.reference-alt-item {
  margin-bottom: 8rpx;
}

.reference-alt-item:last-child {
  margin-bottom: 0;
}

.reference-alt-note {
  font-size: 22rpx;
  color: #8a9689;
  line-height: 1.5;
  margin-top: 2rpx;
}

.reference-dialogue {
  margin-bottom: 4rpx;
}

.reference-dialogue-zh {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #dcebd8;
}

.reference-translation {
  color: #6f7f71;
}

.reference-fill-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #dcebd8;
}

.reference-fill-btn {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
}

.reference-fill-btn-applied {
  color: #8a9689;
  background: #f7faf5;
  border-color: #e7eee4;
}

.reference-regenerate-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
}

.reference-regenerate-btn-disabled {
  color: #8a9689;
  background: #f7faf5;
  border-color: #e7eee4;
}

/* Final add/edit surface: one continuous learning sheet instead of stacked cards. */
.add-page {
  min-height: 100vh;
  padding: 18rpx 28rpx 72rpx;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 84% 2%, rgba(255, 255, 250, .88), rgba(255, 255, 250, 0) 32%),
    radial-gradient(circle at 8% 25%, rgba(203, 226, 199, .42), rgba(203, 226, 199, 0) 32%),
    linear-gradient(180deg, #f1f8ee 0%, #edf6ea 56%, #e8f2e5 100%);
  color: #203b27;
}

.add-page::before {
  content: '';
  position: absolute;
  top: 138rpx;
  right: -210rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(73, 107, 69, .08);
  border-radius: 50%;
  pointer-events: none;
}

.add-page .form-card {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - 18rpx);
  margin: 0 -28rpx -72rpx;
  padding: 30rpx 52rpx calc(70rpx + env(safe-area-inset-bottom));
  border: 0;
  border-radius: 26rpx 26rpx 0 0;
  background: linear-gradient(180deg, rgba(255, 253, 248, .72), rgba(247, 250, 243, .58));
  box-shadow: none;
}

.add-page .meta-pills {
  margin-bottom: 22rpx;
}

.add-page .meta-pill {
