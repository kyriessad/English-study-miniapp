  box-shadow: 0 14rpx 34rpx rgba(86, 126, 82, 0.09);
  box-sizing: border-box;
}

.meta-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 34rpx;
}

.meta-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dfe9dc;
  background: #fbfdf9;
  box-sizing: border-box;
  box-shadow: 0 6rpx 14rpx rgba(86, 126, 82, 0.04);
}

.meta-pill-category {
  color: #3f8b61;
  background: #f0faf4;
  border-color: #ccebd8;
}

.meta-pill-readonly {
  box-shadow: none;
}

.meta-pill-text {
  font-size: 27rpx;
  font-weight: 700;
  color: inherit;
  line-height: 1;
}

.meta-pill-arrow {
  font-size: 21rpx;
  color: currentColor;
  opacity: 0.72;
  line-height: 1;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #6f7f71;
  line-height: 1.4;
}

.picker-field,
.textarea {
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e1e8df;
  border-radius: 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.65;
  color: #263128;
  background: #fbfdf9;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.50);
}

.textarea {
  word-break: break-word;
  white-space: pre-wrap;
}

.textarea-english,
.textarea-understanding {
  min-height: 108rpx;
}

.form-item:nth-of-type(4) .textarea,
.textarea-lg,
.textarea-xl {
  min-height: 170rpx;
}

.textarea-readonly {
  background: #f7faf5;
  color: #263128;
  border-color: #edf3e9;
}

.validation-text {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.validation-hint {
  color: #8a9689;
}

.validation-success {
  color: #3f8b61;
}

.validation-warning {
  color: #a7772e;
}

.validation-error {
  color: #bd6b74;
}

.suggestion-box {
  padding: 22rpx 24rpx;
  border: 1rpx solid #dcebd8;
  border-radius: 24rpx;
  background: #f1f8ef;
  box-shadow: 0 8rpx 20rpx rgba(86, 126, 82, 0.05);
}

.suggestion-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #3f7449;
}

.accept-btn {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
}

.suggestion-content {
  font-size: 27rpx;
  line-height: 1.7;
  color: #344036;
}

.submit-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 8rpx);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  border-radius: 24rpx;
  font-size: 29rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.primary-btn {
  margin-top: 0;
  color: #ffffff;
  background: linear-gradient(135deg, #78bd73 0%, #5eaa64 100%);
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(86, 126, 82, 0.18);
}

.secondary-btn {
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
  box-shadow: 0 8rpx 20rpx rgba(86, 126, 82, 0.06);
}

.danger-btn {
  margin-top: 0;
  color: #b4534b;
  background: #fff7f5;
  border: 1rpx solid #f0d4ce;
  box-shadow: none;
}

.primary-btn::after,
.secondary-btn::after,
.danger-btn::after,
.submit-btn::after {
  border: none;
}



@media (max-width: 520px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .submit-actions {
    flex-direction: column;
  }
}

/* ===== 添加 / 编辑 / 详情页最终收口：只压缩底部空白，不改结构 ===== */

.form-card {
  padding-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.meta-pills {
  margin-bottom: 30rpx;
}

.submit-actions {
  margin-top: 16rpx;
  gap: 16rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.submit-btn {
  height: 86rpx;
  line-height: 86rpx;
}

.input-source {
  height: 80rpx;
  line-height: 80rpx;
  padding-top: 0;
  padding-bottom: 0;
}

.label-subtitle {
  margin-top: -4rpx;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  color: #a0a8a2;
  line-height: 1.4;
}

/* ===== Phase 7J-1: 最近用过来源快捷标签 ===== */
.recent-sources {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.recent-sources-label {
  font-size: 23rpx;
  color: #8a9689;
  line-height: 50rpx;
  flex-shrink: 0;
}

.recent-sources-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.source-pill {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f9f2;
  border: 1rpx solid #dfe9dc;
  font-size: 24rpx;
  color: #4a7454;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
}

/* Phase 8B-hotfix-6: unified reference area */
.reference-box {
  padding: 22rpx 24rpx;
  border: 1rpx solid #dcebd8;
  border-radius: 24rpx;
  background: #f1f8ef;
  box-shadow: 0 8rpx 20rpx rgba(86, 126, 82, 0.05);
}

.reference-box-loading {
  opacity: 0.88;
}

.reference-header {
  margin-bottom: 12rpx;
}

.reference-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #3f7449;
}

.reference-loading-text {
  font-size: 26rpx;
  color: #8a9689;
}

.reference-loading-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.reference-spinner {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 3rpx solid #dcebd8;
  border-top-color: #5eaa64;
  box-sizing: border-box;
  animation: reference-spin 0.8s linear infinite;
}

@keyframes reference-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.reference-row {
  margin-bottom: 10rpx;
}

.reference-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #5f8f72;
  margin-bottom: 4rpx;
}

.reference-value {
  font-size: 27rpx;
  color: #344036;
  line-height: 1.65;
  word-break: break-word;
}

.reference-label-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.reference-label-row .reference-label {
  margin-bottom: 0;
}

.reference-type-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #3f7449;
  background: #e7f5ea;
  border: 1rpx solid #ccebd8;
}

.reference-alt-item {
  margin-bottom: 8rpx;
}

.reference-alt-item:last-child {
  margin-bottom: 0;
}

.reference-alt-note {
  font-size: 22rpx;
  color: #8a9689;
  line-height: 1.5;
  margin-top: 2rpx;
}

.reference-dialogue {
  margin-bottom: 4rpx;
}

.reference-dialogue-zh {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #dcebd8;
}

.reference-translation {
  color: #6f7f71;
}

.reference-fill-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #dcebd8;
}

.reference-fill-btn {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
}

.reference-fill-btn-applied {
  color: #8a9689;
  background: #f7faf5;
  border-color: #e7eee4;
}

.reference-regenerate-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #3f7449;
  background: #ffffff;
  border: 1rpx solid #dcebd8;
}

.reference-regenerate-btn-disabled {
  color: #8a9689;
  background: #f7faf5;
  border-color: #e7eee4;
}
