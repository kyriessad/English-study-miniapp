.discover-page { min-height: 100vh; padding: 32rpx 28rpx 80rpx; box-sizing: border-box; background: #fbfcf7; color: #263128; }
.discover-intro { padding: 12rpx 4rpx 26rpx; }
.discover-title { font-size: 42rpx; line-height: 1.3; font-weight: 700; }
.discover-subtitle { margin-top: 12rpx; color: #768177; font-size: 26rpx; line-height: 1.6; }
.pack-scroll { width: 100%; margin-bottom: 24rpx; white-space: nowrap; }
.pack-row { display: inline-flex; gap: 14rpx; padding: 2rpx 4rpx 10rpx; }
.pack-pill { display: inline-flex; align-items: center; gap: 10rpx; padding: 14rpx 22rpx; border: 1rpx solid #dfe9dc; border-radius: 999rpx; background: #fff; color: #657465; font-size: 25rpx; }
.pack-pill-active { color: #356944; border-color: #b9dabe; background: #edf8ef; font-weight: 650; }
.pack-count { min-width: 30rpx; color: #8a998b; font-size: 21rpx; text-align: center; }
.search-box { display: flex; align-items: center; gap: 12rpx; height: 76rpx; padding: 0 22rpx; background: #fff; border: 1rpx solid #e5ece2; border-radius: 22rpx; box-sizing: border-box; }
.search-box input { flex: 1; font-size: 27rpx; }
.search-icon { color: #8b978c; }
.material-list { margin-top: 24rpx; }
.material-card { margin-bottom: 22rpx; padding: 28rpx; background: #fff; border: 1rpx solid #e8eee5; border-radius: 28rpx; box-shadow: 0 10rpx 26rpx rgba(86,126,82,.06); }
.material-card-top { display: flex; align-items: center; justify-content: space-between; }
.material-type { color: #5f8466; font-size: 22rpx; font-weight: 650; }
.sound-btn { padding: 8rpx 10rpx; font-size: 27rpx; }
.material-english { margin-top: 12rpx; font-size: 34rpx; line-height: 1.45; font-weight: 650; word-break: break-word; }
.material-chinese { margin-top: 12rpx; color: #657465; font-size: 27rpx; line-height: 1.6; }
.material-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.material-actions button { flex: 1; height: 72rpx; border-radius: 20rpx; font-size: 26rpx; line-height: 72rpx; }
.material-actions button::after { border: 0; }
.known-btn { background: #f2f4f0; color: #687269; }
.remember-btn { background: #5eaa64; color: #fff; }
.remember-btn-done { background: #e9f3e8; color: #56805d; }
.state-copy { padding: 70rpx 20rpx; text-align: center; color: #899489; font-size: 26rpx; }
.state-error { color: #9c6a5f; }

/* Liquid theme final layer */
.discover-page {
  min-height: 100vh;
  padding: 0 28rpx calc(72rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  overflow-y: auto;
  background: transparent;
  box-sizing: border-box;
}
.discover-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding-top: 70rpx;
}
.discover-back,
.discover-heading-space {
  width: 56rpx;
  height: 56rpx;
}
.discover-back {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, .82);
  border-radius: 18rpx;
  color: #214936;
  background: rgba(255, 255, 255, .34);
  font-size: 44rpx;
  line-height: 1;
}
.discover-heading-title {
  flex: 1;
  color: #153729;
  font-size: 40rpx;
  text-align: center;
}
.discover-intro { padding: 18rpx 4rpx 28rpx; }
.discover-title { color: #153729; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 38rpx; font-weight: 600; }
.discover-subtitle { color: #687c71; font-size: 24rpx; }
.pack-scroll { margin-bottom: 22rpx; }
.pack-pill { color: #687c71; border-color: rgba(255, 255, 255, .76); background: rgba(255, 255, 255, .28); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .7); }
.pack-pill-active { color: #fff; border-color: rgba(255, 255, 255, .64); background: rgba(69, 111, 86, .8); }
.pack-count { color: inherit; opacity: .72; }
.search-box { height: 74rpx; border-color: rgba(255, 255, 255, .82); border-radius: 28rpx; background: rgba(255, 255, 255, .32); box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .72); }
.search-box input { color: #315543; }
.search-icon { color: #60756a; }
.material-list { margin-top: 24rpx; }
.material-card { margin-bottom: 16rpx; padding: 18rpx 18rpx 22rpx; border-radius: 34rpx; border-color: rgba(255, 255, 255, .82); background: rgba(255, 255, 255, .34); box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .72), 0 12rpx 30rpx rgba(49, 84, 62, .05); -webkit-backdrop-filter: none; backdrop-filter: none; }
.material-card-body {
  position: relative;
  padding: 8rpx 36rpx 12rpx 8rpx;
  border-radius: 26rpx;
}
.material-open-hint {
  position: absolute;
  top: 22rpx;
  right: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid rgba(49, 88, 70, .42);
  border-right: 3rpx solid rgba(49, 88, 70, .42);
  transform: rotate(45deg);
}
.material-type { color: #47765d; }
.material-english { color: #153729; font-family: Baskerville, "Palatino Linotype", Georgia, serif; font-size: 34rpx; font-weight: 400; }
.material-chinese { color: #315543; }
.material-actions { padding: 0 8rpx; }
.material-actions button { height: 70rpx; line-height: 70rpx; border-radius: 999rpx; }
.known-btn { color: #315d48; background: rgba(255, 255, 255, .32); border: 1rpx solid rgba(255, 255, 255, .78); }
.remember-btn { color: #fff; background: rgba(55, 105, 78, .84); border: 1rpx solid rgba(255, 255, 255, .74); }
.remember-btn-done { color: #47765d; background: rgba(228, 242, 231, .68); }
.state-copy { color: #687c71; }
.state-error { color: #9d5f58; }
