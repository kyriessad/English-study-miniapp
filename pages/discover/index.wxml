<view class="page discover-page liquid-theme-page" style="padding-top: {{safeTop}}px;">
  <image class="theme-ambient-image" src="/assets/home/home-ambient-v6.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="discover-heading">
    <view class="discover-back pressable press-glass" hover-class="press-on" hover-stay-time="90" bindtap="goBack">‹</view>
    <view class="discover-heading-title">发现</view>
    <view class="discover-heading-space"></view>
  </view>

  <block wx:if="{{viewMode === 'hub'}}">
    <view class="discover-intro">
      <view class="discover-title">按场景发现</view>
      <view class="discover-subtitle">从生活、阅读、听力或词汇书里找一句能用的英语。</view>
    </view>
    <view class="discover-hub liquid-panel">
      <view class="discover-hub-row pressable press-card" data-key="life" hover-class="press-on" hover-stay-time="160" bindtap="openHubOption">
        <image class="discover-hub-icon" src="/assets/home/cup.svg" mode="aspectFit" aria-hidden="true"></image>
        <view class="discover-hub-copy">
          <view class="discover-hub-title">生活英语</view>
          <view class="discover-hub-subtitle">日常口语实用场景</view>
        </view>
        <view class="discover-hub-chevron" aria-hidden="true"></view>
      </view>
      <view class="discover-hub-row pressable press-card" data-key="reading" hover-class="press-on" hover-stay-time="160" bindtap="openHubOption">
        <image class="discover-hub-icon" src="/assets/home/book.svg" mode="aspectFit" aria-hidden="true"></image>
        <view class="discover-hub-copy">
          <view class="discover-hub-title">阅读英语</view>
          <view class="discover-hub-subtitle">精选短文和故事</view>
        </view>
        <view class="discover-hub-chevron" aria-hidden="true"></view>
      </view>
      <view class="discover-hub-row pressable press-card" data-key="listening" hover-class="press-on" hover-stay-time="160" bindtap="openHubOption">
        <image class="discover-hub-icon" src="/assets/home/sound.svg" mode="aspectFit" aria-hidden="true"></image>
        <view class="discover-hub-copy">
          <view class="discover-hub-title">听力</view>
          <view class="discover-hub-subtitle">先听完整对话，再决定记哪一句</view>
        </view>
        <view class="discover-hub-chevron" aria-hidden="true"></view>
      </view>
      <view class="discover-hub-row pressable press-card" data-key="books" hover-class="press-on" hover-stay-time="160" bindtap="openHubOption">
        <image class="discover-hub-icon" src="/assets/home/wordbook.svg" mode="aspectFit" aria-hidden="true"></image>
        <view class="discover-hub-copy">
          <view class="discover-hub-title">词汇书</view>
          <view class="discover-hub-subtitle">高频词汇轻松积累</view>
        </view>
        <view class="discover-hub-chevron" aria-hidden="true"></view>
      </view>
    </view>
  </block>

  <block wx:else>
  <view class="discover-intro">
    <view class="discover-title">{{domainTitle}}</view>
    <view class="discover-subtitle">不想看的先收起来，喜欢的加进我的英语。</view>
  </view>

  <scroll-view class="pack-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="pack-row">
      <view
        wx:for="{{categories}}"
        wx:key="code"
        id="discover-category-{{item.code}}"
        class="pack-pill pressable press-pill {{selectedCategoryCode === item.code ? 'pack-pill-active' : ''}}"
        data-code="{{item.code}}"
        hover-class="press-on"
        hover-stay-time="80"
        bindtap="onCategoryTap"
      >
        <text>{{item.title}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input placeholder="搜索英文或中文" value="{{searchText}}" bindinput="onSearchInput" />
  </view>

  <view wx:if="{{loading}}" class="state-copy">正在准备素材...</view>
  <view wx:elif="{{errorMessage}}" class="state-copy state-error">{{errorMessage}}</view>
  <view wx:elif="{{items.length === 0}}" class="state-copy">这一组暂时没有更多内容了</view>

  <view class="material-list">
    <view wx:for="{{items}}" wx:key="id" id="discover-item-{{item.id}}" class="material-card {{leavingItemId == item.id ? 'is-leaving' : ''}}">
      <view
        class="material-card-body pressable press-card"
        data-id="{{item.id}}"
        hover-class="press-on"
        hover-stay-time="160"
        bindtap="onItemTap"
      >
        <view class="material-card-top">
          <view class="material-type">{{item.cardType === 'word' ? '单词' : (item.cardType === 'phrase' ? '短语' : '句子')}}</view>
          <view class="sound-btn pressable press-glass" data-id="{{item.id}}" hover-class="press-on" hover-stay-time="90" hover-stop-propagation="true" catchtap="onPronounceTap"><text wx:if="{{playingItemId === item.id}}">···</text><image wx:else class="inline-sound-image" src="/assets/home/sound.svg" mode="aspectFit" aria-hidden="true"></image></view>
        </view>
        <view class="material-copy">
          <view class="material-english">{{item.content}}</view>
          <view class="material-chinese">{{item.translation || item.chinese}}</view>
        </view>
        <view class="material-open-hint" aria-hidden="true"></view>
      </view>
      <view class="material-actions">
        <button
          class="action-icon known-btn pressable press-glass {{markingItemId == item.id ? 'is-busy' : ''}}"
          data-id="{{item.id}}"
          hover-class="press-on"
          hover-stay-time="90"
          hover-stop-propagation="true"
          catchtap="onKnownTap"
          aria-label="不想再看"
        >
          <image class="action-icon-image" src="/assets/home/dismiss.svg" mode="aspectFit" aria-hidden="true"></image>
        </button>
        <button
          class="action-icon remember-btn pressable press-glass {{item.inLibrary ? 'remember-btn-done' : ''}} {{markingItemId == item.id ? 'is-busy' : ''}}"
          data-id="{{item.id}}"
          hover-class="press-on"
          hover-stay-time="90"
          hover-stop-propagation="true"
          catchtap="onRememberTap"
          aria-label="{{item.inLibrary ? '已加入，点按可移除' : '加入我的英语'}}"
        >
          <image
            class="action-icon-image"
            src="{{item.inLibrary ? '/assets/home/check.svg' : '/assets/home/plus.svg'}}"
            mode="aspectFit"
            aria-hidden="true"
          ></image>
        </button>
      </view>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="state-copy">继续加载...</view>
  </block>
</view>
