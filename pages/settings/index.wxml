<view class="settings-page">
  <!-- 设置 -->
  <view class="settings-section">
    <view class="settings-item">
      <view class="settings-item-label">每次看几张</view>
      <picker
        class="settings-item-picker"
        mode="selector"
        range="{{dailyGoalLabels}}"
        value="{{dailyGoalIndex}}"
        bindchange="onDailyGoalChange"
      >
        <view class="settings-item-value">
          <text>{{dailyGoalLabel}}</text>
          <text class="settings-item-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 其他 -->
  <view class="settings-section">
    <view class="settings-section-title">其他</view>

    <view class="settings-item" bindtap="goToAbout" hover-class="settings-item--hover">
      <view class="settings-item-label">关于</view>
      <view class="settings-item-value">
        <text>英语知识卡片本</text>
        <text class="settings-item-arrow">›</text>
      </view>
    </view>

    <view class="settings-item" bindtap="logoutBackend" hover-class="settings-item--hover">
      <view class="settings-item-label">退出登录</view>
      <view class="settings-item-value">
        <text>退出当前账号</text>
        <text class="settings-item-arrow">›</text>
      </view>
    </view>
  </view>
</view>
