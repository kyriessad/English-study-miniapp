.settings-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfcf7 0%, #f4f8ee 52%, #f8faf4 100%);
  padding: 24rpx 28rpx;
}

.settings-section {
  margin-bottom: 40rpx;
}

.settings-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8a9a8e;
  margin-bottom: 16rpx;
  margin-left: 4rpx;
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(86, 126, 82, 0.06);
}

.settings-item + .settings-item {
  margin-top: 4rpx;
}

.settings-item-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #263128;
}

.settings-item-picker {
  flex-shrink: 0;
}

.settings-item-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #5eaa64;
  font-weight: 600;
}

.voice-preference-options {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.voice-preference-option {
  color: #98a2b3;
  font-size: 28rpx;
  font-weight: 600;
}

.voice-preference-option--active {
  color: #5eaa64;
}

.settings-item-arrow {
  font-size: 32rpx;
  margin-left: 8rpx;
  color: #5eaa64;
}

.settings-item--hover {
  background: rgba(242, 248, 242, 0.96);
}

/* Liquid theme final layer */
.settings-page { min-height:100vh; padding:0 28rpx calc(80rpx + env(safe-area-inset-bottom)); overflow-x:hidden; overflow-y:auto; background:transparent; box-sizing:border-box; }
.settings-heading { display:flex; align-items:center; gap:12rpx; min-height:72rpx; padding-top:70rpx; margin-bottom:28rpx; }
.settings-back { display:flex; align-items:center; justify-content:center; width:56rpx; height:56rpx; border:1rpx solid rgba(255,255,255,.82); border-radius:18rpx; color:#214936; background:rgba(255,255,255,.34); font-size:44rpx; line-height:1; }
.settings-heading .page-title { margin:0; color:#153729; font-family:"PingFang SC","Microsoft YaHei",sans-serif; font-size:48rpx; font-weight:400; }
.settings-section { margin-bottom:28rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.82); border-radius:38rpx; background:rgba(255,255,255,.34); box-shadow:inset 0 2rpx 0 rgba(255,255,255,.72), 0 14rpx 34rpx rgba(49,84,62,.055); -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px); }
.settings-section-title { margin:0; padding:24rpx 26rpx 10rpx; color:#687c71; font-size:23rpx; font-weight:500; }
.settings-item { min-height:86rpx; padding:22rpx 26rpx; border:0; border-bottom:1rpx solid rgba(59,91,71,.12); border-radius:0; background:transparent; box-shadow:none; }
.settings-item:last-child { border-bottom:0; }
.settings-item-label { color:#214936; font-size:28rpx; font-weight:500; }
.settings-item-value { color:#60756a; font-size:24rpx; font-weight:400; }
.settings-item-arrow { color:#47765d; }
.voice-preference-options { gap:4rpx; padding:4rpx; border:1rpx solid rgba(255,255,255,.76); border-radius:999rpx; background:rgba(255,255,255,.28); }
.voice-preference-option { min-width:68rpx; padding:8rpx 14rpx; border-radius:999rpx; color:#87978e; font-size:23rpx; font-weight:400; text-align:center; }
.voice-preference-option--active { color:#fff; background:rgba(69,111,86,.8); }
.settings-item--hover { background:rgba(228,242,231,.26); }
