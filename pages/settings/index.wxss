.settings-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfcf7 0%, #f4f8ee 52%, #f8faf4 100%);
  padding: 24rpx 28rpx;
}

.settings-section {
  margin-bottom: 40rpx;
}

.settings-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8a9a8e;
  margin-bottom: 16rpx;
  margin-left: 4rpx;
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #e7eee4;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(86, 126, 82, 0.06);
}

.settings-item + .settings-item {
  margin-top: 4rpx;
}

.settings-item-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #263128;
}

.settings-item-picker {
  flex-shrink: 0;
}

.settings-item-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #5eaa64;
  font-weight: 600;
}

.settings-item-arrow {
  font-size: 32rpx;
  margin-left: 8rpx;
  color: #5eaa64;
}

.settings-item--static .settings-item-value {
  font-weight: 400;
}

.settings-item-value--muted {
  color: #8a9a8e !important;
}
