<view class="history-page liquid-theme-page" style="padding-top: {{safeTop}}px;">
  <image class="theme-ambient-image" src="/assets/home/home-ambient-v6.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="history-hero">
    <view class="history-back" bindtap="goBack">‹</view>
    <view class="history-hero__main">
      <view class="history-hero__title">历史记录</view>
    </view>
  </view>

  <view wx:if="{{statsDisplayText}}" class="history-stats-line">{{statsDisplayText}}</view>

<!-- 时间范围筛选：整行可点击 -->
<picker
  mode="selector"
  range="{{rangeOptions}}"
  range-key="label"
  value="{{rangeIndex}}"
  bindchange="onRangeChange"
>
  <view class="history-range-select-card">
    <view class="history-range-select-label">时间范围</view>

    <view class="history-range-select-value">
      <text>{{selectedRangeLabel}}</text>
      <text class="history-range-select-arrow">▾</text>
    </view>
  </view>
</picker>

  <!-- 状态筛选 -->
  <view class="history-quick-filters">
    <block wx:for="{{quickFilterOptions}}" wx:key="key">
      <view
        class="history-quick-filter history-quick-filter--{{item.key}} {{selectedQuickFilter === item.key ? 'history-quick-filter--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onQuickFilterTap"
      >
        {{item.label}} {{item.count}}
      </view>
    </block>
  </view>

  <!-- 搜索栏 -->
  <view class="history-search-card">
    <view class="history-search-left">
      <text class="history-search-icon">⌕</text>
      <input
        class="history-search-input"
        value="{{searchKeyword}}"
        placeholder="搜索英文、释义、来源等"
        placeholder-class="history-search-placeholder"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view wx:if="{{searchKeyword}}" class="history-search-clear" bindtap="onSearchClear">×</view>
    </view>
</view>

<!-- 卡片列表：按复习日期分组 -->
<view wx:if="{{filteredCards.length > 0}}" class="history-list">
  <block wx:for="{{historyDateGroups}}" wx:key="dateKey" wx:for-item="group">
    <view class="history-date-section">
      <view class="history-date-title">{{group.title}}</view>

      <block wx:for="{{group.cards}}" wx:key="cardId" wx:for-item="item">
        <view
          class="history-card history-card--{{item.resultTagType}}"
          bindtap="onHistoryItemTap"
          data-id="{{item.logId}}"
        >
          <view class="history-card__content">
            <view class="history-card__head">
              <view class="history-card__tags">
                <text class="history-meta-pill">{{item.category || '单词'}}</text>
              </view>

              <view class="history-result-tag history-result-tag--{{item.resultTagType}}">
                {{item.lastResultText}}
              </view>
            </view>

            <view class="history-card__title">{{item.englishText || '未填写英文内容'}}</view>

            <view class="history-card__meaning">
              {{item.myUnderstanding || '暂无我的理解'}}
            </view>

            <view class="history-card__meta">
              <view class="history-card__meta-left">
                <text>最后查看：{{item.lastReviewDisplay}}</text>
              </view>
              <view wx:if="{{item.whereEncountered}}" class="history-source-pill">来自：{{item.whereEncountered}}</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>

  <!-- 底部加载状态 -->
  <view
    wx:if="{{usingBackendHistory && filteredCards.length > 0 && (backendHistoryLoadingMore || !backendHistoryHasMore)}}"
    class="history-load-more-status"
  >
    <text wx:if="{{backendHistoryLoadingMore}}">正在加载更多...</text>
    <text wx:elif="{{!backendHistoryHasMore}}">没有更多了</text>
  </view>

  <!-- 右侧快速滚动条：只提供拖动，不显示日期/A-Z -->
  <view
  wx:if="{{showHistoryFastScroll}}"
  class="history-fast-scroll"
  catchtouchstart="onHistoryFastScrollTouchStart"
  catchtouchmove="onHistoryFastScrollTouchMove"
>
  <view class="history-fast-scroll-track">
    <view class="history-fast-scroll-thumb" style="{{historyFastScrollThumbStyle}}"></view>
  </view>
</view>

  <!-- 离线空状态 -->
  <view wx:if="{{offlineEmpty}}" class="history-empty">
    <view class="history-empty-title">网络不可用，请检查当前网络</view>
  </view>

  <!-- 在线空状态 -->
  <view wx:elif="{{filteredCards.length === 0}}" class="history-empty">
    <view class="history-empty-title">当前条件下还没有历史记录</view>
    <view class="history-empty-desc">换个时间范围或状态筛选看看。</view>
  </view>
</view>
