page {
  min-height: 100%;
  background: linear-gradient(180deg, var(--bg-color-page) 0%, #f4f8ee 52%, #f8faf4 100%);
  color: var(--color-text-primary);
}

.history-detail-page {
  min-height: 100vh;
  padding: 34rpx 32rpx 48rpx;
  box-sizing: border-box;
}

/* 状态卡片（loading / error / empty） */
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 28rpx;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.state-desc {
  font-size: 26rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* 详情区域 */
.detail-section {
  background: var(--bg-color-card);
  border: 1rpx solid var(--border-color-muted);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  margin-bottom: 22rpx;
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  margin-bottom: 22rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color-muted);
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.info-row + .info-row {
  border-top: 1rpx solid var(--border-color-muted);
}

.info-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
  word-break: break-all;
}

/* 孤儿卡片：冷灰失活态 */
.detail-orphan-card {
  background: #f5f6f8;
  border: 1rpx dashed #d6dbe0;
  border-radius: var(--radius-card);
  padding: var(--space-card);
  margin-bottom: 22rpx;
  box-shadow: none;
  text-align: center;
  box-sizing: border-box;
}

.orphan-text {
  font-size: 26rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* 复习结果标签药丸（legacy 硬编码色值，与历史列表页一致） */
.detail-result-tag {
  display: inline-block;
  padding: 8rpx 17rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
}

.detail-result-tag--again {
  color: #bd6b74;
  background: #fff8f8;
  border: 1rpx solid #f1d4d8;
}

.detail-result-tag--hard {
  color: #a7772e;
  background: #fffaf0;
  border: 1rpx solid #efd9ab;
}

.detail-result-tag--good {
  color: #3f8b61;
  background: #f0faf4;
  border: 1rpx solid #ccebd8;
}

.detail-result-tag--default {
  color: var(--color-text-muted);
  background: #f3f7f2;
  border: 1rpx solid var(--border-color-muted);
}
