page {
  min-height: 100%;
  background: linear-gradient(180deg, var(--bg-color-page) 0%, #f4f8ee 52%, #f8faf4 100%);
  color: var(--color-text-primary);
}

.history-detail-page {
  min-height: 100vh;
  padding: 34rpx 32rpx 48rpx;
  box-sizing: border-box;
}

/* 状态卡片（loading / error / empty） */
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 28rpx;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.state-desc {
  font-size: 26rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* 详情区域 */
.detail-section {
  background: var(--bg-color-card);
  border: 1rpx solid var(--border-color-muted);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  margin-bottom: 22rpx;
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  margin-bottom: 22rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color-muted);
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.info-row + .info-row {
  border-top: 1rpx solid var(--border-color-muted);
}

.info-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
  word-break: break-all;
}

.info-row--source {
  padding: 6rpx 0;
}

.lexical-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 0 14rpx 180rpx;
  border-top: 1rpx solid var(--border-color-muted);
  box-sizing: border-box;
}

.lexical-main {
  flex: 1;
  min-width: 0;
}

.phonetic-text {
  font-size: 27rpx;
  color: #5f7569;
  line-height: 1.4;
  word-break: break-word;
}

.phonetic-empty {
  font-size: 24rpx;
  color: #9ba8a0;
  line-height: 1.4;
}

.pronunciation-btn {
  width: 112rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  border: 1rpx solid #cfe6d6;
  background: #f5fbf7;
  color: #3f8b61;
  font-size: 24rpx;
  font-weight: 700;
}

.pronunciation-btn::after {
  border: none;
}

.pronunciation-btn[disabled] {
  color: #a8b4ad;
  background: #f3f5f4;
}

.pronunciation-btn-active {
  color: #ffffff;
  background: #35b779;
}

/* 声音切换 */
.voice-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.voice-toggle {
  display: flex;
  align-items: center;
  gap: 0;
  font-size: 22rpx;
  color: #8ea798;
  line-height: 1;
}

.voice-option {
  padding: 2rpx 6rpx;
  color: #8ea798;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.voice-active {
  color: #35b779;
  font-weight: 800;
}

.voice-sep {
  color: #c8d6cd;
  font-size: 20rpx;
  padding: 0 2rpx;
}

.info-value--source {
  font-size: 24rpx;
  color: #9ba8a0;
}

/* 孤儿卡片：冷灰失活态 */
.detail-orphan-card {
  background: #f5f6f8;
  border: 1rpx dashed #d6dbe0;
  border-radius: var(--radius-card);
  padding: var(--space-card);
  margin-bottom: 22rpx;
  box-shadow: none;
  text-align: center;
  box-sizing: border-box;
}

.orphan-text {
  font-size: 26rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* 复习结果标签药丸（legacy 硬编码色值，与历史列表页一致） */
.detail-result-tag {
  display: inline-block;
  padding: 8rpx 17rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
}

.detail-result-tag--again {
  color: #bd6b74;
  background: #fff8f8;
  border: 1rpx solid #f1d4d8;
}

.detail-result-tag--hard {
  color: #a7772e;
  background: #fffaf0;
  border: 1rpx solid #efd9ab;
}

.detail-result-tag--good {
  color: #3f8b61;
  background: #f0faf4;
  border: 1rpx solid #ccebd8;
}

.detail-result-tag--default {
  color: var(--color-text-muted);
  background: #f3f7f2;
  border: 1rpx solid var(--border-color-muted);
}

/* Liquid theme final layer */
.history-detail-page {
  min-height: 100vh;
  padding: 0 28rpx calc(72rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  overflow-y: auto;
  background: transparent;
  box-sizing: border-box;
}
.history-detail-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding-top: 70rpx;
  margin-bottom: 24rpx;
}
.history-detail-back,
.history-detail-space {
  width: 56rpx;
  height: 56rpx;
}
.history-detail-back {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, .82);
  border-radius: 18rpx;
  color: #214936;
  background: rgba(255, 255, 255, .34);
  font-size: 44rpx;
  line-height: 1;
}
.history-detail-title {
  flex: 1;
  color: #153729;
  font-size: 40rpx;
  text-align: center;
}
.history-detail-page .state-card { min-height: 40vh; padding: 110rpx 26rpx; border:1rpx solid rgba(255,255,255,.76); border-radius:38rpx; background:rgba(255,255,255,.28); }
.history-detail-page .detail-section { padding:26rpx; margin-bottom:16rpx; border-radius:34rpx; border-color:rgba(255,255,255,.82); background:rgba(255,255,255,.34); box-shadow:inset 0 2rpx 0 rgba(255,255,255,.72), 0 12rpx 30rpx rgba(49,84,62,.05); -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px); }
.history-detail-page .section-title { margin-bottom:18rpx; padding-bottom:14rpx; color:#214936; border-bottom-color:rgba(62,94,73,.13); font-family:"PingFang SC", "Microsoft YaHei", sans-serif; font-size:28rpx; font-weight:600; }
.history-detail-page .info-row + .info-row { border-top-color:rgba(62,94,73,.12); }
.history-detail-page .info-label { width:154rpx; color:#87978e; font-size:24rpx; font-weight:400; }
.history-detail-page .info-value { color:#315543; font-size:26rpx; }
.history-detail-page .phonetic-text { color:#60756a; font-family:Baskerville, "Palatino Linotype", Georgia, serif; }
.history-detail-page .voice-toggle { color:#87978e; }
.history-detail-page .voice-option { color:#87978e; }
.history-detail-page .voice-active { color:#47765d; }
.history-detail-page .pronunciation-btn { color:#47765d; background:rgba(255,255,255,.32); border-color:rgba(255,255,255,.8); }
.history-detail-page .pronunciation-btn-active { color:#fff; background:rgba(55,105,78,.84); }
.history-detail-page .detail-result-tag--again { color:#9d5f58; background:rgba(255,235,232,.7); border-color:rgba(189,111,101,.38); }
.history-detail-page .detail-result-tag--hard { color:#9b773b; background:rgba(251,241,217,.72); border-color:rgba(184,145,69,.32); }
.history-detail-page .detail-result-tag--good { color:#47765d; background:rgba(228,242,231,.7); border-color:rgba(71,118,93,.24); }
.history-detail-page .detail-orphan-card { border-color:rgba(189,111,101,.38); background:rgba(255,235,232,.34); }
.history-detail-page .orphan-text { color:#9d5f58; }
