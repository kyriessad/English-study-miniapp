:host {
  background: transparent !important;
}

.tab-bar {
  position: relative;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(255, 255, 255, .78);
  background: rgba(236, 246, 239, .58);
  box-shadow: 0 -10rpx 36rpx rgba(49, 84, 62, .06);
  -webkit-backdrop-filter: blur(18px) saturate(1.18);
  backdrop-filter: blur(18px) saturate(1.18);
}

.tab-bar-inner {
  position: relative;
  display: flex;
  align-items: stretch;
  height: 112rpx;
}

.tab-indicator {
  position: absolute;
  top: 10rpx;
  left: 0;
  width: 33.333%;
  height: 92rpx;
  pointer-events: none;
  transition: transform .36s cubic-bezier(.22, .75, .18, 1);
}

.tab-indicator-fill {
  height: 100%;
  margin: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(69, 122, 90, .16);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .78);
}

.tab-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #809188;
  transition: color .28s ease, transform .28s cubic-bezier(.22, .75, .18, 1);
}

.tab-item.is-active {
  color: #2f5d43;
}

.tab-item-pressed {
  transform: scale(.94);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  transition: transform .32s cubic-bezier(.22, .75, .18, 1);
}

.tab-item.is-active .tab-icon {
  transform: scale(1.08);
}

.tab-text {
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

@media (prefers-reduced-motion: reduce) {
  .tab-indicator,
  .tab-item,
  .tab-icon {
    transition: none;
  }
}
